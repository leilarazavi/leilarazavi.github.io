---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { site } from "../../lib/site";
---
<BaseLayout title={`ارتباط و پروفایل‌ها | ${site.nameFa}`} description="راه‌های ارتباط عمومی و پروفایل‌های علمی و حرفه‌ای دکتر لیلا رضوی." canonical={`${site.url}/contact/`} lang="fa">
  <section class="page"><div class="container">
    <header><p class="label">ارتباط</p><h1>پروفایل‌ها و مسیرهای ارتباط عمومی</h1><p class="lead">برای ارتباط حرفه‌ای، از مسیرهای عمومی و سازمانی زیر استفاده کنید. شماره اعلام‌شده متعلق به مرکز پندار و برای ارتباط با این مجموعه است.</p></header>
    <div class="links">
      {person.profiles.googleScholar && <a href={person.profiles.googleScholar} target="_blank" rel="noopener noreferrer"><strong>Google Scholar</strong><span>پروفایل پژوهشی و آثار علمی</span></a>}
      {person.profiles.instagram && <a href={person.profiles.instagram} target="_blank" rel="noopener noreferrer"><strong>Instagram — دکتر لیلا رضوی</strong><span>حضور عمومی و حرفه‌ای</span></a>}
      {person.profiles.pendar && <a href={person.profiles.pendar} target="_blank" rel="noopener noreferrer"><strong>پندار — پروفایل حرفه‌ای</strong><span>پروفایل حرفه‌ای و مسیر ارتباط سازمانی</span></a>}
      {person.profiles.pendarInstagram && <a href={person.profiles.pendarInstagram} target="_blank" rel="noopener noreferrer"><strong>پندار — Instagram</strong><span>حساب رسمی مجموعه پندار</span></a>}
      {person.contact.pendarPhone && <a href={`tel:${person.contact.pendarPhone}`}><strong>تماس با پندار</strong><span dir="ltr">{person.contact.pendarPhone}</span></a>}
    </div>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:60px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead{color:#555;line-height:2}.links{display:grid;max-width:820px}.links a{display:flex;flex-direction:column;gap:6px;padding:24px 0;border-top:1px solid #ddd7d0;color:#222;text-decoration:none}.links a:hover{color:#806f61}.links strong{font-size:1.05rem}.links span{color:#777;font-size:.9rem}
</style>
