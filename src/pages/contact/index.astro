---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { site } from "../../lib/site";
---

<BaseLayout title={`ارتباط و منابع رسمی | ${site.nameFa}`} description="مسیرهای رسمی ارتباط، پروفایل‌های علمی و حرفه‌ای دکتر لیلا رضوی و منابع اصلی فعالیت او." canonical={`${site.url}/contact/`} lang="fa">
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="container about-hero-grid">
        <div class="about-copy">
          <p class="eyebrow"><span>01</span> ارتباط</p>
          <h1 id="about-title">مسیرهای رسمی ارتباط و حضور حرفه‌ای</h1>
          <p class="about-lead">برای ارتباط حرفه‌ای یا دنبال‌کردن فعالیت‌های علمی و عمومی، از منابع رسمی زیر استفاده کنید. هر مسیر مستقیماً به منبع اصلی متصل است.</p>
        </div>
      </div>
    </section>

    <section class="resource-section" aria-labelledby="professional-resources"><div class="container">
      <div class="section-heading"><p class="label">پروفایل‌ها</p><h2 id="professional-resources">منابع علمی و حرفه‌ای</h2></div>
      <div class="links">
        {person.profiles.googleScholar && <a href={person.profiles.googleScholar} target="_blank" rel="noopener noreferrer"><span class="number">01</span><div><strong>Google Scholar</strong><small>پروفایل پژوهشی و آثار علمی</small></div><b aria-hidden="true">↗</b></a>}
        {person.profiles.pendar && <a href={person.profiles.pendar} target="_blank" rel="noopener noreferrer"><span class="number">02</span><div><strong>پندار — پروفایل حرفه‌ای</strong><small>پروفایل حرفه‌ای و مسیر ارتباط سازمانی</small></div><b aria-hidden="true">↗</b></a>}
      </div></div>
    </section>

    <section class="resource-section" aria-labelledby="public-presence"><div class="container">
      <div class="section-heading"><p class="label">حضور عمومی</p><h2 id="public-presence">رسانه و شبکه‌های اجتماعی</h2></div>
      <div class="links">
        {person.profiles.instagram && <a href={person.profiles.instagram} target="_blank" rel="noopener noreferrer"><span class="number">01</span><div><strong>Instagram — دکتر لیلا رضوی</strong><small>حضور عمومی و حرفه‌ای</small></div><b aria-hidden="true">↗</b></a>}
        {person.profiles.pendarInstagram && <a href={person.profiles.pendarInstagram} target="_blank" rel="noopener noreferrer"><span class="number">02</span><div><strong>پندار — Instagram</strong><small>حساب رسمی مجموعه پندار</small></div><b aria-hidden="true">↗</b></a>}
      </div></div>
    </section>

    {person.contact.pendarPhone && <section class="direct-contact" aria-labelledby="direct-contact-title"><div><p class="label">تماس حرفه‌ای</p><h2 id="direct-contact-title">ارتباط از طریق پندار</h2><p>برای ارتباط سازمانی و حرفه‌ای، می‌توانید از مسیر رسمی پندار استفاده کنید.</p></div><a class="button" href={`tel:${person.contact.pendarPhone}`}><span dir="ltr">{person.contact.pendarPhone}</span></a></section>}
  </div>
</BaseLayout>

<style>
  .about-page{overflow:clip}.about-hero{padding-block:clamp(68px,9vw,120px);border-bottom:1px solid var(--color-border)}.about-hero-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(48px,9vw,130px);align-items:center}.about-copy{max-width:760px}.about-copy h1{margin:0;font-size:var(--text-display);line-height:1.08;font-weight:500;letter-spacing:-.045em}.about-lead{max-width:680px;margin:28px 0 0;color:var(--color-ink-muted);font-size:clamp(1.05rem,1.5vw,1.2rem);line-height:2}.eyebrow{display:flex;align-items:center;gap:12px;margin:0 0 22px;color:var(--color-accent-strong);font-size:var(--text-xs);font-weight:700;letter-spacing:.08em}.eyebrow span{color:var(--color-ink-faint);font-variant-numeric:tabular-nums}.resource-section{padding-block:clamp(50px,7vw,78px);border-bottom:1px solid var(--color-border)}.section-heading{margin-bottom:30px}.section-heading h2,.direct-contact h2{margin:0;font-size:var(--text-title);font-weight:500}.label{margin:0 0 var(--space-4);color:var(--color-accent);font-size:var(--text-xs);font-weight:700;letter-spacing:.02em}.links{max-width:900px;border-top:1px solid var(--color-border)}.links a{display:grid;grid-template-columns:48px 1fr 30px;align-items:center;gap:18px;padding:25px 0;border-bottom:1px solid var(--color-border);color:var(--color-ink);text-decoration:none;transition:color 160ms ease}.links a:hover strong{color:var(--color-accent-strong)}.links a:focus-visible{outline:2px solid var(--color-accent);outline-offset:5px}.number{color:var(--color-accent);font-size:var(--text-xs)}.links div{display:flex;flex-direction:column;gap:5px}.links strong{font-size:var(--text-lg);font-weight:500}.links small{color:var(--color-ink-muted);font-size:var(--text-sm)}.links b{color:var(--color-accent);font-weight:400;text-align:end}.direct-contact{display:flex;align-items:center;justify-content:space-between;gap:35px;padding:clamp(30px,5vw,48px);background:var(--color-surface-muted)}.direct-contact p:not(.label){max-width:650px;margin:14px 0 0;color:var(--color-ink-muted);line-height:1.9}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding-inline:24px;background:var(--color-accent);color:var(--color-surface);text-decoration:none;font-size:var(--text-sm);white-space:nowrap}.button:focus-visible{outline:2px solid var(--color-ink);outline-offset:4px}@media(max-width:650px){.direct-contact{align-items:flex-start;flex-direction:column}.button{width:100%}}@media(max-width:520px){.links a{grid-template-columns:32px 1fr 22px}.links strong{font-size:var(--text-base)}}
</style>
