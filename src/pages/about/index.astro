---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { getProfilePageSchema, getBreadcrumbSchema } from "../../lib/schema";
import { site } from "../../lib/site";
import { person } from "../../lib/person";

const publications = (await getCollection("publications", ({ data }) => data.verified)).sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const profileSchema = { ...getProfilePageSchema(), image: new URL(person.image.src, site.url).toString() };
const breadcrumbSchema = getBreadcrumbSchema([{ name: "خانه", url: `${site.url}/` }, { name: "درباره دکتر لیلا رضوی", url: `${site.url}/about/` }]);
---
<BaseLayout title={`دکتر لیلا رضوی | روان‌شناس، مدرس دانشگاه و پژوهشگر`} description="معرفی حرفه‌ای دکتر لیلا رضوی، حوزه‌های پژوهشی، آثار علمی و فعالیت‌های حرفه‌ای مستند." canonical={`${site.url}/about/`} lang="fa" schemas={[profileSchema, breadcrumbSchema]}>
  <article class="profile-page"><div class="container">
    <header class="profile-header"><div class="profile-image"><img src={person.image.src} alt={person.image.altFa} width="600" height="750" loading="eager" decoding="async" /></div><div><p class="eyebrow">روان‌شناس، مدرس دانشگاه و پژوهشگر</p><h1>{person.fullNameFa}</h1><p class="lead">{person.description.fa}</p></div></header>
    <div class="profile-layout"><main>
      <section><p class="section-label">معرفی</p><h2>درباره</h2><p>{person.description.fa}</p><p>فعالیت‌های علمی و حرفه‌ای دکتر لیلا رضوی در این وب‌سایت بر اساس منابع عمومی و آثار قابل‌راستی‌آزمایی سازمان‌دهی شده‌اند.</p></section>
      <section><p class="section-label">هویت حرفه‌ای</p><h2>حوزه‌های تخصصی</h2><ul class="knowledge-list">{person.knowsAbout.map((area) => <li>{area}</li>)}</ul></section>
      <section><p class="section-label">سوابق</p><h2>نقش‌های حرفه‌ای مستند</h2>{person.positions.map((position) => <article class="item"><h3>{position.titleFa}</h3><p>{position.organizationFa}</p><a href={position.source} target="_blank" rel="noopener noreferrer">منبع عمومی ↗</a></article>)}</section>
      <section><p class="section-label">پژوهش</p><h2>آثار علمی</h2><div>{publications.slice(0, 3).map((publication) => <PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal ?? publication.data.publisher} url={`/publications/${publication.id}/`} />)}</div><a class="text-link" href="/publications/">مشاهده همه آثار ←</a></section>
    </main><aside>
      <div class="side-block"><strong>عضویت حرفه‌ای</strong><span>سازمان نظام روان‌شناسی و مشاوره ایران</span><span>عضویت: {person.professionalCredentials.psychologyOrganization.membershipNumber}</span><span>شماره پروانه: {person.professionalCredentials.psychologyOrganization.licenseNumber}</span></div>
      <div class="side-block"><strong>وابستگی</strong>{person.affiliations.map((affiliation) => <a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name}</a>)}</div>
      <div class="side-block"><strong>پروفایل‌ها</strong>{Object.entries(person.profiles).map(([label, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>)}</div>
    </aside></div>
  </div></article>
</BaseLayout>
<style>
.profile-page{padding-block:90px}.profile-header{display:grid;grid-template-columns:300px 1fr;gap:70px;align-items:center;padding-bottom:80px;border-bottom:1px solid #ddd7d0}.profile-image img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover}.eyebrow,.section-label{margin:0 0 14px;color:#806f61;font-size:.78rem;font-weight:600;letter-spacing:.05em}h1{margin:0 0 24px;font-size:clamp(3rem,7vw,5rem);line-height:1.15;font-weight:500}.lead{max-width:650px;margin:0;color:#666;font-size:1.15rem;line-height:2}.profile-layout{display:grid;grid-template-columns:minmax(0,760px) 240px;gap:90px;padding-top:80px}main section{padding-bottom:60px}h2{margin:0 0 22px;font-size:2rem;font-weight:500}main p,aside span{color:#555;line-height:2}.knowledge-list{display:flex;flex-wrap:wrap;gap:10px;padding:0;list-style:none}.knowledge-list li{padding:8px 14px;border:1px solid #ddd7d0;color:#666;font-size:.85rem}.item{padding:22px 0;border-top:1px solid #eee9e4}.item h3{margin:0;font-size:1.1rem;font-weight:600}.item p{margin:6px 0}.item a,.text-link{color:#806f61;text-decoration:none}.side-block{display:flex;flex-direction:column;gap:10px;padding-bottom:35px}.side-block strong{color:#806f61;font-size:.78rem}.side-block a{color:#555;text-decoration:none;font-size:.85rem}.side-block a:hover{color:#806f61}@media(max-width:800px){.profile-header{grid-template-columns:1fr;gap:40px}.profile-image{max-width:280px}.profile-layout{grid-template-columns:1fr;gap:30px}}
</style>
