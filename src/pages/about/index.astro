---
import PublicationCard from "../../components/PublicationCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getProfilePageSchema, getBreadcrumbSchema } from "../../lib/schema";
import { site } from "../../lib/site";
import { person } from "../../lib/person";

const publications = (await getCollection("publications", ({ data }) => data.verified)).sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const profileSchema = { ...getProfilePageSchema(), image: new URL(person.image.src, site.url).toString() };
const breadcrumbSchema = getBreadcrumbSchema([{ name: "خانه", url: `${site.url}/` }, { name: "درباره دکتر لیلا رضوی", url: `${site.url}/about/` }]);
---

<BaseLayout
  title="درباره دکتر لیلا رضوی | روان‌شناس، مدرس دانشگاه و پژوهشگر"
  description="معرفی حرفه‌ای دکتر لیلا رضوی، حوزه‌های پژوهشی، آثار علمی و فعالیت‌های حرفه‌ای مستند."
  canonical={`${site.url}/about/`}
  lang="fa"
  schemas={[profileSchema, breadcrumbSchema]}
>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="container about-hero-grid">
        <div class="about-copy">
          <p class="eyebrow"><span>01</span> درباره من</p>
          <h1 id="about-title">دکتر لیلا رضوی</h1>
          <p class="about-role">روان‌شناس · مدرس دانشگاه · پژوهشگر</p>
          <p class="about-lead">مسیر حرفه‌ای در روان‌شناسی، آموزش و پژوهش؛ با تمرکز بر فعالیت‌های علمی و حرفه‌ای مستند.</p>
        </div>
        <figure class="about-portrait">
          <img src={person.image.src} alt={person.image.altFa} width="1018" height="1024" loading="eager" decoding="async" />
          <figcaption>Leila Razavi · Psychology · Research · Education</figcaption>
        </figure>
      </div>
    </section>

    <section class="identity" aria-labelledby="identity-title">
      <div class="container identity-grid">
        <div class="section-index">02</div>
        <div>
          <p class="section-label">هویت حرفه‌ای</p>
          <h2 id="identity-title">روان‌شناسی، پژوهش و آموزش در یک روایت حرفه‌ای</h2>
        </div>
        <div class="identity-copy">
          <p>{person.description.fa}</p>
          <p>این صفحه تصویری فشرده از مسیر حرفه‌ای، حوزه‌های تخصصی و شواهد علمی ارائه می‌دهد. برای جزئیات کامل‌تر، سوابق حرفه‌ای و آثار علمی در صفحات مستقل قابل بررسی‌اند.</p>
        </div>
      </div>
    </section>

    <section class="expertise" id="research" aria-labelledby="expertise-title">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="section-label">حوزه‌های تخصصی</p>
            <h2 id="expertise-title">تمرکزهای حرفه‌ای و پژوهشی</h2>
          </div>
          <span class="section-index">03</span>
        </div>
        <div class="expertise-list">
          {person.knowsAbout.map((topic, index) => (
            <div class="expertise-row">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{topic}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="positions" aria-labelledby="positions-title">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="section-label">مسیر حرفه‌ای</p>
            <h2 id="positions-title">نقش‌ها و فعالیت‌های حرفه‌ای</h2>
          </div>
          <a class="quiet-link" href="/experience/">جزئیات فعالیت حرفه‌ای <span aria-hidden="true">←</span></a>
        </div>
        <div class="timeline">
          {person.positions.map((position) => (
            <article class="timeline-item">
              <div>
                <h3>{position.titleFa}</h3>
                <p>{position.organizationFa}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="selected-work" aria-labelledby="selected-work-title">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="section-label">شواهد علمی</p>
            <h2 id="selected-work-title">آثار علمی منتخب</h2>
          </div>
          <a class="quiet-link" href="/publications/">مشاهده همه آثار <span aria-hidden="true">←</span></a>
        </div>
        <div class="publication-list">
          {publications.slice(0, 3).map((publication) => (
            <PublicationCard
              title={publication.data.title}
              titleFa={publication.data.titleFa}
              authors={publication.data.authors}
              year={publication.data.year}
              journal={publication.data.journal}
              url={`/publications/${publication.id}/`}
            />
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page { overflow: clip; }
  .about-hero { padding-block: clamp(68px, 9vw, 120px); border-bottom: 1px solid var(--color-border); }
  .about-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 480px); gap: clamp(48px, 9vw, 130px); align-items: center; }
  .about-copy { max-width: 760px; }
  .about-copy h1 { margin: 0; font-size: var(--text-display); line-height: 1.08; font-weight: 500; letter-spacing: -.045em; }
  .about-role { margin: 18px 0 0; color: var(--color-accent-strong); font-size: var(--text-lg); font-weight: 600; }
  .about-lead { max-width: 680px; margin: 28px 0 0; color: var(--color-ink-muted); font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 2; }
  .about-portrait { margin: 0; }
  .about-portrait img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .about-portrait figcaption { padding-top: 12px; color: var(--color-ink-muted); font-size: var(--text-xs); letter-spacing: .04em; direction: ltr; text-align: left; }
  .identity { padding-block: clamp(78px, 10vw, 130px); border-bottom: 1px solid var(--color-border); }
  .identity-grid { display: grid; grid-template-columns: 54px minmax(260px, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 70px); }
  .identity h2, .section-topline h2 { margin: 0; max-width: 680px; font-size: var(--text-title); line-height: 1.35; font-weight: 500; }
  .identity-copy { max-width: 720px; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 2; }
  .identity-copy p { margin: 0 0 22px; }
  .identity-copy p:last-child { margin-bottom: 0; }
  .expertise, .positions, .selected-work { padding-block: clamp(72px, 9vw, 110px); border-bottom: 1px solid var(--color-border); }
  .section-topline { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 46px; }
  .section-index { color: var(--color-accent); font-size: var(--text-xs); font-weight: 700; font-variant-numeric: tabular-nums; }
  .expertise-list { border-top: 1px solid var(--color-border); }
  .expertise-row { display: grid; grid-template-columns: 70px 1fr; align-items: center; gap: 20px; min-height: 92px; border-bottom: 1px solid var(--color-border); }
  .expertise-row > span { color: var(--color-accent); font-size: var(--text-xs); font-weight: 700; }
  .expertise-row h3 { margin: 0; font-size: var(--text-lg); font-weight: 500; }
  .timeline { border-top: 1px solid var(--color-border); }
  .timeline-item { display: grid; grid-template-columns: 1fr; gap: 30px; padding-block: 28px; border-bottom: 1px solid var(--color-border); }
  .timeline-item h3 { margin: 0 0 8px; font-size: var(--text-lg); font-weight: 600; }
  .timeline-item p { margin: 0; color: var(--color-ink-muted); line-height: 1.8; }
  .quiet-link { color: var(--color-accent-strong); text-decoration: none; font-size: var(--text-sm); font-weight: 600; white-space: nowrap; }
  .quiet-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .publication-list { display: grid; gap: 1px; }
  @media (max-width: 820px) {
    .about-hero-grid { grid-template-columns: 1fr; }
    .about-portrait { width: min(100%, 430px); }
    .identity-grid { grid-template-columns: 36px 1fr; }
    .identity-copy { grid-column: 2; }
    .section-topline { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 560px) {
    .identity-grid { grid-template-columns: 1fr; }
    .identity-copy { grid-column: auto; }
    .expertise-row { grid-template-columns: 44px 1fr; min-height: 78px; }
  }
</style>
