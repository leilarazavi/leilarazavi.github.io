---
import PublicationCard from "../../components/PublicationCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getProfilePageSchema, getBreadcrumbSchema } from "../../lib/schema";
import { site } from "../../lib/site";
import { person } from "../../lib/person";

const publications = (await getCollection("publications", ({ data }) => data.verified)).sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const profileSchema = { ...getProfilePageSchema(), image: new URL(person.image.src, site.url).toString() };
const breadcrumbSchema = getBreadcrumbSchema([{ name: "خانه", url: `${site.url}/` }, { name: "درباره دکتر لیلا رضوی", url: `${site.url}/about/` }]);
---

<BaseLayout title="دکتر لیلا رضوی | روان‌شناس، مدرس دانشگاه و پژوهشگر" description="معرفی حرفه‌ای دکتر لیلا رضوی، حوزه‌های پژوهشی، آثار علمی و فعالیت‌های حرفه‌ای مستند." canonical={`${site.url}/about/`} lang="fa" schemas={[profileSchema, breadcrumbSchema]}>
  <!--
    ABOUT PAGE DECISION

    About is now the narrative layer of the brand, not a second CV. The page
    keeps the evidence-backed data already present in person.ts, but separates
    identity, expertise, research, professional roles and proof points visually.
    CV and Publications remain separate destinations so content is not repeated
    at equal visual weight across the site.
  -->
  <article class="profile-page">
    <div class="container">
      <header class="profile-header">
        <figure class="profile-image"><img src={person.image.src} alt={person.image.altFa} width="694" height="766" loading="eager" decoding="async" /></figure>
        <div class="profile-intro">
          <p class="eyebrow">روان‌شناس · مدرس دانشگاه · پژوهشگر</p>
          <h1>{person.fullNameFa}</h1>
          <p class="lead">{person.description.fa}</p>
          <div class="intro-links"><a class="button" href="/experience/">فعالیت حرفه‌ای</a><a class="text-link" href="/cv/">مشاهده رزومه →</a></div>
        </div>
      </header>

      <div class="profile-layout">
        <main>
          <section>
            <p class="section-label">معرفی</p>
            <h2>یک نگاه نزدیک‌تر</h2>
            <p>{person.description.fa}</p>
            <p>این صفحه هویت و مسیر حرفه‌ای را توضیح می‌دهد؛ جزئیات کامل آثار علمی و فعالیت‌های حرفه‌ای در صفحات تخصصی سایت سازمان‌دهی شده‌اند.</p>
          </section>

          <section>
            <p class="section-label">هویت حرفه‌ای</p>
            <h2>حوزه‌های تخصصی</h2>
            <div class="knowledge-list">{person.knowsAbout.map((area) => <span>{area}</span>)}</div>
          </section>

          <section id="research">
            <p class="section-label">پژوهش</p>
            <div class="section-title-row"><h2>حوزه‌های پژوهشی</h2><a class="text-link" href="/publications/">آثار علمی →</a></div>
            <div class="research-list">{person.research.researchInterests.map((topic, index) => <article><span>{String(index + 1).padStart(2,"0")}</span><h3>{topic}</h3></article>)}</div>
            <p class="research-note">این فهرست فقط حوزه‌هایی را نمایش می‌دهد که در داده‌های مستند پروژه پشتیبانی می‌شوند.</p>
          </section>

          <section>
            <p class="section-label">سوابق</p>
            <h2>نقش‌های حرفه‌ای مستند</h2>
            <div class="timeline">{person.positions.map((position) => <article class="timeline-item"><div class="timeline-marker" aria-hidden="true"></div><div><h3>{position.titleFa}</h3><p>{position.organizationFa}</p><a href={position.source} target="_blank" rel="noopener noreferrer">مشاهده منبع عمومی ↗</a></div></article>)}</div>
          </section>

          <section>
            <div class="section-title-row"><div><p class="section-label">آثار علمی</p><h2>برگزیده‌ای از آثار</h2></div><a class="text-link" href="/publications/">همه آثار →</a></div>
            <div class="publication-list">{publications.slice(0, 3).map((publication) => <PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal ?? publication.data.publisher} url={`/publications/${publication.id}/`} />)}</div>
          </section>
        </main>

        <aside>
          <div class="side-block"><strong>اعتبار حرفه‌ای</strong><span>سازمان نظام روان‌شناسی و مشاوره ایران</span><span>عضویت: {person.professionalCredentials.psychologyOrganization.membershipNumber}</span><span>شماره پروانه: {person.professionalCredentials.psychologyOrganization.licenseNumber}</span></div>
          <div class="side-block"><strong>وابستگی‌ها</strong>{person.affiliations.map((affiliation) => <a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name}</a>)}</div>
          <div class="side-block"><strong>پروفایل‌های رسمی</strong>{Object.entries(person.profiles).map(([label, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>)}</div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .profile-page{padding-block:clamp(72px,9vw,112px)}.profile-header{display:grid;grid-template-columns:minmax(250px,360px) minmax(0,1fr);gap:clamp(48px,8vw,110px);align-items:center;padding-bottom:clamp(70px,9vw,110px);border-bottom:1px solid var(--color-border)}.profile-image{width:min(100%,360px);margin:0}.profile-image img{display:block;width:100%;height:auto;aspect-ratio:694/766;object-fit:cover}.eyebrow,.section-label{margin:0 0 var(--space-4);color:var(--color-accent);font-size:var(--text-xs);font-weight:700;letter-spacing:.05em}.profile-intro h1{margin:0 0 24px;font-size:var(--text-display);line-height:1.08;font-weight:500;letter-spacing:-.045em}.lead{max-width:760px;margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.intro-links{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:34px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding-inline:24px;border:1px solid var(--color-accent);background:var(--color-accent);color:var(--color-surface);text-decoration:none;font-size:var(--text-sm)}.text-link{color:var(--color-accent-strong);text-decoration:none;font-size:var(--text-sm)}.text-link:hover{text-decoration:underline;text-underline-offset:5px}.profile-layout{display:grid;grid-template-columns:minmax(0,780px) minmax(210px,250px);gap:clamp(60px,9vw,120px);padding-top:clamp(70px,9vw,110px)}main section{padding-bottom:clamp(65px,8vw,95px)}h2{margin:0 0 22px;font-size:var(--text-title);line-height:1.3;font-weight:500}.section-title-row{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:30px}.section-title-row h2{margin:0}main p{max-width:760px;color:var(--color-ink-muted);line-height:2}.knowledge-list{display:flex;flex-wrap:wrap;gap:8px}.knowledge-list span{padding:9px 14px;border:1px solid var(--color-border);color:var(--color-ink-muted);font-size:var(--text-sm)}.research-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--color-border)}.research-list article{display:grid;grid-template-columns:38px 1fr;gap:12px;min-height:100px;padding:24px 18px 24px 0;border-bottom:1px solid var(--color-border)}.research-list article:nth-child(odd){border-inline-end:1px solid var(--color-border);padding-inline-end:24px}.research-list article:nth-child(even){padding-inline-start:24px}.research-list span{color:var(--color-accent);font-size:var(--text-xs);padding-top:4px}.research-list h3{margin:0;font-size:var(--text-base);line-height:1.8;font-weight:500}.research-note{font-size:var(--text-sm);color:var(--color-ink-subtle)}.timeline{border-top:1px solid var(--color-border)}.timeline-item{display:grid;grid-template-columns:22px 1fr;gap:18px;padding:25px 0;border-bottom:1px solid var(--color-border)}.timeline-marker{width:8px;height:8px;margin-top:9px;border-radius:50%;background:var(--color-accent)}.timeline-item h3{margin:0;font-size:var(--text-base);font-weight:600}.timeline-item p{margin:5px 0;font-size:var(--text-sm)}.timeline-item a{color:var(--color-accent-strong);font-size:var(--text-sm);text-decoration:none}.publication-list{display:grid;gap:1px}.side-block{display:flex;flex-direction:column;gap:10px;padding-bottom:36px}.side-block strong{color:var(--color-accent);font-size:var(--text-xs)}.side-block span,.side-block a{color:var(--color-ink-muted);font-size:var(--text-sm);line-height:1.8;text-decoration:none}.side-block a:hover{color:var(--color-accent-strong)}@media(max-width:800px){.profile-header{grid-template-columns:1fr}.profile-image{width:min(100%,300px)}.profile-layout{grid-template-columns:1fr;gap:20px}.research-list{grid-template-columns:1fr}.research-list article:nth-child(odd){border-inline-end:0;padding-inline-end:18px}.research-list article:nth-child(even){padding-inline-start:0}.section-title-row{align-items:flex-start;flex-direction:column}}
@media(max-width:480px){.intro-links{align-items:flex-start;flex-direction:column}.button{width:100%}}
</style>
