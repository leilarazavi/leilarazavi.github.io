---
import PublicationCard from "../../components/PublicationCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getProfilePageSchema, getBreadcrumbSchema } from "../../lib/schema";
import { site } from "../../lib/site";
import { person } from "../../lib/person";

const publications = (await getCollection("publications", ({ data }) => data.verified)).sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const profileSchema = { ...getProfilePageSchema(), image: new URL(person.image.src, site.url).toString() };
const breadcrumbSchema = getBreadcrumbSchema([{ name: "خانه", url: `${site.url}/` }, { name: "درباره دکتر لیلا رضوی", url: `${site.url}/about/` }]);
---

<BaseLayout title="درباره دکتر لیلا رضوی | روان‌شناس، مدرس دانشگاه و پژوهشگر" description="معرفی حرفه‌ای دکتر لیلا رضوی، حوزه‌های پژوهشی، آثار علمی و فعالیت‌های حرفه‌ای مستند." canonical={`${site.url}/about/`} lang="fa" schemas={[profileSchema, breadcrumbSchema]}>
  <!--
    ABOUT PAGE DECISION

    About is now the narrative layer of the brand, not a second CV. The page
    keeps the evidence-backed data already present in person.ts, but separates
    identity, expertise, research, professional roles and proof points visually.
    CV and Publications remain separate destinations so content is not repeated
    at equal visual weight across the site.

    SEO DECISION

    The homepage and About page intentionally have distinct titles. The
    homepage owns the broad branded query; About owns the informational intent
    around the person's professional profile. This avoids sending duplicate
    title signals while keeping the person's name and professional identity in
    both titles.

    COMPONENT CONTRACT DECISION

    PublicationCard has an explicit prop contract (title/authors/year/journal/url).
    The collection entry is deliberately mapped into that contract here instead
    of passing the whole Astro content entry. This prevents a runtime mismatch
    when a component expects `authors` but receives only a `publication` object.
  -->
  <article class="profile-page">
    <div class="container">
      <header class="page-header">
        <p class="eyebrow">درباره من</p>
        <h1>دکتر لیلا رضوی</h1>
        <p class="lead">روان‌شناس، مدرس دانشگاه و پژوهشگر</p>
      </header>

      <div class="profile-grid">
        <div class="profile-copy">
          <p>{person.description.fa}</p>
          <p>در این صفحه، مسیر حرفه‌ای، حوزه‌های تخصصی، فعالیت‌های پژوهشی و نقش‌های حرفه‌ای من در یک روایت منسجم ارائه شده است.</p>
        </div>

        <aside class="profile-aside">
          <div class="profile-card">
            <p class="eyebrow">حوزه‌های تخصصی</p>
            <ul>
              {person.knowsAbout.map((topic) => <li>{topic}</li>)}
            </ul>
          </div>
        </aside>
      </div>

      <section class="profile-section">
        <header class="section-header">
          <p class="eyebrow">نقش‌های حرفه‌ای</p>
          <h2>تجربه و فعالیت حرفه‌ای</h2>
        </header>
        <div class="timeline">
          {person.positions.map((position) => (
            <article class="timeline-item">
              <p class="meta">{position.start} — {position.end ?? "اکنون"}</p>
              <h3>{position.titleFa}</h3>
              <p>{position.organizationFa}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="profile-section">
        <header class="section-header">
          <p class="eyebrow">آثار علمی</p>
          <h2>پژوهش و انتشارات</h2>
        </header>
        <div class="publication-list">
          {publications.slice(0, 3).map((publication) => (
            <PublicationCard
              title={publication.data.title}
              titleFa={publication.data.titleFa}
              authors={publication.data.authors}
              year={publication.data.year}
              journal={publication.data.journal}
              url={`/publications/${publication.id}/`}
            />
          ))}
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .profile-page { padding: var(--space-12) 0 var(--space-16); }
  .page-header { max-width: var(--measure-wide); margin-bottom: var(--space-10); }
  .profile-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr); gap: var(--space-10); }
  .profile-copy { max-width: var(--measure-reading); font-size: var(--text-body-lg); line-height: 1.95; }
  .profile-aside { align-self: start; }
  .profile-card { padding: var(--space-6); border: 1px solid var(--color-border); background: var(--color-surface); }
  .profile-card ul { margin: var(--space-4) 0 0; padding-inline-start: 1.2rem; }
  .profile-section { margin-top: var(--space-12); }
  .section-header { max-width: var(--measure-reading); margin-bottom: var(--space-6); }
  .timeline { border-block-start: 1px solid var(--color-border); }
  .timeline-item { padding: var(--space-5) 0; border-block-end: 1px solid var(--color-border); }
  .timeline-item h3 { margin: var(--space-2) 0; }
  .publication-list { display: grid; gap: var(--space-5); }
  @media (max-width: 760px) {
    .profile-grid { grid-template-columns: 1fr; }
  }
</style>
