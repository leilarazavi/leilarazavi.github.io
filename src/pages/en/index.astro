---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { person } from "../../lib/person";
import { podcast } from "../../lib/media";
import { site } from "../../lib/site";
const entries = await getCollection("publications", ({ data }) => data.verified);
const publications = entries.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---
<BaseLayout title={site.title.en} description="Official website of Dr. Leila Razavi, psychologist, university lecturer and researcher." canonical={`${site.url}/en/`} lang="en">
  <section class="hero"><div class="container"><img src={person.image.src} alt={person.image.altEn} width="694" height="766" loading="eager" decoding="async" /><div><p class="label">Psychologist, University Lecturer and Researcher</p><h1>Dr. Leila Razavi</h1><p class="lead">Official profile presenting her professional background, research activities, verified publications and public media presence.</p><div class="actions"><a href="/en/about/">About</a><a href="/en/publications/">Publications</a><a href="/en/cv/">CV</a></div></div></div></section>
  <section class="section"><div class="container"><h2>Research areas</h2><div class="topics">{person.knowsAbout.map((area)=><span>{area}</span>)}</div><a class="more" href="/en/about/#research">Research details →</a></div></section>
  <section class="section"><div class="container"><h2>Verified publications</h2>{publications.slice(0,3).map((publication)=><article><p>{publication.data.year ?? ""}{publication.data.year && publication.data.journal ? ` · ${publication.data.journal}` : ""}</p><h3><a href={`/en/publications/${publication.id}/`}>{publication.data.title}</a></h3><span>{publication.data.authors.join(", ")}</span></article>)}</div></section>
  <section class="section feature"><div class="container"><p class="label">Podcast</p><h2>{podcast.nameEn}</h2><p>{podcast.descriptionEn}</p><div class="actions"><a href="/en/media/sohbat-jan/">Podcast page →</a><a href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify →</a></div></div></section>
  <section class="section feature"><div class="container"><p class="label">Professional activity</p><h2>Pendar organizational structure</h2><p>Dr. Leila Razavi's relationship with Pendar Nimrokh Qom and the wider Pendar structure is documented separately from her personal profile.</p><div class="actions"><a href="/en/organizations/">Organizations →</a><a href="/en/media/">Media →</a></div></div></section>
</BaseLayout>
<style>
.hero{padding:90px 0;border-bottom:1px solid #ddd7d0}.hero .container{display:grid;grid-template-columns:280px 1fr;gap:70px;align-items:center}.hero img{width:100%;height:auto;aspect-ratio:694/766;object-fit:cover}.label{color:#806f61;font-weight:600;font-size:.8rem}.hero h1{font-size:clamp(3rem,7vw,5rem);font-weight:500}.lead{max-width:700px;color:#555;line-height:2}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.actions a{padding:12px 20px;border:1px solid #806f61;color:#806f61;text-decoration:none}.section{padding:80px 0;border-bottom:1px solid #ddd7d0}h2{font-size:2rem;font-weight:500}.topics{display:flex;flex-wrap:wrap;gap:10px}.topics span{padding:9px 14px;border:1px solid #ddd7d0;color:#555}.more{display:inline-block;margin-top:24px;color:#806f61;text-decoration:none;font-weight:600}article{padding:28px 0;border-top:1px solid #ddd7d0}article p{color:#806f61;font-size:.8rem}article h3{max-width:900px;font-size:1.2rem;line-height:1.6}article a{color:#222;text-decoration:none}article span{color:#666;font-size:.9rem}.feature p{max-width:800px;color:#555;line-height:2}@media(max-width:800px){.hero .container{grid-template-columns:1fr;gap:35px}.hero img{max-width:280px}}
</style>