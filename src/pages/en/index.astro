---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { person } from "../../lib/person";
import { podcast } from "../../lib/media";
import { site } from "../../lib/site";

const entries = await getCollection("publications", ({ data }) => data.verified);
const publications = entries.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const focusAreas = person.knowsAbout.slice(1, 6);
---

<BaseLayout
  title={site.title.en}
  description="Official website of Dr. Leila Razavi, psychologist, university lecturer and researcher."
  canonical={`${site.url}/en/`}
  lang="en"
>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span>01</span> Psychologist · University Lecturer · Researcher</p>
          <h1 id="hero-title">Dr. Leila Razavi</h1>
          <p class="hero-lead">Professional work across psychology, education and research, with a focus on psychological interventions, health and quality of life.</p>
          <div class="hero-actions" aria-label="Primary paths">
            <a class="button button-primary" href="/en/about/">About <span aria-hidden="true">→</span></a>
            <a class="quiet-link" href="/en/publications/">View publications <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="hero-visual">
          <figure class="portrait-frame">
            <img
              src={person.image.src}
              alt={person.image.altEn}
              width="1018"
              height="1024"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
          <div class="portrait-caption">
            <span>Leila Razavi</span>
            <span>Psychology · Research · Education</span>
          </div>
        </div>
      </div>
    </section>

    <section class="intro" aria-labelledby="intro-title">
      <div class="container intro-grid">
        <div class="section-index">02</div>
        <div class="intro-heading">
          <p class="section-label">Professional approach</p>
          <h2 id="intro-title">Psychology, research and education in one professional path</h2>
        </div>
        <div class="intro-copy">
          <p>{person.description.en}</p>
          <p class="intro-detail">This website is the official reference for professional work, academic publications, research activity and public media presence.</p>
          <a class="quiet-link" href="/en/experience/">View professional activity <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="focus" aria-labelledby="focus-title">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="section-label">Areas of focus</p>
            <h2 id="focus-title">The areas shaping professional and research work</h2>
          </div>
          <span class="section-index">03</span>
        </div>

        <div class="focus-list">
          {focusAreas.map((area, index) => (
            <a class="focus-item" href="/en/about/#research">
              <span class="focus-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="focus-name">{area}</span>
              <span class="focus-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="works" aria-labelledby="works-title">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="section-label">Research & publications</p>
            <h2 id="works-title">A selection from the academic record</h2>
          </div>
          <div class="section-action">
            <span class="section-index">04</span>
            <a class="quiet-link" href="/en/publications/">All publications <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="publication-list">
          {publications.slice(0, 3).map((publication, index) => (
            <div class="publication-row">
              <span class="publication-index">{String(index + 1).padStart(2, "0")}</span>
              <PublicationCard
                title={publication.data.title}
                titleFa={publication.data.titleFa}
                authors={publication.data.authors}
                year={publication.data.year}
                journal={publication.data.journal}
                url={`/en/publications/${publication.id}/`}
                language="en"
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="professional" aria-labelledby="professional-title">
      <div class="container professional-shell">
        <div class="professional-label">
          <span class="section-index">05</span>
          <p class="section-label">Professional activity</p>
        </div>
        <div class="professional-copy">
          <h2 id="professional-title">From professional practice to organizational collaboration</h2>
          <p>Professional roles, collaborations and organizational activity are documented separately to give a clearer view of the wider professional trajectory.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="/en/experience/">Professional activity <span aria-hidden="true">→</span></a>
            <a class="quiet-link" href="/en/organizations/">Organizations & collaborations <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="media" aria-labelledby="media-title">
      <div class="container media-grid">
        <div class="media-copy">
          <p class="section-label">Media</p>
          <h2 id="media-title">{podcast.nameEn}</h2>
          <p>{podcast.descriptionEn}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/en/media/sohbat-jan/">Podcast page <span aria-hidden="true">→</span></a>
            <a class="quiet-link" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="media-card" aria-hidden="true">
          <span class="media-number">06</span>
          <span class="media-word">Sohbat<br />Jan</span>
          <span class="media-caption">Conversations about human experience</span>
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div class="container final-cta-inner">
        <div>
          <p class="section-label">Official resources</p>
          <h2 id="final-cta-title">Continue through the official profiles and contact routes.</h2>
        </div>
        <a class="button button-dark" href="/en/contact/">Profiles & contact <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { padding-block: clamp(58px, 8vw, 104px) clamp(76px, 10vw, 132px); border-bottom: 1px solid var(--color-border); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .82fr); align-items: center; gap: clamp(48px, 9vw, 128px); }
  .hero-copy { max-width: 720px; }
  .eyebrow, .section-label { margin: 0; color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; }
  .eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .eyebrow span, .section-index { color: var(--color-ink-faint); font-variant-numeric: tabular-nums; }
  .hero h1 { max-width: 700px; margin: 0; font-family: var(--font-heading); font-size: clamp(3.6rem, 7.2vw, 7.5rem); font-weight: 500; line-height: .98; letter-spacing: -.055em; }
  .hero-lead { max-width: 620px; margin: 34px 0 36px; color: var(--color-ink-muted); font-size: clamp(1.1rem, 1.6vw, 1.28rem); line-height: 1.9; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 50px; padding: 12px 22px; border: 1px solid transparent; text-decoration: none; font-size: var(--text-sm); font-weight: 700; transition: transform var(--transition-fast), background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast); }
  .button:hover { transform: translateY(-2px); }
  .button-primary { background: var(--color-accent); color: var(--color-surface); }
  .button-dark { background: var(--color-ink); color: var(--color-surface); }
  .quiet-link { color: var(--color-accent-strong); text-decoration: none; font-size: var(--text-sm); font-weight: 700; }
  .quiet-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .hero-visual { width: min(100%, 500px); justify-self: end; }
  .portrait-frame { position: relative; margin: 0; aspect-ratio: 1 / 1.06; overflow: hidden; background: var(--color-surface-muted); }
  .portrait-frame::after { position: absolute; inset: 14px; border: 1px solid color-mix(in srgb, white 62%, transparent); content: ""; pointer-events: none; }
  .portrait-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center 32%; }
  .portrait-caption { display: flex; justify-content: space-between; gap: 18px; padding-top: 12px; color: var(--color-ink-muted); font-size: .68rem; letter-spacing: .04em; }
  .intro { padding-block: clamp(82px, 11vw, 146px); }
  .intro-grid { display: grid; grid-template-columns: 54px minmax(260px, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 64px); }
  .intro h2, .section-topline h2, .professional h2, .media h2, .final-cta h2 { margin: 0; font-family: var(--font-heading); font-weight: 500; letter-spacing: -.025em; line-height: 1.35; }
  .intro h2 { margin-top: 14px; font-size: clamp(2rem, 3.4vw, 3.4rem); }
  .intro-copy { padding-top: 12px; }
  .intro-copy p { max-width: 690px; margin: 0; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 1.95; }
  .intro-copy .intro-detail { margin-top: 20px; font-size: var(--text-base); }
  .intro-copy .quiet-link { display: inline-block; margin-top: 28px; }
  .focus, .works { padding-block: clamp(80px, 10vw, 132px); border-top: 1px solid var(--color-border); }
  .section-topline { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; margin-bottom: 48px; }
  .section-topline h2 { max-width: 780px; margin-top: 12px; font-size: clamp(2rem, 3.2vw, 3.2rem); }
  .section-topline > .section-index { padding-bottom: 8px; }
  .section-action { display: flex; align-items: center; gap: 30px; padding-bottom: 8px; }
  .focus-list { border-top: 1px solid var(--color-border); }
  .focus-item { display: grid; grid-template-columns: 62px 1fr 28px; align-items: center; gap: 24px; min-height: 92px; border-bottom: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; transition: padding-inline var(--transition-fast), background var(--transition-fast); }
  .focus-item:hover { padding-inline: 14px; background: var(--color-surface-muted); }
  .focus-number { color: var(--color-accent); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .focus-name { font-size: clamp(1rem, 1.5vw, 1.2rem); }
  .focus-arrow { color: var(--color-ink-faint); transition: transform var(--transition-fast), color var(--transition-fast); }
  .focus-item:hover .focus-arrow { color: var(--color-accent); transform: translate(2px, -2px); }
  .publication-list { border-top: 1px solid var(--color-border); }
  .publication-row { display: grid; grid-template-columns: 62px 1fr; align-items: start; gap: 20px; padding-block: 8px; border-bottom: 1px solid var(--color-border); }
  .publication-index { padding-top: 26px; color: var(--color-accent); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .publication-row :global(article) { border: 0; }
  .professional { padding-block: clamp(82px, 10vw, 132px); border-top: 1px solid var(--color-border); background: var(--color-surface-muted); }
  .professional-shell { display: grid; grid-template-columns: minmax(150px, .34fr) minmax(0, 1fr); gap: clamp(40px, 9vw, 140px); }
  .professional-label { display: flex; gap: 22px; align-items: flex-start; }
  .professional-label .section-label { padding-top: 4px; }
  .professional-copy { max-width: 780px; }
  .professional-copy h2 { font-size: clamp(2rem, 3.5vw, 3.6rem); }
  .professional-copy p { max-width: 690px; margin: 24px 0 0; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 2; }
  .media { padding-block: clamp(82px, 10vw, 132px); border-top: 1px solid var(--color-border); }
  .media-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .72fr); align-items: center; gap: clamp(48px, 9vw, 130px); }
  .media-copy { max-width: 700px; }
  .media-copy h2 { margin-top: 12px; font-size: clamp(3rem, 6vw, 6rem); letter-spacing: -.045em; }
  .media-copy > p:not(.section-label) { max-width: 660px; margin: 26px 0 0; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 2; }
  .media-card { min-height: 360px; display: flex; flex-direction: column; justify-content: space-between; padding: 28px; background: var(--color-accent); color: var(--color-surface); }
  .media-number { align-self: flex-end; font-size: var(--text-xs); opacity: .72; }
  .media-word { font-family: var(--font-heading); font-size: clamp(3.5rem, 7vw, 6.5rem); font-weight: 500; line-height: .88; letter-spacing: -.045em; }
  .media-caption { font-size: .72rem; letter-spacing: .04em; opacity: .8; }
  .final-cta { padding-block: 70px 100px; }
  .final-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: clamp(34px, 5vw, 58px); background: var(--color-accent-soft); }
  .final-cta h2 { max-width: 700px; margin-top: 10px; font-size: clamp(1.8rem, 3vw, 3rem); }
  @media (max-width: 900px) {
    .hero-grid, .media-grid { grid-template-columns: 1fr; }
    .hero-visual { justify-self: start; width: min(100%, 520px); }
    .intro-grid { grid-template-columns: 42px 1fr; }
    .intro-copy { grid-column: 2; }
    .professional-shell { grid-template-columns: 1fr; gap: 30px; }
    .final-cta-inner { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 640px) {
    .hero-grid { gap: 52px; }
    .hero h1 { font-size: clamp(3.2rem, 17vw, 5rem); }
    .portrait-caption { flex-direction: column; gap: 5px; }
    .intro-grid { display: block; }
    .intro-heading { margin-top: 18px; }
    .intro-copy { padding-top: 28px; }
    .section-topline { grid-template-columns: 1fr; gap: 18px; align-items: start; }
    .section-action { justify-content: space-between; padding-bottom: 0; }
    .focus-item { grid-template-columns: 42px 1fr 22px; gap: 14px; min-height: 82px; }
    .publication-row { grid-template-columns: 36px 1fr; gap: 10px; }
    .professional-label { gap: 14px; }
    .media-card { min-height: 300px; }
    .hero-actions { align-items: flex-start; }
    .button { width: 100%; }
  }
</style>
