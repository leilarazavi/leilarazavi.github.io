---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { person } from "../../lib/person";
import { podcast } from "../../lib/media";
import { site } from "../../lib/site";

const entries = await getCollection("publications", ({ data }) => data.verified);
const publications = entries.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<BaseLayout title={site.title.en} description="Official website of Dr. Leila Razavi, psychologist, university lecturer and researcher." canonical={`${site.url}/en/`} lang="en">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Psychologist · University Lecturer · Researcher</p>
        <h1>Dr. Leila Razavi</h1>
        <p class="hero-description">Official profile presenting professional activity, research, verified publications and public media work.</p>
        <div class="actions"><a class="button primary" href="/en/about/">About</a><a class="text-link" href="/en/publications/">View publications →</a></div>
      </div>
      <figure class="hero-image"><img src={person.image.src} alt={person.image.altEn} width="694" height="766" loading="eager" decoding="async" /></figure>
    </div>
  </section>

  <section class="positioning"><div class="container two-col"><div><p class="label">Professional focus</p><h2>Psychology, research and education in one professional profile.</h2></div><div><p>{person.description.en}</p><a class="text-link" href="/en/about/">Full profile →</a></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="label">Areas of work</p><h2>Professional and research focus</h2></div><a class="text-link" href="/en/about/#research">Research details →</a></div><div class="topics">{person.knowsAbout.map((area, index)=><article><span>{String(index + 1).padStart(2,"0")}</span><h3>{area}</h3></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="label">Research & publications</p><h2>Selected academic work</h2></div><a class="text-link" href="/en/publications/">All publications →</a></div><p class="section-intro">A selection of verified publications is presented as evidence of the research record, with bibliographic details available on each publication page.</p><div class="publication-list">{publications.slice(0,3).map((publication)=><PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal} url={`/en/publications/${publication.id}/`} />)}</div></div></section>
  <section class="section feature"><div class="container two-col"><div><p class="label">Professional activity</p><h2>Professional and organizational activity</h2></div><div><p>Professional activities, organizational collaborations and the relationship with Pendar Nimrokh are documented separately so each part of the professional record can be understood in context rather than as a list of titles.</p><div class="actions"><a class="button secondary" href="/en/experience/">Professional activity</a><a class="text-link" href="/en/organizations/">Organizations →</a></div></div></div></section>
  <section class="section media"><div class="container two-col"><div><p class="label">Media</p><h2>{podcast.nameEn}</h2></div><div><p>{podcast.descriptionEn}</p><div class="actions"><a class="button primary" href="/en/media/sohbat-jan/">Podcast page</a><a class="text-link" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify ↗</a></div></div></div></section>
  <section class="final"><div class="container final-inner"><div><p class="label">Official resources</p><h2>Continue through the official profile and contact links.</h2></div><a class="button primary" href="/en/contact/">Profiles & contact</a></div></section>
</BaseLayout>

<style>
.hero{padding-block:clamp(64px,8vw,104px) clamp(70px,9vw,112px);border-bottom:1px solid var(--color-border)}.hero-grid,.two-col{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.72fr);gap:clamp(44px,7vw,96px);align-items:center}.hero-copy{max-width:720px}.eyebrow,.label{margin:0 0 var(--space-4);color:var(--color-accent);font-size:var(--text-xs);font-weight:700;letter-spacing:.06em}.hero h1{margin:0;font-size:var(--text-display);line-height:1.08;font-weight:500;letter-spacing:-.045em}.hero-description{max-width:650px;margin:26px 0 34px;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:1.9}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:26px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding-inline:24px;border:1px solid var(--color-accent);text-decoration:none;font-size:var(--text-sm)}.primary{background:var(--color-accent);color:var(--color-surface)}.secondary{color:var(--color-accent-strong)}.text-link{color:var(--color-accent-strong);text-decoration:none;font-size:var(--text-sm)}.text-link:hover{text-decoration:underline;text-underline-offset:5px}.hero-image{width:min(100%,430px);margin:0;justify-self:end}.hero-image img{width:100%;height:auto;aspect-ratio:694/766;object-fit:cover}.positioning{padding-block:clamp(70px,9vw,110px)}.two-col{grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);gap:clamp(40px,8vw,110px)}.positioning h2,.feature h2,.media h2,.final h2{margin:0;max-width:700px;font-size:var(--text-title);line-height:1.35;font-weight:500}.positioning p:not(.label),.feature p:not(.label),.media p:not(.label),.section-intro{max-width:760px;margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.section{padding-block:clamp(68px,8vw,104px);border-top:1px solid var(--color-border)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px}.section-heading h2{margin:0;font-size:var(--text-title);font-weight:500}.section-intro{margin:-14px 0 30px!important;font-size:var(--text-base)!important}.topics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--color-border)}.topics article{display:grid;grid-template-columns:52px 1fr;gap:18px;min-height:120px;padding:24px 20px 24px 0;border-bottom:1px solid var(--color-border)}.topics article:nth-child(odd){border-inline-end:1px solid var(--color-border);padding-inline-end:30px}.topics article:nth-child(even){padding-inline-start:30px}.topics span{color:var(--color-accent);font-size:var(--text-xs);padding-top:5px}.topics h3{margin:0;font-size:var(--text-lg);line-height:1.7;font-weight:500}.publication-list{display:grid;gap:1px}.feature{background:var(--color-surface-muted)}.media{background:var(--color-bg)}.final{padding-block:64px 92px}.final-inner{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:clamp(32px,4vw,50px);background:var(--color-accent-soft)}.final-inner h2{font-size:var(--text-heading)}
@media(max-width:800px){.hero-grid,.two-col{grid-template-columns:1fr}.hero-image{justify-self:start;width:min(100%,390px)}.section-heading{align-items:flex-start;flex-direction:column}.topics{grid-template-columns:1fr}.topics article:nth-child(odd){border-inline-end:0;padding-inline-end:20px}.topics article:nth-child(even){padding-inline-start:0}.final-inner{align-items:flex-start;flex-direction:column}}@media(max-width:480px){.actions{align-items:flex-start;flex-direction:column}.button{width:100%}.hero-image{width:100%}}
</style>
