---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { podcast } from "../../lib/media";
import { site } from "../../lib/site";

const socialLinks = [
  { name: "Personal Instagram", handle: "@dr.leila.razavi_psy", description: "Professional psychology content and current activity.", url: person.profiles.instagram },
  { name: "Pendar Qom", handle: "@pendarqom", description: "Official Pendar presence and psychology-related activity in Qom.", url: person.profiles.pendarInstagram },
  { name: "Google Scholar", handle: "Leila Razavi", description: "Research profile and published academic work.", url: person.profiles.googleScholar },
];
---

<BaseLayout title={site.title.en} description="Official website of Dr. Leila Razavi, psychologist, university lecturer and researcher." canonical={`${site.url}/en/`} lang="en">
  <main>
    <section class="hero" aria-labelledby="hero-title"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Psychologist · University Lecturer · Researcher</p><h1 id="hero-title">Dr. Leila Razavi</h1><p class="hero-lead">A psychologist, university lecturer and researcher working across psychology, education, mental health and health-related quality of life.</p><p class="hero-note">This is the official website for understanding her professional path, research, published work and media activity.</p><div class="hero-actions"><a class="button button-primary" href="/en/about/">About Leila Razavi <span aria-hidden="true">→</span></a><a class="text-link" href="/en/publications/">All publications <span aria-hidden="true">→</span></a></div></div><figure class="hero-visual"><img src={person.image.src} alt={person.image.altEn} width="1018" height="1024" loading="eager" fetchpriority="high" decoding="async" /><figcaption>Leila Razavi · Psychology · Research · Education</figcaption></figure></div></section>
    <section class="intro" aria-labelledby="intro-title"><div class="container split"><div><p class="kicker">Introduction</p><h2 id="intro-title">A clear picture of the professional path.</h2></div><div class="copy"><p>Dr. Leila Razavi works at the intersection of psychology, university teaching and research. Her academic and professional work includes psychological interventions and questions around quality of life, pain, depression, fatigue and emotion regulation in health conditions.</p><p>The homepage keeps this introduction concise. Education, experience, affiliations and the fuller professional story belong to their dedicated pages, where they can be understood without repetition.</p><a class="text-link" href="/en/about/">Read the full profile <span aria-hidden="true">→</span></a></div></div></section>
    <section class="research" aria-labelledby="research-title"><div class="container split"><div><p class="kicker">Research</p><h2 id="research-title">What does the research focus on?</h2></div><div class="copy"><p>The research collection brings together verified published work addressing topics including acceptance and commitment therapy, mindfulness-based interventions, quality of life, pain, depression, fatigue and psychological experience in health conditions.</p><p>The individual papers, bibliographic details, authors and verification sources are kept on the publications pages rather than copied here. This keeps the homepage explanatory while the research section remains the complete source.</p><a class="button button-dark" href="/en/publications/">Explore all published work <span aria-hidden="true">→</span></a></div></div></section>
    <section class="professional" aria-labelledby="professional-title"><div class="container split"><div><p class="kicker">Professional activity</p><h2 id="professional-title">Professional history and collaborations.</h2></div><div class="copy"><p>Professional activity includes university work, organizational collaborations and the relationship with Pendar. These areas have their own pages so that each can be explained properly instead of being reduced to labels on the homepage.</p><div class="inline-links"><a class="text-link" href="/en/experience/">Professional activity <span aria-hidden="true">→</span></a><a class="text-link" href="/en/organizations/">Organizations <span aria-hidden="true">→</span></a></div></div></div></section>
    <section class="social" aria-labelledby="social-title"><div class="container"><div class="section-heading"><p class="kicker">Official presence</p><h2 id="social-title">Follow the official channels.</h2><p class="section-intro">These links lead directly to the official places for current psychology content, professional activity, Pendar updates and research.</p></div><div class="social-list">{socialLinks.map((link,index)=><a class="social-item" href={link.url} target="_blank" rel="noopener noreferrer"><span class="social-number">0{index+1}</span><span class="social-main"><strong>{link.name}</strong><span>{link.handle}</span><small>{link.description}</small></span><span class="social-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
    <section class="media" aria-labelledby="media-title"><div class="container split"><div><p class="kicker">Media</p><h2 id="media-title">{podcast.nameEn}</h2></div><div class="copy"><p>{podcast.descriptionEn}</p><p>Sohbat Jan brings the professional identity into conversations about human experience, psychology and everyday life.</p><div class="inline-links"><a class="button button-primary" href="/en/media/sohbat-jan/">Podcast page <span aria-hidden="true">→</span></a><a class="text-link" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Listen on Spotify <span aria-hidden="true">↗</span></a></div></div></div></section>
    <section class="closing" aria-labelledby="closing-title"><div class="container closing-inner"><div><p class="kicker">Continue</p><h2 id="closing-title">Every detailed subject has its own page.</h2></div><nav class="closing-links" aria-label="Main links"><a href="/en/about/">About</a><a href="/en/publications/">Publications</a><a href="/en/cv/">CV</a><a href="/en/contact/">Profiles & contact</a></nav></div></section>
  </main>
</BaseLayout>

<style>
.hero{padding-block:clamp(64px,9vw,112px) clamp(72px,10vw,120px);background:var(--color-bg)}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.72fr);gap:clamp(44px,8vw,120px);align-items:center}.hero-copy{max-width:700px}.eyebrow,.kicker{margin:0 0 16px;color:var(--color-accent-strong);font-size:var(--text-xs);font-weight:700}.hero h1,.intro h2,.research h2,.professional h2,.media h2,.closing h2{font-family:var(--font-heading);font-weight:600;letter-spacing:-.03em;line-height:1.3}.hero h1{margin:0;font-size:clamp(3.7rem,8vw,7.2rem);line-height:1}.hero-lead{max-width:680px;margin:30px 0 14px;font-size:clamp(1.15rem,1.8vw,1.4rem);line-height:1.95}.hero-note,.copy p,.section-intro{color:var(--color-ink-muted);line-height:1.95}.hero-note{max-width:620px;margin:0}.hero-actions,.inline-links{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:28px}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:12px 22px;text-decoration:none;font-size:var(--text-sm);font-weight:700}.button-primary{background:var(--color-accent);color:var(--color-surface)}.button-dark{background:var(--color-ink);color:var(--color-surface)}.text-link{color:var(--color-accent-strong);text-decoration:none;font-size:var(--text-sm);font-weight:700}.text-link:hover{text-decoration:underline;text-underline-offset:5px}.hero-visual{margin:0}.hero-visual img{display:block;width:100%;aspect-ratio:1/1.08;object-fit:cover}.hero-visual figcaption{padding-top:12px;color:var(--color-ink-subtle);font-size:.68rem;letter-spacing:.04em}.intro,.research,.professional,.social,.media,.closing{padding-block:clamp(72px,9vw,112px);border-top:1px solid var(--color-border)}.split{display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.2fr);gap:clamp(40px,9vw,130px);align-items:start}.intro h2,.research h2,.professional h2,.media h2,.closing h2{margin:0;font-size:clamp(2rem,3.7vw,3.4rem)}.copy{max-width:760px}.copy p{margin:0 0 16px;font-size:var(--text-lg)}.section-heading{margin-bottom:34px}.section-heading h2{margin:0;font-size:clamp(2rem,3.7vw,3.4rem)}.section-intro{max-width:760px;margin:14px 0 0;font-size:var(--text-base)}.professional{background:var(--color-surface-muted)}.social-list{border-top:1px solid var(--color-border)}.social-item{display:grid;grid-template-columns:50px 1fr 24px;align-items:center;gap:24px;padding:22px 0;border-bottom:1px solid var(--color-border);color:var(--color-ink);text-decoration:none}.social-item:hover{padding-inline:12px;background:var(--color-surface-muted)}.social-number{color:var(--color-accent);font-size:var(--text-xs)}.social-main{display:grid;grid-template-columns:minmax(160px,.35fr) minmax(150px,.3fr) 1fr;gap:18px;align-items:center}.social-main strong{font-size:1.05rem}.social-main span{direction:ltr;color:var(--color-accent-strong)}.social-main small{color:var(--color-ink-muted);font-size:var(--text-sm);line-height:1.7}.social-arrow{color:var(--color-ink-subtle)}.media{background:var(--color-bg)}.closing{background:var(--color-surface)}.closing-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.65fr);gap:60px;align-items:end}.closing-links{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--color-border)}.closing-links a{padding:15px 0;border-bottom:1px solid var(--color-border);color:var(--color-ink);text-decoration:none;font-weight:600}.closing-links a:hover{color:var(--color-accent-strong)}
@media(max-width:820px){.hero-grid,.split,.closing-inner{grid-template-columns:1fr}.hero-visual{width:min(100%,520px)}.social-main{grid-template-columns:1fr;gap:4px}.social-item{grid-template-columns:36px 1fr 18px}}@media(max-width:520px){.hero h1{font-size:clamp(3rem,15vw,4.5rem)}.hero-actions,.inline-links{align-items:stretch;flex-direction:column}.button{width:100%}.closing-links{grid-template-columns:1fr}}
</style>
