---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { site } from "../../../lib/site";
---
<BaseLayout title={`Research | ${site.name}`} description="This route has been consolidated into the About page." canonical={`${site.url}/en/about/`} lang="en" noindex>
  <section class="moved"><div class="container"><p>This section has been consolidated into the About page.</p><h1>Research</h1><p>Research directions and related context now live in the About page, while the complete scholarly record is maintained only on Publications.</p><a href="/en/about/">Go to About →</a></div></section>
</BaseLayout>
<script>window.location.replace("/en/about/#research");</script>
<style>.moved{padding-block:120px}.moved .container{max-width:760px}.moved p{color:#666;line-height:2}.moved h1{font-size:clamp(2.5rem,6vw,4rem);font-weight:500}.moved a{color:#806f61;font-weight:600}</style>
