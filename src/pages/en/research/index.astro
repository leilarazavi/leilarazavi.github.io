---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { person } from "../../../lib/person";
import { site } from "../../../lib/site";
---
<BaseLayout title={`Research | ${site.name}`} description="Research areas and documented research directions associated with Dr. Leila Razavi." canonical={`${site.url}/en/research/`} lang="en">
  <section class="page"><div class="container">
    <header><p class="label">Research</p><h1>Research areas</h1><p class="lead">This page focuses on research directions. The complete publication record is intentionally kept on the separate Publications page to avoid duplicating the same academic records.</p></header>
    <section class="research-block"><h2>Research interests</h2><div class="topics">{person.research.researchInterests.map((topic) => <article><h3>{topic}</h3></article>)}</div></section>
    <section class="research-block"><h2>Research direction</h2><p class="body-copy">The documented research record covers psychological interventions, mental health, emotion regulation, and quality of life in health-related contexts. Only areas supported by the site's documented sources are presented here.</p></section>
    <section class="research-cta"><div><p class="label">Publications</p><h2>Complete scholarly record</h2></div><a href="/en/publications/">View publications <span aria-hidden="true">→</span></a></section>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:65px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead,.body-copy{color:#555;line-height:2;font-size:1.05rem}.research-block{padding-top:60px;border-top:1px solid #ddd7d0}.research-block h2{font-size:1.8rem;font-weight:500}.topics{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#ddd7d0;border:1px solid #ddd7d0}.topics article{padding:30px;background:#faf9f7;min-height:100px}.topics h3{margin:0;font-size:1rem;font-weight:500;line-height:1.8}.research-cta{display:flex;align-items:center;justify-content:space-between;gap:30px;margin-top:70px;padding:40px;background:#eee9e4}.research-cta h2{margin:0;font-size:1.7rem;font-weight:500}.research-cta a{color:#806f61;font-weight:600;text-decoration:none}@media(max-width:700px){.topics{grid-template-columns:1fr}.research-cta{align-items:flex-start;flex-direction:column}}
</style>
