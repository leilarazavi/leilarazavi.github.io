---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublicationsByYear } from "../../../lib/publications";
import { site } from "../../../lib/site";

const publications = getPublicationsByYear();
---
<BaseLayout title={`Publications | ${site.name}`} description="Verified publications and research works by Dr. Leila Razavi." canonical={`${site.url}/en/publications/`} lang="en">
  <section class="page"><div class="container">
    <header><p class="label">Research</p><h1>Publications</h1><p class="lead">Verified scientific and research works associated with Dr. Leila Razavi.</p></header>
    <div class="list">{publications.map((publication) => <article><p>{publication.year ?? ""}{publication.year && publication.journal ? ` · ${publication.journal}` : ""}</p><h2><a href={`/publications/${publication.id}/`}>{publication.title}</a></h2><p>{publication.authors.join(", ")}</p></article>)}</div>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:60px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{font-size:clamp(2.5rem,6vw,4.5rem);font-weight:500}.lead{color:#555;line-height:2}.list article{padding:30px 0;border-top:1px solid #ddd7d0}.list article p{color:#666;line-height:1.8}.list article p:first-child{color:#806f61;font-size:.8rem}.list h2{font-size:1.25rem;line-height:1.6}.list a{color:#222;text-decoration:none}.list a:hover{color:#806f61}
</style>