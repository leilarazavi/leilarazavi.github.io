---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PublicationCard from "../../../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { site } from "../../../lib/site";

const entries = await getCollection("publications", ({ data }) => data.verified);
const publications = entries.sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const years = [...new Set(publications.map(({ data }) => data.year).filter((year): year is number => year !== undefined))];
---

<BaseLayout title={`Publications | ${site.name}`} description="Verified publications and scholarly works by Dr. Leila Razavi, with DOI and verification sources." canonical={`${site.url}/en/publications/`} lang="en">
  <section class="page"><div class="container">
    <header><p class="label">Publications</p><h1>Research and scholarly work</h1><p class="lead">Verified articles, conference papers, and books, organized by type and year.</p></header>
    <div class="filters">
      <label>Type<select id="type-filter"><option value="all">All</option><option value="journal-article">Articles</option><option value="conference-paper">Conference</option><option value="book">Books</option></select></label>
      <label>Year<select id="year-filter"><option value="all">All years</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
    </div>
    <div id="publication-list">{publications.map((publication) => <article class="publication-entry" data-type={publication.data.type} data-year={publication.data.year ?? "unknown"}><PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal ?? publication.data.publisher} url={`/en/publications/${publication.id}/`} /></article>)}</div>
    <p id="empty-results" hidden>No publications match these filters.</p>
  </div></section>
</BaseLayout>
<script>
  const typeFilter = document.querySelector<HTMLSelectElement>("#type-filter");
  const yearFilter = document.querySelector<HTMLSelectElement>("#year-filter");
  const entries = [...document.querySelectorAll<HTMLElement>(".publication-entry")];
  const empty = document.querySelector<HTMLElement>("#empty-results");
  function applyFilters() { const type = typeFilter?.value ?? "all"; const year = yearFilter?.value ?? "all"; let visible = 0; entries.forEach((entry) => { const show = (type === "all" || entry.dataset.type === type) && (year === "all" || entry.dataset.year === year); entry.hidden = !show; if (show) visible += 1; }); if (empty) empty.hidden = visible !== 0; }
  typeFilter?.addEventListener("change", applyFilters); yearFilter?.addEventListener("change", applyFilters);
</script>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:50px}.label{margin:0 0 14px;color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead{color:#555;line-height:2}.filters{display:flex;flex-wrap:wrap;gap:16px;padding:20px 0;margin-bottom:15px;border-block:1px solid #ddd7d0}.filters label{display:grid;gap:6px;color:#806f61;font-size:.78rem;font-weight:600}.filters select{min-width:150px;padding:10px;border:1px solid #ddd7d0;background:#faf9f7;color:#333;font:inherit}.publication-entry[hidden]{display:none}#empty-results{color:#777}
</style>
