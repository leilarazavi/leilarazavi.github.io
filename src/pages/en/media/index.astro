---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { person } from "../../../lib/person";
import { podcast, professionalMedia } from "../../../lib/media";
import { site } from "../../../lib/site";
---
<BaseLayout title={`Media and Public Presence | ${site.name}`} description="Sohbat Jan podcast, professional conversations and public sources related to Dr. Leila Razavi." canonical={`${site.url}/en/media/`} lang="en">
<section class="page"><div class="container"><header><p class="label">Media and public presence</p><h1>Podcast, conversations and public activity</h1><p class="lead">Media and public references are kept separate from scholarly publications and professional experience, with direct links to their original sources.</p></header><section class="featured"><p class="category">Podcast</p><h2>{podcast.nameEn}</h2><p>{podcast.descriptionEn}</p><div class="links"><a href="/en/media/sohbat-jan/">Podcast page →</a><a href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify →</a></div></section><section><h2>Episodes</h2><div class="media-list">{podcast.episodes.map((episode)=><article><p class="category">Episode {episode.number}</p><h3><a href={`/en/media/sohbat-jan/${episode.slug}/`}>{episode.titleEn}</a></h3><p>{episode.descriptionEn}</p><a href={episode.spotifyUrl} target="_blank" rel="noopener noreferrer">Listen on Spotify →</a></article>)}</div></section><section><h2>Professional activity and public sources</h2><div class="media-list">{professionalMedia.map((item)=><article><p class="category">{item.categoryEn}</p><h3>{item.titleEn}</h3><p>{item.descriptionEn}</p><a href={item.url} target="_blank" rel="noopener noreferrer">View original source →</a></article>)}</div></section><section><h2>Professional identity sources</h2><p>Key professional profiles are also connected in the site's person entity to reduce ambiguity with other people who share the same name.</p><div class="links"><a href={person.profiles.googleScholar} target="_blank" rel="noopener noreferrer">Google Scholar →</a><a href={person.profiles.instagram} target="_blank" rel="noopener noreferrer">Instagram →</a><a href={person.profiles.pendar} target="_blank" rel="noopener noreferrer">Pendar profile →</a></div></section></div></section>
</BaseLayout>
<style>
.page{padding-block:90px}.container{max-width:900px}header{max-width:820px;padding-bottom:55px}.label,.category{color:#806f61;font-size:.8rem;font-weight:600}.label{margin-bottom:12px}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.3;font-weight:500}.lead,p{color:#555;line-height:2}.featured,section:not(:first-child){padding:42px 0;border-top:1px solid #ddd7d0}.featured h2,section>h2{font-size:2rem;font-weight:500}.media-list article{padding:30px 0;border-top:1px solid #e4dfda}.media-list h3{font-size:1.4rem;font-weight:500}.media-list h3 a{color:#222;text-decoration:none}.media-list a,.links a{color:#806f61;font-weight:600}.links{display:flex;flex-wrap:wrap;gap:22px;margin-top:24px}
</style>
