---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { podcast } from "../../../../lib/media";
import { site } from "../../../../lib/site";
import { getBreadcrumbSchema, getPodcastSeriesSchema } from "../../../../lib/schema";

const url = `${site.url}/en/media/sohbat-jan/`;
const episodeUrls = podcast.episodes.map((episode) => `${url}${episode.slug}/`);
const schemas = [getPodcastSeriesSchema({ name: podcast.nameEn, description: podcast.descriptionEn, url, spotifyUrl: podcast.spotifyUrl, episodeUrls, language: "en" }), getBreadcrumbSchema([{ name: "Home", url: `${site.url}/en/` }, { name: "Media", url: `${site.url}/en/media/` }, { name: podcast.nameEn, url }])];
---

<BaseLayout title={`Sohbat Jan Podcast | ${site.name}`} description="Sohbat Jan, a podcast connected to Dr. Leila Razavi, featuring conversations about psychology, relationships and human experience." canonical={url} lang="en">
  <section class="podcast-page" aria-labelledby="podcast-title"><div class="container">
    <header class="podcast-hero"><div><p class="eyebrow">01 · Podcast</p><h1 id="podcast-title">{podcast.nameEn}</h1><p class="lead">A public conversation space exploring psychology, relationships and human experience, with episode information presented alongside the professional profile.</p><a class="button" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Listen on Spotify ↗</a></div><div class="podcast-mark"><span>SOHBAT</span><strong>JAN</strong><small>Psychology · Relationships · Human Experience</small></div></header>
    <section class="intro" aria-labelledby="about-title"><p class="section-label">About the podcast</p><h2 id="about-title">A public-facing extension of the professional and educational work</h2><p>{podcast.descriptionEn}</p></section>
    <section class="episodes" aria-labelledby="episodes-title"><div class="section-head"><div><p class="section-label">Episodes</p><h2 id="episodes-title">Conversations and topics</h2></div><span class="section-index">02</span></div><div class="episode-list">{podcast.episodes.map((episode)=><article class="episode"><span class="episode-number">{String(episode.number).padStart(2,"0")}</span><div><h3><a href={`/en/media/sohbat-jan/${episode.slug}/`}>{episode.titleEn}</a></h3><p>{episode.descriptionEn}</p><a class="detail" href={`/en/media/sohbat-jan/${episode.slug}/`}>Episode details →</a></div></article>)}</div></section>
    <section class="related"><div><p class="section-label">Related</p><h2>Explore the professional profile and research record</h2></div><div class="related-links"><a href="/en/about/">About Dr. Leila Razavi →</a><a href="/en/publications/">Research & publications →</a></div></section>
  </div></section>
</BaseLayout>

<style>
.podcast-page{padding-block:clamp(64px,8vw,104px)}.podcast-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);gap:clamp(44px,8vw,110px);align-items:center;padding-bottom:clamp(58px,7vw,88px);border-bottom:1px solid var(--color-border)}.eyebrow,.section-label{margin:0 0 var(--space-3);color:var(--color-accent);font-size:var(--text-xs);font-weight:700;letter-spacing:.05em}.podcast-hero h1{margin:0 0 22px;font-size:var(--text-display);line-height:1.05;font-weight:500;letter-spacing:-.04em}.lead{max-width:720px;margin:0 0 30px;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.button{display:inline-flex;min-height:48px;align-items:center;padding-inline:22px;background:var(--color-accent);color:var(--color-surface);text-decoration:none;font-size:var(--text-sm);font-weight:700}.podcast-mark{min-height:320px;display:flex;flex-direction:column;justify-content:space-between;padding:28px;background:var(--color-accent-soft);color:var(--color-accent-strong)}.podcast-mark span{font-size:var(--text-xs);letter-spacing:.16em}.podcast-mark strong{font-size:clamp(4rem,7vw,6rem);line-height:.85;font-weight:500;letter-spacing:-.06em}.podcast-mark small{font-size:var(--text-xs);line-height:1.7}.intro{max-width:820px;padding-block:clamp(64px,8vw,96px);border-bottom:1px solid var(--color-border)}.intro h2,.section-head h2,.related h2{margin:0;font-size:var(--text-title);font-weight:500;line-height:1.35}.intro>p:last-child{margin:20px 0 0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.episodes{padding-block:clamp(64px,8vw,96px);border-bottom:1px solid var(--color-border)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px}.section-index{color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.episode-list{border-top:1px solid var(--color-border)}.episode{display:grid;grid-template-columns:54px minmax(0,1fr);gap:22px;padding-block:27px;border-bottom:1px solid var(--color-border)}.episode-number{color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.episode h3{margin:0 0 8px;font-size:var(--text-lg);font-weight:600}.episode h3 a{color:var(--color-ink);text-decoration:none}.episode p{max-width:760px;margin:0 0 10px;color:var(--color-ink-muted);font-size:var(--text-sm);line-height:1.9}.detail{color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:600;text-decoration:none}.detail:hover{text-decoration:underline;text-underline-offset:5px}.related{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:center;padding-block:clamp(64px,8vw,96px)}.related-links{display:flex;flex-direction:column;gap:12px}.related-links a{color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:600;text-decoration:none}.related-links a:hover{text-decoration:underline;text-underline-offset:5px}@media(max-width:720px){.podcast-hero,.related{grid-template-columns:1fr}.podcast-mark{max-width:420px}.section-head{align-items:flex-start}.episode{grid-template-columns:40px 1fr}}
</style>
