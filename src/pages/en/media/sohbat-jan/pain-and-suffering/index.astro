---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { podcast } from "../../../../../lib/media";
import { site } from "../../../../../lib/site";
import { getBreadcrumbSchema, getPodcastEpisodeSchema } from "../../../../../lib/schema";
const episode = podcast.episodes[0];
const url = `${site.url}/en/media/sohbat-jan/${episode.slug}/`;
const seriesUrl = `${site.url}/en/media/sohbat-jan/`;
const description = "Suffering is a shared human experience. This episode explores the distinction between pain and suffering, acceptance, meaning in hardship, and how persistent resistance to difficult emotions can keep them present.";
const schemas = [getPodcastEpisodeSchema({ name: episode.titleEn, description, url, spotifyUrl: episode.spotifyUrl, episodeNumber: episode.number, seriesUrl, language: "en" }), getBreadcrumbSchema([{ name: "Home", url: `${site.url}/en/` }, { name: "Media", url: `${site.url}/en/media/` }, { name: podcast.nameEn, url: seriesUrl }, { name: `Episode ${episode.number}`, url }])];
---

<BaseLayout title={`${episode.titleEn} | Sohbat Jan | ${site.name}`} description="Episode one of Sohbat Jan on pain and suffering, acceptance, meaning and responding to difficult experiences." canonical={url} lang="en" type="article" schemas={schemas}>
  <article class="page"><div class="container">
    <header class="hero"><p class="eyebrow">01 · Sohbat Jan · Episode {episode.number}</p><h1>{episode.titleEn}</h1><p class="lead">Suffering is a shared human experience. What changes the quality of life is not only what happens to us, but also how we respond to it.</p><div class="actions"><a class="button" href={episode.spotifyUrl} target="_blank" rel="noopener noreferrer">Listen on Spotify ↗</a><a class="text-link" href={seriesUrl}>Podcast page →</a></div></header>
    <section><p class="section-label">About this episode</p><h2>From pain and suffering to acceptance and meaning</h2><p>{description}</p></section>
    <section><p class="section-label">Topics</p><h2>What the episode explores</h2><p>The conversation considers pain and suffering, acceptance, meaning in hardship, difficult emotions, and the ways people respond when an unwanted experience becomes persistent.</p></section>
    <section class="note"><p class="section-label">Important note</p><h2>Educational content, not a substitute for treatment</h2><p>This episode is intended for psychological awareness and is not a substitute for psychotherapy or professional intervention. Experiences of suffering can have different causes and dimensions for different people and should not be reduced to a single pattern.</p></section>
    <section class="related"><p class="section-label">Related</p><p>This episode is part of <a href={seriesUrl}>Sohbat Jan</a>, a podcast connected to Dr. Leila Razavi. <a href="/en/about/">Explore the professional profile →</a></p></section>
  </div></article>
</BaseLayout>

<style>
.page{padding-block:clamp(64px,8vw,104px)}.container{max-width:900px}.hero{padding-bottom:clamp(58px,7vw,88px);border-bottom:1px solid var(--color-border)}.eyebrow,.section-label{margin:0 0 var(--space-3);color:var(--color-accent);font-size:var(--text-xs);font-weight:700;letter-spacing:.05em}.hero h1{max-width:850px;margin:0 0 24px;font-size:var(--text-display);line-height:1.08;font-weight:500;letter-spacing:-.04em}.lead{max-width:780px;margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2.05}.actions{display:flex;flex-wrap:wrap;gap:18px;margin-top:32px}.button{display:inline-flex;min-height:48px;align-items:center;padding-inline:22px;background:var(--color-accent);color:var(--color-surface);text-decoration:none;font-size:var(--text-sm);font-weight:700}.text-link{color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:600;text-decoration:none;align-self:center}.text-link:hover{text-decoration:underline;text-underline-offset:5px}section:not(.hero){padding-block:clamp(54px,7vw,78px);border-bottom:1px solid var(--color-border)}section h2{margin:0 0 18px;font-size:var(--text-title);font-weight:500;line-height:1.4}section p:not(.section-label){max-width:760px;color:var(--color-ink-muted);line-height:2}.note{padding-inline:28px;background:var(--color-surface-muted)}.related{border-bottom:0!important}.related a{color:var(--color-accent-strong);font-weight:600}@media(max-width:600px){.actions{align-items:flex-start;flex-direction:column}.button{width:100%}.text-link{align-self:flex-start}}
</style>
