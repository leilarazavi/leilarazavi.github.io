---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { person } from "../../../lib/person";
import { site } from "../../../lib/site";
---
<BaseLayout title={`Profiles and Contact | ${site.name}`} description="Public academic and professional profiles for Dr. Leila Razavi." canonical={`${site.url}/en/contact/`} lang="en">
  <section class="page"><div class="container">
    <header><p class="label">Profiles</p><h1>Academic and professional profiles</h1><p class="lead">Use the public profiles below for additional information about Dr. Leila Razavi.</p></header>
    <div class="links">
      {person.profiles.googleScholar && <a href={person.profiles.googleScholar} target="_blank" rel="noopener noreferrer"><strong>Google Scholar</strong><span>Research profile and publications</span></a>}
      {person.profiles.instagram && <a href={person.profiles.instagram} target="_blank" rel="noopener noreferrer"><strong>Instagram</strong><span>Public profile</span></a>}
      {person.profiles.pendar && <a href={person.profiles.pendar} target="_blank" rel="noopener noreferrer"><strong>Pendar</strong><span>Professional profile</span></a>}
    </div>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:60px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{font-size:clamp(2.5rem,6vw,4.5rem);font-weight:500}.lead{color:#555;line-height:2}.links{display:grid;max-width:820px}.links a{display:flex;flex-direction:column;gap:6px;padding:24px 0;border-top:1px solid #ddd7d0;color:#222;text-decoration:none}.links a:hover{color:#806f61}.links strong{font-size:1.05rem}.links span{color:#777;font-size:.9rem}
</style>