---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { person } from "../../../lib/person";
import { site } from "../../../lib/site";
---

<BaseLayout title={`Profiles and Contact | ${site.name}`} description="Public academic and professional profiles for Dr. Leila Razavi." canonical={`${site.url}/en/contact/`} lang="en">
  <section class="page" aria-labelledby="contact-title"><div class="container">
    <header class="page-header"><p class="eyebrow">01 · Official resources</p><h1 id="contact-title">Academic and professional profiles</h1><p class="lead">This page brings the official public channels together in one place. Each route serves a different purpose—from scholarly identity and professional information to public-facing psychology content and organizational contact.</p></header>
    <section class="resources" aria-labelledby="resources-title"><div class="section-head"><div><p class="section-label">Choose a route</p><h2 id="resources-title">Public profiles and channels</h2></div><span class="section-index">02</span></div><div class="resource-list">
      {person.profiles.googleScholar && <a class="resource" href={person.profiles.googleScholar} target="_blank" rel="noopener noreferrer"><span class="resource-number">01</span><div><strong>Google Scholar</strong><p>Academic identity and publication record, useful for finding the documented scholarly output and citation profile.</p><span>Open academic profile ↗</span></div></a>}
      {person.profiles.instagram && <a class="resource" href={person.profiles.instagram} target="_blank" rel="noopener noreferrer"><span class="resource-number">02</span><div><strong>Instagram — Dr. Leila Razavi</strong><p>A public-facing professional channel for psychology-related communication, educational content and selected aspects of professional activity.</p><span>Open professional Instagram ↗</span></div></a>}
      {person.profiles.pendar && <a class="resource" href={person.profiles.pendar} target="_blank" rel="noopener noreferrer"><span class="resource-number">03</span><div><strong>Pendar — professional profile</strong><p>An organizational profile providing professional context and a direct route to information connected with Pendar Nimrokh in Qom.</p><span>Open professional profile ↗</span></div></a>}
      {person.profiles.pendarInstagram && <a class="resource" href={person.profiles.pendarInstagram} target="_blank" rel="noopener noreferrer"><span class="resource-number">04</span><div><strong>Pendar — Instagram</strong><p>The public social channel of Pendar, useful for following the organization's public communication, activities and announcements.</p><span>Open Pendar Instagram ↗</span></div></a>}
      {person.profiles.podcast && <a class="resource" href={person.profiles.podcast} target="_blank" rel="noopener noreferrer"><span class="resource-number">05</span><div><strong>Sohbat Jan — Spotify</strong><p>The podcast distribution channel for conversations around psychology, relationships and human experience, with episode-level information available on this website.</p><span>Open podcast on Spotify ↗</span></div></a>}
    </div></section>
    <section class="contact-note"><div><p class="section-label">Professional contact</p><h2>For organizational contact, use the published Pendar channel.</h2><p>The phone number below is presented as a Pendar contact route rather than as a private personal number.</p></div>{person.contact.pendarPhone && <a class="phone" href={`tel:${person.contact.pendarPhone}`}><span>Published contact</span><strong dir="ltr">{person.contact.pendarPhone}</strong></a>}</section>
  </div></section>
</BaseLayout>

<style>
.page{padding-block:clamp(64px,8vw,104px)}.page-header{max-width:840px;padding-bottom:clamp(58px,7vw,86px);border-bottom:1px solid var(--color-border)}.eyebrow,.section-label{margin:0 0 var(--space-3);color:var(--color-accent);font-size:var(--text-xs);font-weight:700;letter-spacing:.05em}.page-header h1{margin:0 0 22px;font-size:var(--text-display);line-height:1.08;font-weight:500;letter-spacing:-.04em}.lead{max-width:760px;margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.resources{padding-block:clamp(64px,8vw,96px);border-bottom:1px solid var(--color-border)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px}.section-head h2,.contact-note h2{margin:0;font-size:var(--text-title);font-weight:500}.section-index{color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.resource-list{border-top:1px solid var(--color-border)}.resource{display:grid;grid-template-columns:50px minmax(0,1fr);gap:20px;padding-block:28px;border-bottom:1px solid var(--color-border);color:var(--color-ink);text-decoration:none}.resource:hover{background:var(--color-surface-muted)}.resource-number{color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.resource strong{font-size:var(--text-lg);font-weight:600}.resource p{max-width:760px;margin:7px 0 10px;color:var(--color-ink-muted);font-size:var(--text-sm);line-height:1.9}.resource span:last-child{color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:600}.contact-note{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:center;padding-block:clamp(64px,8vw,96px)}.contact-note p:not(.section-label){max-width:700px;color:var(--color-ink-muted);line-height:2}.phone{display:flex;flex-direction:column;gap:7px;min-width:220px;padding:20px;border:1px solid var(--color-border);background:var(--color-surface-muted);text-decoration:none}.phone span{color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.phone strong{color:var(--color-ink);font-size:var(--text-lg)}@media(max-width:700px){.section-head{align-items:flex-start}.contact-note{grid-template-columns:1fr}.resource{grid-template-columns:36px 1fr}}
</style>
