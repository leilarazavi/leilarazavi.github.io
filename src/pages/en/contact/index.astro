---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { person } from "../../../lib/person";
import { site } from "../../../lib/site";
---
<BaseLayout title={`Profiles and Contact | ${site.name}`} description="Public academic and professional profiles for Dr. Leila Razavi." canonical={`${site.url}/en/contact/`} lang="en">
  <!-- Contact is an official-profile hub, not a generic lead form; this keeps the personal-brand entity graph explicit. -->
  <section class="page"><div class="container"><header><p class="label">Profiles and contact</p><h1>Academic and professional profiles</h1><p class="lead">For professional contact, use the public academic and organizational channels below. The published phone number is the contact number for Pendar.</p></header><div class="links">
    {person.profiles.googleScholar && <a href={person.profiles.googleScholar} target="_blank" rel="noopener noreferrer"><strong>Google Scholar</strong><span>Research profile and publications</span></a>}
    {person.profiles.instagram && <a href={person.profiles.instagram} target="_blank" rel="noopener noreferrer"><strong>Instagram — Dr. Leila Razavi</strong><span>Public professional presence</span></a>}
    {person.profiles.pendar && <a href={person.profiles.pendar} target="_blank" rel="noopener noreferrer"><strong>Pendar — professional profile</strong><span>Professional and organizational contact route</span></a>}
    {person.profiles.pendarInstagram && <a href={person.profiles.pendarInstagram} target="_blank" rel="noopener noreferrer"><strong>Pendar — Instagram</strong><span>Official Pendar account</span></a>}
    {person.contact.pendarPhone && <a href={`tel:${person.contact.pendarPhone}`}><strong>Pendar phone</strong><span dir="ltr">{person.contact.pendarPhone}</span></a>}
  </div></div></section>
</BaseLayout>
<style>
.page{padding-block:var(--space-9)}header{max-width:820px;padding-bottom:var(--space-8)}.label{margin:0 0 var(--space-3);color:var(--color-accent);font-size:var(--text-xs);font-weight:700}h1{margin:0 0 var(--space-5);font-size:var(--text-display);line-height:1.15;font-weight:500;letter-spacing:-.04em}.lead{max-width:var(--reading-width);color:var(--color-ink-muted);font-size:var(--text-lg);line-height:var(--leading-relaxed)}.links{display:grid;max-width:820px}.links a{display:flex;flex-direction:column;gap:6px;padding:24px 0;border-top:1px solid var(--color-border);color:var(--color-ink);text-decoration:none}.links a:hover{color:var(--color-accent)}.links strong{font-size:var(--text-lg)}.links span{color:var(--color-ink-subtle);font-size:var(--text-sm)}
</style>
