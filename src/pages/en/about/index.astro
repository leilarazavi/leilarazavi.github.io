---
import PublicationCard from "../../../components/PublicationCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getProfilePageSchema, getBreadcrumbSchema } from "../../../lib/schema";
import { site } from "../../../lib/site";
import { person } from "../../../lib/person";

const publications = (await getCollection("publications", ({ data }) => data.verified)).sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const profileSchema = { ...getProfilePageSchema({ url: `${site.url}/en/about/`, name: site.title.en, language: "en" }), image: new URL(person.image.src, site.url).toString() };
const breadcrumbSchema = getBreadcrumbSchema([{ name: "Home", url: `${site.url}/en/` }, { name: "About Dr. Leila Razavi", url: `${site.url}/en/about/` }]);
---

<BaseLayout title="Dr. Leila Razavi | Psychologist, University Lecturer and Researcher" description="Professional profile of Dr. Leila Razavi, including research areas, verified publications and documented professional activities." canonical={`${site.url}/en/about/`} lang="en" schemas={[profileSchema, breadcrumbSchema]}>
  <article class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="container about-hero-grid">
        <div class="about-copy">
          <p class="eyebrow">01 · Psychologist · University Lecturer · Researcher</p>
          <h1 id="about-title">Dr. Leila Razavi</h1>
          <p class="about-role">Psychologist · University Lecturer · Researcher</p>
          <p class="about-lead">A professional profile bringing together psychology, research and education, with the public record organized around documented professional activity and verified scholarly work.</p>
        </div>
        <figure class="about-portrait">
          <img src={person.image.src} alt={person.image.altEn} width="1018" height="1024" loading="eager" decoding="async" />
          <figcaption>Leila Razavi · Psychology · Research · Education</figcaption>
        </figure>
      </div>
    </section>

    <section class="identity" aria-labelledby="identity-title">
      <div class="container identity-grid">
        <div class="section-index">02</div>
        <div>
          <p class="section-label">Professional identity</p>
          <h2 id="identity-title">Psychology, research and education in one professional profile</h2>
        </div>
        <div class="identity-copy">
          <p>{person.description.en}</p>
          <p>This page provides the narrative layer of the professional profile: it explains the areas of work, documented roles and selected academic evidence without duplicating the full CV or publication catalogue.</p>
        </div>
      </div>
    </section>

    <section class="expertise" id="research" aria-labelledby="expertise-title">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="section-label">Areas of expertise</p>
            <h2 id="expertise-title">Professional and research focus</h2>
          </div>
          <span class="section-index">03</span>
        </div>
        <div class="expertise-list">
          {person.knowsAbout.map((topic, index) => (
            <article class="expertise-row">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{topic}</h3>
                <p>One of the documented areas associated with the professional and scholarly profile; detailed evidence is maintained across the relevant research, publication and professional pages.</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="positions" aria-labelledby="positions-title">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="section-label">Professional trajectory</p>
            <h2 id="positions-title">Documented roles and activities</h2>
          </div>
          <a class="quiet-link" href="/en/experience/">Full professional activity →</a>
        </div>
        <div class="timeline">
          {person.positions.map((position) => (
            <article class="timeline-item">
              <div>
                <h3>{position.titleEn}</h3>
                <p>{position.organizationEn}</p>
              </div>
              <div>
                <p class="timeline-description">A documented professional role included in the site's evidence model, with the original public source retained for verification.</p>
                <a class="quiet-link" href={position.source} target="_blank" rel="noopener noreferrer">View public source ↗</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="selected-work" aria-labelledby="selected-work-title">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="section-label">Scholarly evidence</p>
            <h2 id="selected-work-title">Selected publications</h2>
          </div>
          <a class="quiet-link" href="/en/publications/">View all publications →</a>
        </div>
        <p class="section-intro">A selection of verified publications is presented here as evidence of the research record. Each item can be opened for its bibliographic details and source information.</p>
        <div class="publication-list">
          {publications.slice(0, 3).map((publication) => (
            <PublicationCard
              title={publication.data.title}
              titleFa={publication.data.titleFa}
              authors={publication.data.authors}
              year={publication.data.year}
              journal={publication.data.journal ?? publication.data.publisher}
              url={`/en/publications/${publication.id}/`}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="credentials" aria-labelledby="credentials-title">
      <div class="container credentials-grid">
        <div>
          <p class="section-label">Professional credentials</p>
          <h2 id="credentials-title">Professional and public identity sources</h2>
        </div>
        <div class="credential-list">
          <div><strong>Professional organization</strong><span>Iranian Psychology and Counseling Organization</span></div>
          <div><strong>Affiliations</strong>{person.affiliations.map((affiliation) => <a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name} ↗</a>)}</div>
          <div><strong>Public profiles</strong>{Object.entries(person.profiles).map(([label, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a>)}</div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-page{overflow:clip}.about-hero{padding-block:clamp(64px,8vw,100px);border-bottom:1px solid var(--color-border)}.about-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.62fr);gap:clamp(48px,8vw,110px);align-items:center}.about-copy{max-width:760px}.about-copy h1{margin:0;font-size:var(--text-display);line-height:1.05;font-weight:500;letter-spacing:-.045em}.about-role{margin:18px 0 0;color:var(--color-accent-strong);font-size:var(--text-lg);font-weight:600}.about-lead{max-width:700px;margin:28px 0 0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.about-portrait{margin:0}.about-portrait img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover}.about-portrait figcaption{padding-top:12px;color:var(--color-ink-muted);font-size:var(--text-xs);letter-spacing:.04em}.identity,.expertise,.positions,.selected-work,.credentials{padding-block:clamp(70px,9vw,108px);border-bottom:1px solid var(--color-border)}.identity-grid,.credentials-grid{display:grid;grid-template-columns:54px minmax(260px,.9fr) minmax(0,1.1fr);gap:clamp(28px,5vw,70px)}.identity h2,.section-topline h2,.credentials h2{margin:0;max-width:700px;font-size:var(--text-title);line-height:1.35;font-weight:500}.identity-copy{color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.identity-copy p{margin:0 0 22px}.identity-copy p:last-child{margin-bottom:0}.section-topline{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:42px}.section-index{color:var(--color-accent);font-size:var(--text-xs);font-weight:700;font-variant-numeric:tabular-nums}.expertise-list{border-top:1px solid var(--color-border)}.expertise-row{display:grid;grid-template-columns:56px minmax(0,1fr);gap:22px;padding-block:25px;border-bottom:1px solid var(--color-border)}.expertise-row>span{color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.expertise-row h3{margin:0;font-size:var(--text-lg);font-weight:600;line-height:1.6}.expertise-row p,.timeline-description,.section-intro{max-width:760px;margin:7px 0 0;color:var(--color-ink-muted);font-size:var(--text-sm);line-height:1.9}.timeline{border-top:1px solid var(--color-border)}.timeline-item{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.8fr);gap:40px;padding-block:28px;border-bottom:1px solid var(--color-border)}.timeline-item h3{margin:0 0 8px;font-size:var(--text-lg);font-weight:600}.timeline-item p{margin:0;color:var(--color-ink-muted);line-height:1.8}.quiet-link{color:var(--color-accent-strong);text-decoration:none;font-size:var(--text-sm);font-weight:600}.quiet-link:hover{text-decoration:underline;text-underline-offset:5px}.selected-work .section-intro{margin:-18px 0 34px}.publication-list{display:grid;gap:1px}.credentials-grid{grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr)}.credential-list{display:grid;gap:0;border-top:1px solid var(--color-border)}.credential-list>div{display:flex;flex-direction:column;gap:7px;padding-block:20px;border-bottom:1px solid var(--color-border)}.credential-list strong{color:var(--color-accent);font-size:var(--text-xs)}.credential-list span,.credential-list a{color:var(--color-ink-muted);font-size:var(--text-sm);text-decoration:none;line-height:1.8}.credential-list a:hover{color:var(--color-accent-strong);text-decoration:underline;text-underline-offset:4px}@media(max-width:800px){.about-hero-grid,.identity-grid,.credentials-grid{grid-template-columns:1fr}.about-portrait{width:min(100%,430px)}.section-topline{align-items:flex-start;flex-direction:column}.timeline-item{grid-template-columns:1fr;gap:15px}}@media(max-width:560px){.expertise-row{grid-template-columns:42px 1fr}}
</style>
