---
import PublicationCard from "../../../components/PublicationCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getProfilePageSchema, getBreadcrumbSchema } from "../../../lib/schema";
import { site } from "../../../lib/site";
import { person } from "../../../lib/person";

const publications = (await getCollection("publications", ({ data }) => data.verified)).sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const profileSchema = { ...getProfilePageSchema({ url: `${site.url}/en/about/`, name: site.title.en, language: "en" }), image: new URL(person.image.src, site.url).toString() };
const breadcrumbSchema = getBreadcrumbSchema([{ name: "Home", url: `${site.url}/en/` }, { name: "About Dr. Leila Razavi", url: `${site.url}/en/about/` }]);
---
<BaseLayout title="Dr. Leila Razavi | Psychologist, University Lecturer and Researcher" description="Professional profile of Dr. Leila Razavi, including research areas, verified publications and documented professional activities." canonical={`${site.url}/en/about/`} lang="en" schemas={[profileSchema, breadcrumbSchema]}>
  <!--
    English parity rule: this page mirrors the Persian information architecture
    without duplicating the CV. About is the identity/narrative layer; CV and
    Publications remain separate destinations. The visual layer consumes the
    shared tokens so the two locales remain one brand system.
  -->
  <article class="profile-page"><div class="container">
    <header class="profile-header"><div class="profile-image"><img src={person.image.src} alt={person.image.altEn} width="694" height="766" loading="eager" decoding="async" /></div><div><p class="eyebrow">Psychologist · University Lecturer · Researcher</p><h1>{person.fullName}</h1><p class="lead">{person.description.en}</p></div></header>
    <div class="profile-layout"><main>
      <section><p class="section-label">Profile</p><h2>About</h2><p>{person.description.en}</p><p>Professional and scholarly information on this site is organized around publicly documented and verifiable sources.</p></section>
      <section><p class="section-label">Professional identity</p><h2>Areas of work</h2><ul class="knowledge-list">{person.knowsAbout.map((area) => <li>{area}</li>)}</ul></section>
      <section id="research"><p class="section-label">Research</p><h2>Research interests</h2><div class="research-list">{person.research.researchInterests.map((topic) => <article><h3>{topic}</h3></article>)}</div><p class="research-note">Only research areas supported by the project's documented sources are shown here. The complete scholarly record is maintained on Publications.</p></section>
      <section><p class="section-label">Professional activity</p><h2>Documented roles</h2>{person.positions.map((position) => <article class="item"><h3>{position.titleEn}</h3><p>{position.organizationEn}</p><a href={position.source} target="_blank" rel="noopener noreferrer">Public source ↗</a></article>)}</section>
      <section><p class="section-label">Publications</p><h2>Selected publications</h2><div>{publications.slice(0, 3).map((publication) => <PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal ?? publication.data.publisher} url={`/en/publications/${publication.id}/`} />)}</div><a class="text-link" href="/en/publications/">View all publications →</a></section>
    </main><aside>
      <div class="side-block"><strong>Professional credentials</strong><span>Iranian Psychology and Counseling Organization</span><span>Membership: {person.professionalCredentials.psychologyOrganization.membershipNumber}</span><span>License: {person.professionalCredentials.psychologyOrganization.licenseNumber}</span></div>
      <div class="side-block"><strong>Affiliation</strong>{person.affiliations.map((affiliation) => <a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name}</a>)}</div>
      <div class="side-block"><strong>Profiles</strong>{Object.entries(person.profiles).map(([label, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>)}</div>
    </aside></div>
  </div></article>
</BaseLayout>
<style>
.profile-page{padding-block:var(--space-9)}.profile-header{display:grid;grid-template-columns:300px 1fr;gap:clamp(40px,6vw,70px);align-items:center;padding-bottom:var(--space-9);border-bottom:1px solid var(--color-border)}.profile-image img{display:block;width:100%;height:auto;aspect-ratio:694/766;object-fit:cover}.eyebrow,.section-label{margin:0 0 var(--space-3);color:var(--color-accent);font-size:var(--text-xs);font-weight:700;letter-spacing:.05em}.profile-header h1{margin:0 0 var(--space-5);font-size:var(--text-display);line-height:1.1;font-weight:500;letter-spacing:-.04em}.lead{max-width:var(--reading-width);margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:var(--leading-relaxed)}.profile-layout{display:grid;grid-template-columns:minmax(0,760px) 240px;gap:clamp(50px,7vw,90px);padding-top:var(--space-9)}main section{padding-bottom:var(--space-8)}main p,aside span{color:var(--color-ink-muted);line-height:var(--leading-relaxed)}main section h2{margin:0 0 var(--space-5);font-size:var(--text-title);font-weight:500}.knowledge-list{display:flex;flex-wrap:wrap;gap:10px;padding:0;list-style:none}.knowledge-list li{padding:8px 14px;border:1px solid var(--color-border);color:var(--color-ink-muted);font-size:var(--text-sm)}.research-list{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--color-border);border:1px solid var(--color-border)}.research-list article{padding:22px;background:var(--color-bg);min-height:82px}.research-list h3{margin:0;font-size:var(--text-base);font-weight:500;line-height:1.8}.research-note{margin-top:var(--space-4);font-size:var(--text-sm);color:var(--color-ink-subtle)}.item{padding:22px 0;border-top:1px solid var(--color-border)}.item h3{margin:0;font-size:var(--text-lg);font-weight:600}.item p{margin:6px 0}.item a,.text-link{color:var(--color-accent-strong);text-decoration:none}.item a:hover,.text-link:hover{text-decoration:underline;text-underline-offset:5px}.side-block{display:flex;flex-direction:column;gap:10px;padding-bottom:var(--space-7)}.side-block strong{color:var(--color-accent);font-size:var(--text-xs)}.side-block a{color:var(--color-ink-muted);text-decoration:none;font-size:var(--text-sm)}.side-block a:hover{color:var(--color-accent)}@media(max-width:800px){.profile-header{grid-template-columns:1fr;gap:var(--space-7)}.profile-image{max-width:280px}.profile-layout{grid-template-columns:1fr;gap:var(--space-6)}.research-list{grid-template-columns:1fr}}
</style>
