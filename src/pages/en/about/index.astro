---
import PublicationCard from "../../../components/PublicationCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getProfilePageSchema, getBreadcrumbSchema } from "../../../lib/schema";
import { site } from "../../../lib/site";
import { person } from "../../../lib/person";

const publications = (await getCollection("publications", ({ data }) => data.verified)).sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const profileSchema = { ...getProfilePageSchema({ url: `${site.url}/en/about/`, name: site.title.en, language: "en" }), image: new URL(person.image.src, site.url).toString() };
const breadcrumbSchema = getBreadcrumbSchema([{ name: "Home", url: `${site.url}/en/` }, { name: "About Dr. Leila Razavi", url: `${site.url}/en/about/` }]);
---
<BaseLayout title={`Dr. Leila Razavi | Psychologist, University Lecturer and Researcher`} description="Professional profile of Dr. Leila Razavi, including research areas, verified publications and documented professional activities." canonical={`${site.url}/en/about/`} lang="en" schemas={[profileSchema, breadcrumbSchema]}>
  <article class="profile-page"><div class="container">
    <header class="profile-header"><div class="profile-image"><img src={person.image.src} alt={person.image.altEn} width="694" height="766" loading="eager" decoding="async" /></div><div><p class="eyebrow">Psychologist, University Lecturer and Researcher</p><h1>{person.fullName}</h1><p class="lead">{person.description.en}</p></div></header>
    <div class="profile-layout"><main>
      <section><p class="section-label">Profile</p><h2>About</h2><p>{person.description.en}</p><p>Professional and scholarly information on this site is organized around publicly documented and verifiable sources.</p></section>
      <section><p class="section-label">Professional identity</p><h2>Areas of work</h2><ul class="knowledge-list">{person.knowsAbout.map((area) => <li>{area}</li>)}</ul></section>
      <section id="research"><p class="section-label">Research</p><h2>Research interests</h2><div class="research-list">{person.research.researchInterests.map((topic) => <article><h3>{topic}</h3></article>)}</div><p class="research-note">Only research areas supported by the project's documented sources are shown here. The complete scholarly record is maintained on Publications.</p></section>
      <section><p class="section-label">Professional activity</p><h2>Documented roles</h2>{person.positions.map((position) => <article class="item"><h3>{position.titleEn}</h3><p>{position.organizationEn}</p><a href={position.source} target="_blank" rel="noopener noreferrer">Public source ↗</a></article>)}</section>
      <section><p class="section-label">Publications</p><h2>Selected publications</h2><div>{publications.slice(0, 3).map((publication) => <PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal ?? publication.data.publisher} url={`/en/publications/${publication.id}/`} />)}</div><a class="text-link" href="/en/publications/">View all publications →</a></section>
    </main><aside>
      <div class="side-block"><strong>Professional credentials</strong><span>Iranian Psychology and Counseling Organization</span><span>Membership: {person.professionalCredentials.psychologyOrganization.membershipNumber}</span><span>License: {person.professionalCredentials.psychologyOrganization.licenseNumber}</span></div>
      <div class="side-block"><strong>Affiliation</strong>{person.affiliations.map((affiliation) => <a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name}</a>)}</div>
      <div class="side-block"><strong>Profiles</strong>{Object.entries(person.profiles).map(([label, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>)}</div>
    </aside></div>
  </div></article>
</BaseLayout>
<style>
.profile-page{padding-block:90px}.profile-header{display:grid;grid-template-columns:300px 1fr;gap:70px;align-items:center;padding-bottom:80px;border-bottom:1px solid #ddd7d0}.profile-image img{display:block;width:100%;height:auto;aspect-ratio:694/766;object-fit:cover}.eyebrow,.section-label{margin:0 0 14px;color:#806f61;font-size:.78rem;font-weight:600;letter-spacing:.05em}h1{margin:0 0 24px;font-size:clamp(3rem,7vw,5rem);line-height:1.15;font-weight:500}.lead{max-width:650px;margin:0;color:#666;font-size:1.15rem;line-height:2}.profile-layout{display:grid;grid-template-columns:minmax(0,760px) 240px;gap:90px;padding-top:80px}main section{padding-bottom:60px}h2{margin:0 0 22px;font-size:2rem;font-weight:500}main p,aside span{color:#555;line-height:2}.knowledge-list{display:flex;flex-wrap:wrap;gap:10px;padding:0;list-style:none}.knowledge-list li{padding:8px 14px;border:1px solid #ddd7d0;color:#666;font-size:.85rem}.research-list{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#ddd7d0;border:1px solid #ddd7d0}.research-list article{padding:22px;background:#faf9f7;min-height:82px}.research-list h3{margin:0;font-size:1rem;font-weight:500;line-height:1.8}.research-note{margin-top:18px;font-size:.9rem;color:#777}.item{padding:22px 0;border-top:1px solid #eee9e4}.item h3{margin:0;font-size:1.1rem;font-weight:600}.item p{margin:6px 0}.item a,.text-link{color:#806f61;text-decoration:none}.side-block{display:flex;flex-direction:column;gap:10px;padding-bottom:35px}.side-block strong{color:#806f61;font-size:.78rem}.side-block a{color:#555;text-decoration:none;font-size:.85rem}.side-block a:hover{color:#806f61}@media(max-width:800px){.profile-header{grid-template-columns:1fr;gap:40px}.profile-image{max-width:280px}.profile-layout{grid-template-columns:1fr;gap:30px}.research-list{grid-template-columns:1fr}}
</style>
