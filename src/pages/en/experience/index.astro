---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { person } from "../../../lib/person";
import { site } from "../../../lib/site";
---
<BaseLayout title={`Professional Experience | ${site.name}`} description="Verified professional activities and affiliations of Dr. Leila Razavi." canonical={`${site.url}/en/experience/`} lang="en">
  <section class="page"><div class="container">
    <header><p class="label">Professional experience</p><h1>Professional activities</h1><p class="lead">{person.description.en}</p></header>
    <section><h2>Central Council of the School of Psychology</h2><p>Dr. Leila Razavi is listed among the members of the Central Council of the School of Psychology in Qom Province in a public announcement by the Association of Psychologists and Counselors of Qom Province.</p><a href="https://t.me/s/ahmadtorabie" target="_blank" rel="noopener noreferrer">Public source</a></section>
    <section><h2>Professional affiliation</h2>{person.affiliations.map((affiliation) => <p><a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name}</a></p>)}</section>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:60px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{font-size:clamp(2.5rem,6vw,4.5rem);font-weight:500}.lead,p{color:#555;line-height:2}section section{max-width:820px;padding:50px 0;border-top:1px solid #ddd7d0}h2{font-size:1.8rem;font-weight:500}a{color:#806f61}
</style>