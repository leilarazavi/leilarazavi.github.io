---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { person } from "../../../lib/person";
import { site } from "../../../lib/site";
---

<BaseLayout title={`Professional Experience | ${site.name}`} description="Publicly documented professional roles, affiliations, and activities of Dr. Leila Razavi." canonical={`${site.url}/en/experience/`} lang="en">
  <section class="page" aria-labelledby="experience-title"><div class="container">
    <header class="page-header"><p class="eyebrow">01 · Professional trajectory</p><h1 id="experience-title">Professional roles and activities</h1><p class="lead">{person.description.en} This page focuses on documented roles and affiliations, with public sources retained so each entry can be understood and checked in context.</p></header>
    <section class="content-section" aria-labelledby="roles-title"><div class="section-head"><div><p class="section-label">Documented activity</p><h2 id="roles-title">Roles and responsibilities</h2></div><span class="section-index">02</span></div><div class="activity-list">{person.positions.map((position, index)=><article class="activity"><div class="activity-number">{String(index + 1).padStart(2,"0")}</div><div><h3>{position.titleEn}</h3><p class="organization">{position.organizationEn}</p><p class="description">This role is included as a documented part of the professional record. The linked public source provides the original context for the appointment or organizational activity.</p><a href={position.source} target="_blank" rel="noopener noreferrer">View public source ↗</a></div></article>)}</div></section>
    <section class="content-section" aria-labelledby="affiliation-title"><div class="section-head"><div><p class="section-label">Professional network</p><h2 id="affiliation-title">Affiliations</h2></div><span class="section-index">03</span></div><div class="affiliation-list">{person.affiliations.map((affiliation)=><article><h3>{affiliation.name}</h3><p>A professional affiliation represented in the site's public identity model, with the organization's own page available as the external source.</p><a href={affiliation.url} target="_blank" rel="noopener noreferrer">View organization profile ↗</a></article>)}</div></section>
    <section class="next"><div><p class="section-label">Continue</p><h2>Explore research and verified publications</h2><p>The professional trajectory is only one part of the profile. Research interests and scholarly evidence are presented separately to keep the site useful for both professional and academic audiences.</p></div><a class="button" href="/en/publications/">View publications →</a></section>
  </div></section>
</BaseLayout>

<style>
.page{padding-block:clamp(64px,8vw,104px)}.page-header{max-width:820px;padding-bottom:clamp(58px,7vw,86px);border-bottom:1px solid var(--color-border)}.eyebrow,.section-label{margin:0 0 var(--space-3);color:var(--color-accent);font-size:var(--text-xs);font-weight:700;letter-spacing:.05em}.page-header h1{margin:0 0 22px;font-size:var(--text-display);line-height:1.08;font-weight:500;letter-spacing:-.04em}.lead{max-width:760px;margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.content-section{padding-block:clamp(64px,8vw,96px);border-bottom:1px solid var(--color-border)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px}.section-head h2{margin:0;font-size:var(--text-title);font-weight:500}.section-index{color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.activity-list,.affiliation-list{border-top:1px solid var(--color-border)}.activity{display:grid;grid-template-columns:54px minmax(0,1fr);gap:22px;padding-block:26px;border-bottom:1px solid var(--color-border)}.activity-number{color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.activity h3,.affiliation-list h3{margin:0;font-size:var(--text-lg);font-weight:600;line-height:1.6}.organization{margin:5px 0 0;color:var(--color-ink);font-size:var(--text-sm);font-weight:600}.description,.affiliation-list p{max-width:760px;margin:8px 0 12px;color:var(--color-ink-muted);font-size:var(--text-sm);line-height:1.9}.activity a,.affiliation-list a{color:var(--color-accent-strong);text-decoration:none;font-size:var(--text-sm);font-weight:600}.activity a:hover,.affiliation-list a:hover{text-decoration:underline;text-underline-offset:5px}.affiliation-list article{padding-block:26px;border-bottom:1px solid var(--color-border)}.next{display:flex;align-items:center;justify-content:space-between;gap:40px;padding-block:clamp(64px,8vw,96px)}.next h2{margin:0;max-width:700px;font-size:var(--text-title);font-weight:500}.next p:not(.section-label){max-width:720px;color:var(--color-ink-muted);line-height:2}.button{display:inline-flex;min-height:48px;align-items:center;padding-inline:22px;background:var(--color-accent);color:var(--color-surface);text-decoration:none;font-size:var(--text-sm);font-weight:700;white-space:nowrap}@media(max-width:700px){.section-head,.next{align-items:flex-start;flex-direction:column}.activity{grid-template-columns:40px 1fr}}
</style>
