---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { person } from "../../../lib/person";
import { site } from "../../../lib/site";
---
<BaseLayout title={`Professional Experience | ${site.name}`} description="Publicly documented professional roles, affiliations, and activities of Dr. Leila Razavi." canonical={`${site.url}/en/experience/`} lang="en">
  <section class="page"><div class="container">
    <header><p class="label">Professional experience</p><h1>Professional roles and activities</h1><p class="lead">{person.description.en}</p></header>
    <section><h2>Documented roles</h2>{person.positions.map((position) => <article class="activity"><h3>{position.titleEn}</h3><p>{position.organizationEn}</p><a href={position.source} target="_blank" rel="noopener noreferrer">Public source ↗</a></article>)}</section>
    <section><h2>Professional affiliation</h2>{person.affiliations.map((affiliation) => <p><a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name}</a></p>)}</section>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:70px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead,p{color:#555;line-height:2}section section{max-width:820px;padding:50px 0;border-top:1px solid #ddd7d0}h2{font-size:1.8rem;font-weight:500}.activity{padding:26px 0;border-top:1px solid #eee9e3}.activity:first-of-type{border-top:0}.activity h3{font-size:1.2rem;font-weight:600}.activity p{margin:6px 0}.activity a,a{color:#806f61}
</style>
