---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { site } from "../../lib/site";
import { getBreadcrumbSchema, getPendarOrganizationSchema } from "../../lib/schema";

const url = `${site.url}/organizations/`;
const schemas = [getPendarOrganizationSchema(), getBreadcrumbSchema([
  { name: "خانه", url: `${site.url}/` },
  { name: "سازمان‌ها و وابستگی‌های حرفه‌ای", url },
])];

/*
 * ORGANIZATION ENTITY DECISION
 *
 * This page is not a generic list of workplaces. It exists to clarify the
 * relationship between the Person entity and the Pendar organization graph.
 * The hierarchy is therefore explicit and source-linked.
 *
 * UX: organizations remain out of the primary header because they are a
 * supporting destination, not the main user journey. SEO: the route and
 * Organization schema remain stable so Person <-> Organization relationships
 * can be understood without duplicating the information on About or CV.
 */
---
<BaseLayout title={`سازمان‌ها و وابستگی‌های حرفه‌ای | ${site.nameFa}`} description="ارتباط حرفه‌ای دکتر لیلا رضوی با گروه پندار، پندار نیم‌رخ و پندار نیم‌رخ قم و سایر فعالیت‌های سازمانی." canonical={url} lang="fa" schemas={schemas}>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title"><div class="container about-hero-grid"><div class="about-copy"><p class="eyebrow"><span>01</span> سازمان‌ها و وابستگی‌های حرفه‌ای</p><h1 id="about-title">شبکه حرفه‌ای پندار</h1><p class="about-lead">رابطه میان دکتر لیلا رضوی و ساختار سازمانی پندار، به‌صورت روشن و منبع‌محور.</p></div></div></section>
    <section class="org-tree" aria-label="ساختار سازمانی">
      <article class="org-node"><p class="node-level">01 · گروه اصلی</p><h2 class="text-heading">گروه سازمان‌های علمی، اجتماعی و درمانی پندار</h2><p>ساختار اصلی که مجموعه‌ها و فعالیت‌های وابسته به پندار در چارچوب آن معرفی می‌شوند.</p><a href="https://pendar-gp.ir/" target="_blank" rel="noopener noreferrer">وب‌سایت رسمی پندار ↗</a></article>
      <div class="connector" aria-hidden="true">↓</div>
      <article class="org-node"><p class="node-level">02 · مجموعه وابسته</p><h2 class="text-heading">پندار نیم‌رخ</h2><p>یکی از مجموعه‌های وابسته به گروه پندار که در ساختار حرفه‌ای این پروفایل به آن ارجاع داده می‌شود.</p><a href="https://pendar-gp.ir/" target="_blank" rel="noopener noreferrer">منبع رسمی پندار ↗</a></article>
      <div class="connector" aria-hidden="true">↓</div>
      <article class="org-node org-node--person"><p class="node-level">03 · مرکز در قم</p><h2 class="text-heading">پندار نیم‌رخ قم</h2><p>مرکز پندار نیم‌رخ در قم که مدیریت آن در پروفایل حرفه‌ای پندار با دکتر لیلا رضوی مرتبط است.</p><a href={person.profiles.pendar} target="_blank" rel="noopener noreferrer">پروفایل دکتر لیلا رضوی در پندار ↗</a></article>
    </section>
    <section class="role-card"><p class="eyebrow">نقش شخص</p><h2 class="text-heading">دکتر لیلا رضوی در این ساختار</h2><p>در این وب‌سایت، دکتر لیلا رضوی به‌عنوان مدیر پندار نیم‌رخ قم معرفی می‌شود. برای جزئیات و سوابق رسمی، پروفایل حرفه‌ای پندار منبع اصلی است.</p><div class="role-links"><a href="/about/">مشاهده پروفایل حرفه‌ای ↗</a><a href="/experience/">مشاهده فعالیت‌های حرفه‌ای ↗</a></div></section>
  </div>
</BaseLayout>

<style>
  .about-page{overflow:clip}.about-hero{padding-block:clamp(68px,9vw,120px);border-bottom:1px solid var(--color-border)}.about-hero-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(48px,9vw,130px);align-items:center}.about-copy{max-width:760px}.about-copy h1{margin:0;font-size:var(--text-display);line-height:1.08;font-weight:500;letter-spacing:-.045em}.about-lead{max-width:680px;margin:28px 0 0;color:var(--color-ink-muted);font-size:clamp(1.05rem,1.5vw,1.2rem);line-height:2}.eyebrow{display:flex;align-items:center;gap:12px;margin:0 0 22px;color:var(--color-accent-strong);font-size:var(--text-xs);font-weight:700;letter-spacing:.08em}.eyebrow span{color:var(--color-ink-faint);font-variant-numeric:tabular-nums}.container{max-width:1080px}.about-page>section:not(.about-hero){padding-block:clamp(55px,7vw,85px);border-bottom:1px solid var(--color-border)}.org-tree{max-width:820px;margin-inline:auto}.org-node{padding:32px 0;border-block:1px solid var(--color-border)}.org-node+.connector{border:0}.node-level{margin:0 0 10px;color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.org-node h2,.role-card h2{margin-bottom:16px}.org-node p:not(.node-level),.role-card p{max-width:720px;margin:0 0 16px;color:var(--color-ink-muted);line-height:2}.org-node a,.role-links a{color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:600;text-decoration:none}.org-node a:hover,.role-links a:hover{text-decoration:underline;text-underline-offset:5px}.connector{padding:14px 0;text-align:center;color:var(--color-accent);font-size:1.2rem}.org-node--person{padding-bottom:40px}.role-card{max-width:820px;margin:clamp(55px,8vw,90px) auto 0;padding:34px 0;border-top:1px solid var(--color-border)}.role-links{display:flex;flex-wrap:wrap;gap:24px;margin-top:24px}@media(max-width:560px){.role-links{flex-direction:column;gap:14px}}
</style>
