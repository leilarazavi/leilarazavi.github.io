---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { getPublicationsByYear } from "../../lib/publications";
import { person } from "../../lib/person";
import { site } from "../../lib/site";

const publications = getPublicationsByYear();
---
<BaseLayout title={`حوزه‌های پژوهشی | ${site.nameFa}`} description="حوزه‌های پژوهشی و آثار علمی تأییدشده دکتر لیلا رضوی در روان‌شناسی، مداخلات روان‌شناختی و سلامت روان." canonical={`${site.url}/research/`} lang="fa">
  <section class="page"><div class="container">
    <header><p class="label">پژوهش</p><h1>حوزه‌های پژوهشی و آثار علمی</h1><p class="lead">{person.description.fa}</p></header>
    <section><h2>زمینه‌های فعالیت پژوهشی</h2><div class="topics">{person.knowsAbout.map((area) => <span>{area}</span>)}</div></section>
    <section><h2>آثار علمی تأییدشده</h2><div class="publications">{publications.map((publication) => <PublicationCard title={publication.title} titleFa={publication.titleFa} authors={publication.authors} year={publication.year} journal={publication.journal} url={`/publications/${publication.id}/`} />)}</div></section>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:70px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead{color:#555;line-height:2;font-size:1.1rem}section section{padding-top:60px}h2{font-size:1.8rem;font-weight:500}.topics{display:flex;flex-wrap:wrap;gap:10px}.topics span{padding:9px 14px;border:1px solid #ddd7d0;color:#555}.publications{display:grid}
</style>