---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { person } from "../../lib/person";
import { site } from "../../lib/site";

const publications = (await getCollection("publications", ({ data }) => data.verified)).sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
---
<BaseLayout title={`حوزه‌های پژوهشی | ${site.nameFa}`} description="حوزه‌های پژوهشی دکتر لیلا رضوی بر پایه آثار علمی تأییدشده و فعالیت‌های پژوهشی قابل‌راستی‌آزمایی." canonical={`${site.url}/research/`} lang="fa">
  <section class="page"><div class="container"><header><p class="label">پژوهش</p><h1>حوزه‌های پژوهشی</h1><p class="lead">حوزه‌های پژوهشی زیر از روی آثار علمی و سوابق قابل‌راستی‌آزمایی استخراج شده‌اند.</p></header><section><h2>محورهای پژوهشی</h2><div class="topics">{person.research.researchInterests.map((topic) => <span>{topic}</span>)}</div></section><section><h2>آثار مرتبط</h2><div class="publications">{publications.map((publication) => <PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal ?? publication.data.publisher} url={`/publications/${publication.id}/`} />)}</div></section></div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:60px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead,p{color:#555;line-height:2;font-size:1.05rem}section section{padding-top:60px}h2{font-size:1.8rem;font-weight:500}.topics{display:flex;flex-wrap:wrap;gap:10px}.topics span{padding:9px 14px;border:1px solid #ddd7d0;color:#555}.publications{display:grid}
</style>
