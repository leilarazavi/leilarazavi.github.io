---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";
import { person } from "../lib/person";
import { podcast } from "../lib/media";

const socialLinks = [
  { name: "اینستاگرام شخصی", handle: "@dr.leila.razavi_psy", description: "صفحه حرفه‌ای دکتر لیلا رضوی برای دنبال‌کردن محتوای روان‌شناسی و فعالیت‌های حرفه‌ای.", url: person.profiles.instagram },
  { name: "پندار قم", handle: "@pendarqom", description: "حضور رسمی پندار در قم و محتوای مرتبط با روان‌شناسی و فعالیت‌های حرفه‌ای.", url: person.profiles.pendarInstagram },
  { name: "Google Scholar", handle: "Leila Razavi", description: "برای مشاهده سوابق پژوهشی، آثار علمی و مسیر انتشار مقالات.", url: person.profiles.googleScholar },
];
---

<BaseLayout title={site.title.fa} description="وب‌سایت رسمی دکتر لیلا رضوی، روان‌شناس، مدرس دانشگاه و پژوهشگر حوزه روان‌شناسی." canonical={`${site.url}/`} lang="fa">
  <main>
    <section class="hero" aria-labelledby="hero-title"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">روان‌شناس · مدرس دانشگاه · پژوهشگر</p><h1 id="hero-title">دکتر لیلا رضوی</h1><p class="hero-lead">روان‌شناس، مدرس دانشگاه و پژوهشگر حوزه روان‌شناسی، با فعالیت در آموزش، پژوهش و موضوعات مرتبط با سلامت روان و کیفیت زندگی.</p><p class="hero-note">این وب‌سایت مرجع رسمی برای شناخت مسیر حرفه‌ای، حوزه‌های پژوهشی، آثار منتشرشده و فعالیت‌های رسانه‌ای دکتر لیلا رضوی است.</p><div class="hero-actions"><a class="button button-primary" href="/about/">درباره لیلا رضوی <span aria-hidden="true">←</span></a><a class="text-link" href="/publications/">مشاهده همه آثار <span aria-hidden="true">←</span></a></div></div><figure class="hero-visual"><img src={person.image.src} alt={person.image.altFa} width="1018" height="1024" loading="eager" fetchpriority="high" decoding="async" /><figcaption>Leila Razavi · Psychology · Research · Education</figcaption></figure></div></section>
    <section class="intro" aria-labelledby="intro-title"><div class="container split"><div><p class="kicker">معرفی</p><h2 id="intro-title">یک تصویر روشن از مسیر حرفه‌ای</h2></div><div class="copy"><p>دکتر لیلا رضوی در نقطه اتصال روان‌شناسی، آموزش دانشگاهی و پژوهش فعالیت می‌کند. مسیر علمی و حرفه‌ای او با مطالعه و کاربرد مداخلات روان‌شناختی و موضوعاتی مانند کیفیت زندگی، درد، افسردگی، خستگی و تنظیم هیجان در شرایط سلامت پیوند دارد.</p><p>این صفحه فقط تصویری کلی ارائه می‌دهد؛ جزئیات زندگی حرفه‌ای، تحصیلات، تجربه‌ها و همکاری‌ها در صفحه‌های اختصاصی سایت قرار گرفته‌اند تا هر صفحه محتوای مستقل و قابل‌فهم خود را داشته باشد.</p><a class="text-link" href="/about/">داستان و معرفی کامل <span aria-hidden="true">←</span></a></div></div></section>
    <section class="research" aria-labelledby="research-title"><div class="container split"><div><p class="kicker">پژوهش</p><h2 id="research-title">پژوهش‌ها درباره چه هستند؟</h2></div><div class="copy"><p>بخش پژوهشی سایت مجموعه‌ای از آثار منتشرشده و تأییدشده را گرد هم آورده است. در این آثار، موضوعاتی مانند مداخلات مبتنی بر پذیرش و تعهد و ذهن‌آگاهی، کیفیت زندگی، درد، افسردگی، خستگی و تجربه روان‌شناختی در شرایط سلامت بررسی شده‌اند.</p><p>اگر می‌خواهید خود مقاله‌ها، اطلاعات کتاب‌شناختی، نویسندگان و منابع هر اثر را ببینید، صفحه پژوهش‌ها مرجع کامل این بخش است.</p><a class="button button-dark" href="/publications/">رفتن به همه آثار منتشرشده <span aria-hidden="true">←</span></a></div></div></section>
    <section class="professional" aria-labelledby="professional-title"><div class="container split"><div><p class="kicker">فعالیت حرفه‌ای</p><h2 id="professional-title">مسیر حرفه‌ای و همکاری‌ها</h2></div><div class="copy"><p>فعالیت حرفه‌ای دکتر لیلا رضوی فقط به عنوان‌های شغلی خلاصه نمی‌شود. سابقه دانشگاهی، همکاری‌های سازمانی و ارتباط با پندار، هرکدام بخشی از این مسیر را شکل می‌دهند و در صفحه‌های مستقل با جزئیات بیشتر توضیح داده شده‌اند.</p><div class="inline-links"><a class="text-link" href="/experience/">مشاهده فعالیت حرفه‌ای <span aria-hidden="true">←</span></a><a class="text-link" href="/organizations/">مشاهده همکاری‌ها <span aria-hidden="true">←</span></a></div></div></div></section>
    <section class="social" aria-labelledby="social-title"><div class="container"><div class="section-heading"><div><p class="kicker">حضور رسمی</p><h2 id="social-title">از این مسیرها می‌توانید ادامه دهید</h2><p class="section-intro">این لینک‌ها، کانال‌های رسمی برای دنبال‌کردن فعالیت‌های حرفه‌ای، محتوای روان‌شناسی، فعالیت پندار و آثار علمی هستند.</p></div></div><div class="social-list">{socialLinks.map((link,index)=><a class="social-item" href={link.url} target="_blank" rel="noopener noreferrer"><span class="social-number">0{index+1}</span><span class="social-main"><strong>{link.name}</strong><span>{link.handle}</span><small>{link.description}</small></span><span class="social-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
    <section class="media" aria-labelledby="media-title"><div class="container split"><div><p class="kicker">رسانه</p><h2 id="media-title">{podcast.nameFa}</h2></div><div class="copy"><p>{podcast.descriptionFa}</p><p>«صحبت جان» فضایی برای گفت‌وگو درباره تجربه انسانی، روان‌شناسی و موضوعاتی است که در زندگی روزمره با آن‌ها روبه‌رو می‌شویم.</p><div class="inline-links"><a class="button button-primary" href="/media/sohbat-jan/">درباره پادکست <span aria-hidden="true">←</span></a><a class="text-link" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">شنیدن در Spotify <span aria-hidden="true">↗</span></a></div></div></div></section>
    <section class="closing" aria-labelledby="closing-title"><div class="container closing-inner"><div><p class="kicker">ادامه</p><h2 id="closing-title">برای اطلاعات کامل، هر بخش را در صفحه خودش ببینید.</h2></div><nav class="closing-links" aria-label="لینک‌های اصلی"><a href="/about/">درباره من</a><a href="/publications/">همه آثار منتشرشده</a><a href="/cv/">رزومه</a><a href="/contact/">پروفایل‌ها و ارتباط</a></nav></div></section>
  </main>
</BaseLayout>

<style>
.hero{padding-block:clamp(64px,9vw,112px) clamp(72px,10vw,120px);background:var(--color-bg)}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.72fr);gap:clamp(44px,8vw,120px);align-items:center}.hero-copy{max-width:700px}.eyebrow,.kicker{margin:0 0 16px;color:var(--color-accent-strong);font-size:var(--text-xs);font-weight:700}.hero h1,.intro h2,.research h2,.professional h2,.media h2,.closing h2{font-family:var(--font-heading);font-weight:600;letter-spacing:-.03em;line-height:1.3}.hero h1{margin:0;font-size:clamp(3.7rem,8vw,7.2rem);line-height:1}.hero-lead{max-width:680px;margin:30px 0 14px;font-size:clamp(1.15rem,1.8vw,1.4rem);line-height:1.95}.hero-note,.copy p,.section-intro{color:var(--color-ink-muted);line-height:1.95}.hero-note{max-width:620px;margin:0}.hero-actions,.inline-links{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:28px}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:12px 22px;text-decoration:none;font-size:var(--text-sm);font-weight:700}.button-primary{background:var(--color-accent);color:var(--color-surface)}.button-dark{background:var(--color-ink);color:var(--color-surface)}.text-link{color:var(--color-accent-strong);text-decoration:none;font-size:var(--text-sm);font-weight:700}.text-link:hover{text-decoration:underline;text-underline-offset:5px}.hero-visual{margin:0}.hero-visual img{display:block;width:100%;aspect-ratio:1/1.08;object-fit:cover}.hero-visual figcaption{padding-top:12px;color:var(--color-ink-subtle);font-size:.68rem;letter-spacing:.04em}.intro,.research,.professional,.social,.media,.closing{padding-block:clamp(72px,9vw,112px);border-top:1px solid var(--color-border)}.split{display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.2fr);gap:clamp(40px,9vw,130px);align-items:start}.intro h2,.research h2,.professional h2,.media h2,.closing h2{margin:0;font-size:clamp(2rem,3.7vw,3.4rem)}.copy{max-width:760px}.copy p{margin:0 0 16px;font-size:var(--text-lg)}.section-heading{margin-bottom:34px}.section-heading h2{margin:0;font-size:clamp(2rem,3.7vw,3.4rem)}.section-intro{max-width:760px;margin:14px 0 0;font-size:var(--text-base)}.professional{background:var(--color-surface-muted)}.social-list{border-top:1px solid var(--color-border)}.social-item{display:grid;grid-template-columns:50px 1fr 24px;align-items:center;gap:24px;padding:22px 0;border-bottom:1px solid var(--color-border);color:var(--color-ink);text-decoration:none}.social-item:hover{padding-inline:12px;background:var(--color-surface-muted)}.social-number{color:var(--color-accent);font-size:var(--text-xs)}.social-main{display:grid;grid-template-columns:minmax(160px,.35fr) minmax(150px,.3fr) 1fr;gap:18px;align-items:center}.social-main strong{font-size:1.05rem}.social-main span{direction:ltr;color:var(--color-accent-strong)}.social-main small{color:var(--color-ink-muted);font-size:var(--text-sm);line-height:1.7}.social-arrow{color:var(--color-ink-subtle)}.media{background:var(--color-bg)}.closing{background:var(--color-surface)}.closing-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.65fr);gap:60px;align-items:end}.closing-links{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--color-border)}.closing-links a{padding:15px 0;border-bottom:1px solid var(--color-border);color:var(--color-ink);text-decoration:none;font-weight:600}.closing-links a:hover{color:var(--color-accent-strong)}
@media(max-width:820px){.hero-grid,.split,.closing-inner{grid-template-columns:1fr}.hero-visual{width:min(100%,520px)}.social-main{grid-template-columns:1fr;gap:4px}.social-item{grid-template-columns:36px 1fr 18px}}@media(max-width:520px){.hero h1{font-size:clamp(3rem,15vw,4.5rem)}.hero-actions,.inline-links{align-items:stretch;flex-direction:column}.button{width:100%}.closing-links{grid-template-columns:1fr}}
</style>
