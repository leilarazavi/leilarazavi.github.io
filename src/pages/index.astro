---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { site } from "../lib/site";
import { person } from "../lib/person";
import { podcast } from "../lib/media";

const entries = await getCollection("publications", ({ data }) => data.verified);
const publications = entries.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<BaseLayout
  title={site.title.fa}
  description="وب‌سایت رسمی دکتر لیلا رضوی، روان‌شناس، مدرس دانشگاه و پژوهشگر حوزه روان‌شناسی."
  canonical={`${site.url}/`}
  lang="fa"
>
  <!--
    HOMEPAGE UX DECISION — Personal Authority v1

    The old homepage behaved like a compact CV: many equal-weight CTAs and
    several sections competing for attention. The new structure follows a
    deliberate narrative:

    1. Identity + positioning: who is Leila Razavi?
    2. Professional focus: what does she work on?
    3. Selected academic work: why is the profile credible?
    4. Professional / media presence: where else can visitors explore?
    5. One clear final action: continue to the official profiles/contact layer.

    This is intentionally NOT a content deletion. Existing SEO-relevant
    destinations remain linked; the homepage simply gives them hierarchy.
  -->

  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow">روان‌شناس · مدرس دانشگاه · پژوهشگر</p>
        <h1>دکتر لیلا رضوی</h1>
        <p class="hero-description">
          وب‌سایت رسمی دکتر لیلا رضوی؛ مرجعی برای معرفی فعالیت‌های حرفه‌ای، پژوهش‌ها،
          آثار علمی و حضورهای رسانه‌ای.
        </p>
        <div class="hero-actions" aria-label="مسیرهای اصلی">
          <a class="button button-primary" href="/about/">آشنایی با من</a>
          <a class="text-link hero-link" href="/publications/">مشاهده آثار علمی <span aria-hidden="true">←</span></a>
        </div>
      </div>

      <figure class="hero-image">
        <img
          src={person.image.src}
          alt={person.image.altFa}
          width="694"
          height="766"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="positioning" aria-labelledby="positioning-title">
    <div class="container positioning-grid">
      <div>
        <p class="section-label">رویکرد حرفه‌ای</p>
        <h2 id="positioning-title">روان‌شناسی، پژوهش و آموزش در یک مسیر حرفه‌ای</h2>
      </div>
      <div>
        <p class="large-text">{person.description.fa}</p>
        <a class="text-link" href="/about/">معرفی کامل و سوابق <span aria-hidden="true">←</span></a>
      </div>
    </div>
  </section>

  <section class="expertise" aria-labelledby="expertise-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">حوزه‌های فعالیت</p>
          <h2 id="expertise-title">تمرکزهای حرفه‌ای و پژوهشی</h2>
        </div>
        <a class="text-link" href="/about/#research">جزئیات پژوهش <span aria-hidden="true">←</span></a>
      </div>

      <div class="expertise-grid">
        {person.knowsAbout.map((area, index) => (
          <article class="expertise-item">
            <span class="item-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{area}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="publications" aria-labelledby="publications-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">پژوهش و آثار</p>
          <h2 id="publications-title">آثار علمی منتخب</h2>
        </div>
        <a class="text-link" href="/publications/">همه آثار علمی <span aria-hidden="true">←</span></a>
      </div>

      <div class="publication-list">
        {publications.slice(0, 3).map((publication) => (
          <PublicationCard
            title={publication.data.title}
            titleFa={publication.data.titleFa}
            authors={publication.data.authors}
            year={publication.data.year}
            journal={publication.data.journal}
            url={`/publications/${publication.id}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="professional" aria-labelledby="professional-title">
    <div class="container professional-grid">
      <div>
        <p class="section-label">فعالیت حرفه‌ای</p>
        <h2 id="professional-title">فعالیت‌های حرفه‌ای و سازمانی</h2>
      </div>
      <div class="professional-content">
        <p>
          فعالیت حرفه‌ای، همکاری‌های سازمانی و ارتباط با پندار نیم‌رخ در ساختار مستقل
          فعالیت‌های حرفه‌ای و سازمانی سایت قابل بررسی است.
        </p>
        <div class="link-group">
          <a class="button button-secondary" href="/experience/">مشاهده فعالیت حرفه‌ای</a>
          <a class="text-link" href="/organizations/">سازمان‌ها و همکاری‌ها <span aria-hidden="true">←</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="media" aria-labelledby="media-title">
    <div class="container media-grid">
      <div class="media-copy">
        <p class="section-label">رسانه</p>
        <h2 id="media-title">صحبت جان</h2>
        <p>{podcast.descriptionFa}</p>
        <div class="link-group">
          <a class="button button-primary" href="/media/sohbat-jan/">معرفی پادکست</a>
          <a class="text-link" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="media-note" aria-hidden="true">پادکست<br />صحبت جان</div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-cta-title">
    <div class="container final-cta-inner">
      <div>
        <p class="section-label">منابع رسمی</p>
        <h2 id="final-cta-title">برای ادامه مسیر، از منابع رسمی شروع کنید.</h2>
      </div>
      <a class="button button-primary" href="/contact/">پروفایل‌ها و راه‌های ارتباطی</a>
    </div>
  </section>
</BaseLayout>

<style>
  /*
   * Page-specific composition only. Colors, type scale, spacing and container
   * primitives come from the shared design system. This keeps the homepage
   * expressive without creating another isolated visual language.
   */
  .hero { padding-block: clamp(72px, 10vw, 132px) clamp(72px, 9vw, 116px); border-bottom: 1px solid var(--color-border); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .72fr); align-items: center; gap: clamp(48px, 8vw, 110px); }
  .hero-content { max-width: 720px; }
  .hero h1 { margin: 0; font-size: var(--text-display); line-height: 1.08; font-weight: 500; letter-spacing: -.045em; }
  .hero-description { max-width: 620px; margin: 28px 0 38px; color: var(--color-ink-muted); font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 2; }
  .hero-actions, .link-group { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding-inline: 24px; border: 1px solid var(--color-accent); text-decoration: none; font-size: var(--text-sm); transition: transform var(--transition-fast), background var(--transition-fast), color var(--transition-fast); }
  .button:hover { transform: translateY(-2px); }
  .button-primary { background: var(--color-accent); color: var(--color-surface); }
  .button-secondary { color: var(--color-accent-strong); background: transparent; }
  .hero-link { font-weight: 600; }
  .hero-image { width: min(100%, 430px); margin: 0; justify-self: end; }
  .hero-image img { width: 100%; height: auto; aspect-ratio: 694 / 766; object-fit: cover; }

  .positioning { padding-block: clamp(80px, 10vw, 130px); }
  .positioning-grid, .professional-grid { display: grid; grid-template-columns: minmax(260px, .8fr) minmax(0, 1.2fr); gap: clamp(40px, 9vw, 140px); }
  .positioning h2, .professional h2, .media h2 { margin: 0; max-width: 650px; font-size: var(--text-title); line-height: 1.3; font-weight: 500; }
  .large-text { max-width: 760px; margin: 0 0 28px; color: var(--color-ink-muted); font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 2.05; }

  .expertise, .publications { padding-block: clamp(72px, 9vw, 110px); border-top: 1px solid var(--color-border); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: 48px; }
  .section-heading h2 { margin: 0; font-size: var(--text-title); line-height: 1.3; font-weight: 500; }
  .text-link { color: var(--color-accent-strong); text-decoration: none; font-size: var(--text-sm); }
  .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .expertise-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--color-border); }
  .expertise-item { display: grid; grid-template-columns: 52px 1fr; gap: 18px; min-height: 150px; padding: 30px 20px 30px 0; border-bottom: 1px solid var(--color-border); }
  .expertise-item:nth-child(odd) { border-inline-end: 1px solid var(--color-border); padding-inline-end: 30px; }
  .expertise-item:nth-child(even) { padding-inline-start: 30px; }
  .item-number { color: var(--color-accent); font-size: var(--text-xs); font-variant-numeric: tabular-nums; padding-top: 5px; }
  .expertise-item h3 { margin: 0; font-size: var(--text-lg); line-height: 1.7; font-weight: 500; }

  .publication-list { display: grid; gap: 1px; }
  .professional { padding-block: clamp(72px, 9vw, 110px); border-top: 1px solid var(--color-border); background: var(--color-surface-muted); }
  .professional-content p { max-width: 700px; margin: 0 0 28px; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 2; }

  .media { padding-block: clamp(80px, 10vw, 130px); border-top: 1px solid var(--color-border); }
  .media-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .65fr); gap: 70px; align-items: center; }
  .media-copy p:not(.section-label) { max-width: 700px; margin: 22px 0 30px; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 2; }
  .media-note { min-height: 300px; display: grid; place-items: center; border: 1px solid var(--color-border-strong); color: var(--color-accent); text-align: center; font-size: clamp(2rem, 5vw, 4rem); line-height: 1.25; font-weight: 500; }

  .final-cta { padding-block: clamp(70px, 8vw, 100px); }
  .final-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: clamp(34px, 5vw, 58px); background: var(--color-accent-soft); }
  .final-cta h2 { max-width: 650px; margin: 0; font-size: var(--text-heading); line-height: 1.45; font-weight: 500; }

  @media (max-width: 800px) {
    .hero-grid, .positioning-grid, .professional-grid, .media-grid { grid-template-columns: 1fr; }
    .hero-image { justify-self: start; width: min(100%, 390px); }
    .section-heading { align-items: flex-start; flex-direction: column; }
    .expertise-grid { grid-template-columns: 1fr; }
    .expertise-item:nth-child(odd) { border-inline-end: 0; padding-inline-end: 20px; }
    .expertise-item:nth-child(even) { padding-inline-start: 0; }
    .final-cta-inner { align-items: flex-start; flex-direction: column; }
  }

  @media (max-width: 480px) {
    .hero-actions, .link-group { align-items: flex-start; flex-direction: column; }
    .button { width: 100%; }
    .hero-image { width: 100%; }
    .expertise-item { min-height: auto; grid-template-columns: 38px 1fr; padding-block: 24px; }
    .media-note { min-height: 220px; }
  }
</style>
