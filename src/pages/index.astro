---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";
import { person } from "../lib/person";
---

<BaseLayout
  title={site.title.fa}
  description={site.description.fa}
  canonical={`${site.url}/`}
  lang="fa"
>

  <section class="hero">

    <div class="container hero-grid">

      <div class="hero-content">

        <p class="eyebrow">
          روان‌شناس و پژوهشگر
        </p>

        <h1>
          دکتر لیلا رضوی
        </h1>

        <p class="hero-description">
          پژوهش، روان‌شناسی و شناخت عمیق‌تر
          تجربه انسانی.
        </p>

        <div class="hero-actions">

          <a
            class="button button-primary"
            href="/about/"
          >
            درباره من
          </a>

          <a
            class="button button-secondary"
            href="/publications/"
          >
            آثار علمی
          </a>

        </div>

      </div>

      <div class="hero-image">

        <div class="image-placeholder">
          <span>
            عکس رسمی
          </span>
        </div>

      </div>

    </div>

  </section>


  <section class="intro">

    <div class="container narrow">

      <p class="section-label">
        درباره
      </p>

      <h2>
        دکتر لیلا رضوی
      </h2>

      <p class="large-text">
        دکتر لیلا رضوی، روان‌شناس و پژوهشگر،
        در حوزه روان‌شناسی و پژوهش‌های مرتبط
        با سلامت روان فعالیت می‌کند.
      </p>

      <a
        class="text-link"
        href="/about/"
      >
        مشاهده سوابق و معرفی کامل
        <span aria-hidden="true">←</span>
      </a>

    </div>

  </section>


  <section class="research-section">

    <div class="container">

      <div class="section-heading">

        <div>
          <p class="section-label">
            پژوهش
          </p>

          <h2>
            حوزه‌های پژوهشی
          </h2>
        </div>

        <a
          class="text-link"
          href="/research/"
        >
          مشاهده همه
        </a>

      </div>


      <div class="research-grid">

        {
          person.knowsAbout.map((area) => (
            <article class="research-card">
              <h3>{area}</h3>
            </article>
          ))
        }

      </div>

    </div>

  </section>


  <section class="publications-preview">

    <div class="container">

      <div class="section-heading">

        <div>
          <p class="section-label">
            آثار علمی
          </p>

          <h2>
            پژوهش‌ها و مقالات
          </h2>
        </div>

        <a
          class="text-link"
          href="/publications/"
        >
          مشاهده آثار علمی
        </a>

      </div>

      <div class="publication-placeholder">

        <p>
          آثار علمی و پژوهشی تأییدشده
          در این بخش قرار خواهند گرفت.
        </p>

      </div>

    </div>

  </section>


  <section class="cta">

    <div class="container">

      <div class="cta-inner">

        <div>

          <p class="section-label">
            ارتباط
          </p>

          <h2>
            برای اطلاعات بیشتر
          </h2>

        </div>

        <a
          class="button button-primary"
          href="/contact/"
        >
          اطلاعات تماس
        </a>

      </div>

    </div>

  </section>

</BaseLayout>


<style>
  .hero {
    padding-block:
      110px
      100px;

    border-bottom:
      1px solid #e5e1dc;
  }

  .hero-grid {
    display: grid;

    grid-template-columns:
      1.15fr
      0.85fr;

    align-items: center;

    gap: 80px;
  }

  .hero-content {
    max-width: 650px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 14px;

    color: #806f61;

    font-size: 0.78rem;

    font-weight: 600;

    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;

    font-size:
      clamp(3rem, 7vw, 5.6rem);

    line-height: 1.1;

    letter-spacing: -0.05em;

    font-weight: 500;
  }

  .hero-description {
    max-width: 520px;

    margin:
      28px
      0
      36px;

    color: #666;

    font-size: 1.2rem;

    line-height: 2;
  }

  .hero-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 12px;
  }

  .button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 46px;

    padding-inline: 24px;

    border: 1px solid #806f61;

    text-decoration: none;

    font-size: 0.88rem;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .button-primary {
    background: #806f61;

    color: white;
  }

  .button-primary:hover {
    background: #6e5e52;
  }

  .button-secondary {
    color: #806f61;
  }

  .button-secondary:hover {
    background: #eee9e4;
  }

  .hero-image {
    display: flex;

    justify-content: center;
  }

  .image-placeholder {
    width: min(
      100%,
      390px
    );

    aspect-ratio: 4 / 5;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #ebe6e0;

    color: #999;

    border-radius: 2px;
  }

  .intro {
    padding-block: 110px;
  }

  .narrow {
    max-width: 820px;
  }

  h2 {
    margin:
      0
      0
      24px;

    font-size:
      clamp(2rem, 4vw, 3.2rem);

    line-height: 1.25;

    letter-spacing: -0.04em;

    font-weight: 500;
  }

  .large-text {
    max-width: 760px;

    margin-bottom: 28px;

    color: #555;

    font-size: 1.15rem;

    line-height: 2.1;
  }

  .text-link {
    display: inline-flex;

    align-items: center;

    gap: 10px;

    color: #806f61;

    text-decoration: none;

    font-size: 0.88rem;

    font-weight: 600;
  }

  .text-link:hover {
    opacity: 0.7;
  }

  .research-section,
  .publications-preview {
    padding-block: 90px;

    border-top:
      1px solid #e5e1dc;
  }

  .section-heading {
    display: flex;

    align-items: end;

    justify-content: space-between;

    gap: 30px;

    margin-bottom: 44px;
  }

  .section-heading h2 {
    margin: 0;
  }

  .research-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 1px;

    background: #ddd7d0;

    border: 1px solid #ddd7d0;
  }

  .research-card {
    min-height: 150px;

    padding: 28px;

    background: #faf9f7;
  }

  .research-card h3 {
    margin: 0;

    font-size: 1.05rem;

    font-weight: 500;
  }

  .publication-placeholder {
    padding: 50px 30px;

    border: 1px solid #ddd7d0;

    color: #777;
  }

  .publication-placeholder p {
    margin: 0;
  }

  .cta {
    padding-block: 90px;
  }

  .cta-inner {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 40px;

    padding:
      50px
      60px;

    background: #eee9e4;
  }

  .cta-inner h2 {
    margin: 0;
  }

  @media (max-width: 800px) {
    .hero {
      padding-block: 70px;
    }

    .hero-grid {
      grid-template-columns: 1fr;

      gap: 50px;
    }

    .hero-image {
      justify-content: flex-start;
    }

    .research-grid {
      grid-template-columns: 1fr;
    }

    .section-heading,
    .cta-inner {
      align-items: flex-start;

      flex-direction: column;
    }

    .cta-inner {
      padding:
        36px
        28px;
    }
  }
</style>