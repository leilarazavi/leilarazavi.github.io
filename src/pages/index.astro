---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { site } from "../lib/site";
import { person } from "../lib/person";
import { podcast } from "../lib/media";

const entries = await getCollection("publications", ({ data }) => data.verified);
const publications = entries.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const focusAreas = person.knowsAbout.slice(1, 6);
---

<BaseLayout title={site.title.fa} description="وب‌سایت رسمی دکتر لیلا رضوی، روان‌شناس، مدرس دانشگاه و پژوهشگر حوزه روان‌شناسی." canonical={`${site.url}/`} lang="fa">
  <div>
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span>01</span> روان‌شناس · مدرس دانشگاه · پژوهشگر</p><h1 id="hero-title">دکتر لیلا رضوی</h1><p class="hero-lead">فعالیت حرفه‌ای در روان‌شناسی، آموزش و پژوهش؛ با تمرکز بر مداخلات روان‌شناختی، سلامت و کیفیت زندگی.</p><div class="hero-actions" aria-label="مسیرهای اصلی"><a class="button button-primary" href="/about/">درباره من <span aria-hidden="true">←</span></a><a class="quiet-link" href="/publications/">مشاهده آثار علمی <span aria-hidden="true">←</span></a></div></div><div class="hero-visual"><figure class="portrait-frame"><img src={person.image.src} alt={person.image.altFa} width="1018" height="1024" loading="eager" fetchpriority="high" decoding="async" /></figure><div class="portrait-caption"><span>Leila Razavi</span><span>Psychology · Research · Education</span></div></div></div>
    </section>
    <section class="intro" aria-labelledby="intro-title"><div class="container intro-grid"><div class="section-index">02</div><div class="intro-heading"><p class="section-label">رویکرد حرفه‌ای</p><h2 id="intro-title">روان‌شناسی، پژوهش و آموزش در یک مسیر حرفه‌ای</h2></div><div class="intro-copy"><p>{person.description.fa}</p><p class="intro-detail">این وب‌سایت مرجع رسمی برای شناخت مسیر حرفه‌ای، آثار علمی، فعالیت‌های پژوهشی و حضورهای رسانه‌ای است.</p><a class="quiet-link" href="/experience/">مشاهده فعالیت حرفه‌ای <span aria-hidden="true">←</span></a></div></div></section>
    <section class="focus" aria-labelledby="focus-title"><div class="container"><div class="section-topline"><div><p class="section-label">تمرکزهای تخصصی</p><h2 id="focus-title">حوزه‌هایی که فعالیت حرفه‌ای و پژوهشی را شکل می‌دهند</h2></div><span class="section-index">03</span></div><div class="focus-list">{focusAreas.map((area, index) => <a class="focus-item" href="/about/#research"><span class="focus-number">{String(index + 1).padStart(2, "0")}</span><span class="focus-name">{area}</span><span class="focus-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
    <section class="works" aria-labelledby="works-title"><div class="container"><div class="section-topline"><div><p class="section-label">پژوهش و آثار</p><h2 id="works-title">بخشی از مسیر علمی</h2></div><div class="section-action"><span class="section-index">04</span><a class="quiet-link" href="/publications/">همه آثار <span aria-hidden="true">←</span></a></div></div><div class="publication-list">{publications.slice(0, 3).map((publication, index) => <div class="publication-row"><span class="publication-index">{String(index + 1).padStart(2, "0")}</span><PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal} url={`/publications/${publication.id}/`} /></div>)}</div></div></section>
    <section class="professional" aria-labelledby="professional-title"><div class="container professional-shell"><div class="professional-label"><span class="section-index">05</span><p class="section-label">فعالیت حرفه‌ای</p></div><div class="professional-copy"><h2 id="professional-title">از فعالیت حرفه‌ای تا همکاری‌های سازمانی</h2><p>مسیر حرفه‌ای، سوابق، همکاری‌ها و نقش‌های سازمانی در یک نمای منسجم گردآوری شده‌اند تا تصویری روشن‌تر از فعالیت‌های حرفه‌ای ارائه شود.</p><div class="hero-actions"><a class="button button-dark" href="/experience/">فعالیت حرفه‌ای <span aria-hidden="true">←</span></a><a class="quiet-link" href="/organizations/">سازمان‌ها و همکاری‌ها <span aria-hidden="true">←</span></a></div></div></div></section>
    <section class="media" aria-labelledby="media-title"><div class="container media-grid"><div class="media-copy"><p class="section-label">رسانه</p><h2 id="media-title">صحبت جان</h2><p>{podcast.descriptionFa}</p><div class="hero-actions"><a class="button button-primary" href="/media/sohbat-jan/">معرفی پادکست <span aria-hidden="true">←</span></a><a class="quiet-link" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify <span aria-hidden="true">↗</span></a></div></div><div class="media-card" aria-hidden="true"><span class="media-number">06</span><span class="media-word">صحبت<br />جان</span><span class="media-caption">گفت‌وگو درباره تجربه انسانی</span></div></div></section>
    <section class="final-cta" aria-labelledby="final-cta-title"><div class="container final-cta-inner"><div><p class="section-label">منابع رسمی</p><h2 id="final-cta-title">برای شناخت کامل‌تر، از مسیرهای رسمی شروع کنید.</h2></div><a class="button button-dark" href="/contact/">پروفایل‌ها و راه‌های ارتباطی <span aria-hidden="true">←</span></a></div></section>
  </div>
</BaseLayout>

<style>
  .hero { padding-block: clamp(58px, 8vw, 104px) clamp(76px, 10vw, 132px); border-bottom: 1px solid var(--color-border); }.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .82fr); align-items: center; gap: clamp(48px, 9vw, 128px); }.hero-copy { max-width: 720px; }.eyebrow, .section-label { margin: 0; color: var(--color-accent-strong); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; }.eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }.eyebrow span, .section-index { color: var(--color-ink-faint); font-variant-numeric: tabular-nums; }.hero h1 { max-width: 700px; margin: 0; font-family: var(--font-heading); font-size: clamp(4rem, 8.5vw, 8.5rem); font-weight: 500; line-height: .95; letter-spacing: -.055em; }.hero-lead { max-width: 620px; margin: 34px 0 36px; color: var(--color-ink-muted); font-size: clamp(1.1rem, 1.6vw, 1.28rem); line-height: 2; }.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }.button { display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 50px; padding: 12px 22px; border: 1px solid transparent; text-decoration: none; font-size: var(--text-sm); font-weight: 700; transition: transform var(--transition-fast), background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast); }.button:hover { transform: translateY(-2px); }.button-primary { background: var(--color-accent); color: var(--color-surface); }.button-dark { background: var(--color-ink); color: var(--color-surface); }.quiet-link { color: var(--color-accent-strong); text-decoration: none; font-size: var(--text-sm); font-weight: 700; }.quiet-link:hover { text-decoration: underline; text-underline-offset: 5px; }.hero-visual { width: min(100%, 500px); justify-self: end; }.portrait-frame { position: relative; margin: 0; aspect-ratio: 1 / 1.06; overflow: hidden; background: var(--color-surface-muted); }.portrait-frame::after { position: absolute; inset: 14px; border: 1px solid color-mix(in srgb, white 62%, transparent); content: ""; pointer-events: none; }.portrait-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center 32%; }.portrait-caption { display: flex; justify-content: space-between; gap: 18px; padding-top: 12px; color: var(--color-ink-muted); font-size: .68rem; letter-spacing: .04em; }.intro { padding-block: clamp(82px, 11vw, 146px); }.intro-grid { display: grid; grid-template-columns: 54px minmax(260px, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 64px); }.intro h2, .section-topline h2, .professional h2, .media h2, .final-cta h2 { margin: 0; font-family: var(--font-heading); font-weight: 500; letter-spacing: -.025em; line-height: 1.35; }.intro h2 { margin-top: 14px; font-size: clamp(2rem, 3.4vw, 3.4rem); }.intro-copy { padding-top: 12px; }.intro-copy p { max-width: 690px; margin: 0; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 2.05; }.intro-copy .intro-detail { margin-top: 20px; font-size: var(--text-base); }.intro-copy .quiet-link { display: inline-block; margin-top: 28px; }.focus, .works { padding-block: clamp(80px, 10vw, 132px); border-top: 1px solid var(--color-border); }.section-topline { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; margin-bottom: 48px; }.section-topline h2 { max-width: 780px; margin-top: 12px; font-size: clamp(2rem, 3.2vw, 3.2rem); }.section-topline > .section-index { padding-bottom: 8px; }.section-action { display: flex; align-items: center; gap: 30px; padding-bottom: 8px; }.focus-list { border-top: 1px solid var(--color-border); }.focus-item { display: grid; grid-template-columns: 62px 1fr 28px; align-items: center; gap: 24px; min-height: 92px; border-bottom: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; transition: padding-inline var(--transition-fast), background var(--transition-fast); }.focus-item:hover { padding-inline: 14px; background: var(--color-surface-muted); }.focus-number { color: var(--color-accent); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }.focus-name { font-size: clamp(1rem, 1.5vw, 1.2rem); }.focus-arrow { color: var(--color-ink-faint); transition: transform var(--transition-fast), color var(--transition-fast); }.focus-item:hover .focus-arrow { color: var(--color-accent); transform: translate(-2px, -2px); }.publication-list { border-top: 1px solid var(--color-border); }.publication-row { display: grid; grid-template-columns: 62px 1fr; align-items: start; gap: 20px; padding-block: 8px; border-bottom: 1px solid var(--color-border); }.publication-index { padding-top: 26px; color: var(--color-accent); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }.publication-row :global(article) { border: 0; }.professional { padding-block: clamp(84px, 11vw, 140px); background: var(--color-ink); color: var(--color-surface); }.professional-shell { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: clamp(40px, 8vw, 120px); }.professional-label .section-label { margin-top: 18px; color: var(--color-accent-soft); }.professional h2 { max-width: 800px; font-size: clamp(2.4rem, 5vw, 5rem); }.professional-copy p { max-width: 680px; margin: 28px 0 34px; color: color-mix(in srgb, var(--color-surface) 72%, transparent); font-size: var(--text-lg); line-height: 2; }.professional .quiet-link { color: var(--color-accent-soft); }.media { padding-block: clamp(84px, 11vw, 140px); border-top: 1px solid var(--color-border); }.media-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .6fr); gap: clamp(48px, 9vw, 120px); align-items: center; }.media h2 { margin-top: 12px; font-size: clamp(3rem, 6vw, 6rem); }.media-copy > p:not(.section-label) { max-width: 680px; margin: 24px 0 34px; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 2; }.media-card { position: relative; min-height: 360px; display: flex; flex-direction: column; justify-content: space-between; padding: 28px; overflow: hidden; background: var(--color-accent-soft); color: var(--color-accent-strong); }.media-number { font-size: var(--text-xs); font-variant-numeric: tabular-nums; }.media-word { font-family: var(--font-heading); font-size: clamp(3.2rem, 6vw, 6rem); line-height: .9; letter-spacing: -.04em; }.media-caption { align-self: flex-end; font-size: var(--text-xs); }.final-cta { padding-block: clamp(72px, 9vw, 108px); }.final-cta-inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 48px; padding: clamp(38px, 5vw, 62px); background: var(--color-surface-muted); border: 1px solid var(--color-border); }.final-cta h2 { max-width: 760px; margin-top: 12px; font-size: clamp(2rem, 3.8vw, 3.8rem); }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; }.hero-visual { justify-self: start; width: min(100%, 560px); }.intro-grid { grid-template-columns: 40px 1fr; }.intro-copy { grid-column: 2; }.professional-shell { grid-template-columns: 1fr; }.professional-label { display: flex; align-items: center; gap: 18px; }.professional-label .section-label { margin-top: 0; }.media-grid { grid-template-columns: 1fr; }.media-card { min-height: 300px; }.final-cta-inner { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .hero { padding-top: 42px; }.hero h1 { font-size: clamp(3.4rem, 17vw, 5rem); }.hero-lead { margin-top: 24px; font-size: 1rem; }.hero-actions { align-items: flex-start; flex-direction: column; gap: 18px; }.button { width: 100%; }.portrait-caption { flex-direction: column; gap: 5px; }.intro-grid { grid-template-columns: 28px 1fr; gap: 16px; }.intro-copy { grid-column: 2; }.intro h2, .section-topline h2 { font-size: 2rem; }.section-topline { grid-template-columns: 1fr; gap: 12px; align-items: start; }.section-topline > .section-index { display: none; }.section-action { justify-content: space-between; padding-bottom: 0; }.focus-item { grid-template-columns: 42px 1fr 20px; min-height: 82px; gap: 12px; }.focus-item:hover { padding-inline: 8px; }.publication-row { grid-template-columns: 36px 1fr; gap: 10px; }.publication-index { padding-top: 22px; }.professional h2 { font-size: 2.5rem; }.media h2 { font-size: 3.6rem; }.media-card { min-height: 250px; padding: 22px; }.final-cta h2 { font-size: 2rem; } }
</style>
