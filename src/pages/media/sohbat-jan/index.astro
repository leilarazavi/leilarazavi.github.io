---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { podcast } from "../../../lib/media";
import { site } from "../../../lib/site";
import { getBreadcrumbSchema, getPodcastSeriesSchema } from "../../../lib/schema";

const url = `${site.url}/media/sohbat-jan/`;
const episodeUrls = podcast.episodes.map((episode) => `${url}${episode.slug}/`);
const schemas = [
  getPodcastSeriesSchema({ name: podcast.nameFa, description: podcast.descriptionFa, url, spotifyUrl: podcast.spotifyUrl, image: new URL(podcast.image, site.url).toString(), episodeUrls }),
  getBreadcrumbSchema([
    { name: "خانه", url: `${site.url}/` },
    { name: "رسانه و حضور عمومی", url: `${site.url}/media/` },
    { name: "صحبت جان", url },
  ]),
];

/*
 * MEDIA ENTITY DECISION
 *
 * The podcast has enough identity to deserve a dedicated series landing page.
 * It therefore stays separate from the general Media hub. The page acts as
 * the canonical series entity; individual episodes remain child URLs.
 */
---
<BaseLayout title={`پادکست صحبت جان | ${site.nameFa}`} description="پادکست صحبت جان با ارتباط مستقیم به دکتر لیلا رضوی؛ گفت‌وگوهایی درباره روان، رابطه و تجربه انسانی." canonical={url} lang="fa" schemas={schemas}>
  <section class="podcast-page">
    <div class="container">
      <header class="podcast-header">
        <div class="podcast-hero">
          <div>
            <p class="eyebrow">پادکست</p>
            <h1 class="text-display">صحبت جان</h1>
            <p class="text-lead">جایی برای گفت‌وگو درباره روان، رابطه و تجربه‌ی انسانی.</p>
            <a class="primary-action" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">شنیدن در Spotify ↗</a>
          </div>
          <img class="podcast-cover" src={podcast.image} alt="کاور پادکست صحبت جان" width="1200" height="1200" loading="eager" decoding="async" />
        </div>
      </header>

      <section class="about-podcast">
        <p class="eyebrow">درباره پادکست</p>
        <p>{podcast.aboutFa}</p>
      </section>

      <section class="episodes">
        <div class="section-head"><p class="eyebrow">قسمت‌ها</p><h2 class="text-heading">اپیزودهای صحبت جان</h2></div>
        <div class="episode-list">
          {podcast.episodes.map((episode) => (
            <article class="episode">
              <div class="episode-number">{String(episode.number).padStart(2, "0")}</div>
              <div>
                <h3><a href={`/media/sohbat-jan/${episode.slug}/`}>{episode.titleFa}</a></h3>
                <p>{episode.descriptionFa}</p>
                <a class="detail-link" href={`/media/sohbat-jan/${episode.slug}/`}>جزئیات قسمت ↗</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <nav class="related" aria-label="مسیرهای مرتبط">
        <p class="eyebrow">مرتبط با</p>
        <a href="/about/">دکتر لیلا رضوی ↗</a>
        <a href="/media/">رسانه و حضور عمومی ↗</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .podcast-page{padding-block:clamp(72px,9vw,110px)}.container{max-width:1000px}.podcast-header{padding-bottom:clamp(55px,8vw,85px);border-bottom:1px solid var(--color-border)}.podcast-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.48fr);gap:clamp(35px,7vw,80px);align-items:center}.podcast-header h1{margin-bottom:20px}.podcast-cover{width:100%;aspect-ratio:1;object-fit:cover;border:1px solid var(--color-border);background:var(--color-surface-muted)}.primary-action{display:inline-flex;margin-top:30px;min-height:48px;padding-inline:22px;align-items:center;background:var(--color-accent);color:var(--color-surface);text-decoration:none;font-size:var(--text-sm)}.about-podcast{max-width:760px;padding-block:55px;border-bottom:1px solid var(--color-border)}.about-podcast>p:last-child{margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2.1}.section-head{padding-block:60px 30px}.section-head h2{margin:0}.episode-list{border-top:1px solid var(--color-border)}.episode{display:grid;grid-template-columns:90px minmax(0,1fr);gap:35px;padding:30px 0;border-bottom:1px solid var(--color-border)}.episode-number{color:var(--color-accent);font-size:var(--text-sm);font-weight:700}.episode h3{margin:0 0 10px;font-size:var(--text-xl);font-weight:600}.episode h3 a{color:var(--color-ink);text-decoration:none}.episode p{margin:0 0 12px;color:var(--color-ink-muted);line-height:1.9}.detail-link{color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:600;text-decoration:none}.detail-link:hover{text-decoration:underline;text-underline-offset:5px}.related{display:flex;flex-wrap:wrap;gap:24px;padding-top:45px}.related .eyebrow{width:100%;margin-bottom:0}.related a{color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:600;text-decoration:none}@media(max-width:700px){.podcast-hero{grid-template-columns:1fr}.podcast-cover{max-width:420px;justify-self:center}}@media(max-width:560px){.episode{grid-template-columns:1fr;gap:10px}}
</style>
