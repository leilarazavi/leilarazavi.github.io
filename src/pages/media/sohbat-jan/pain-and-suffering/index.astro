---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { podcast } from "../../../../lib/media";
import { site } from "../../../../lib/site";
import { getBreadcrumbSchema, getPodcastEpisodeSchema } from "../../../../lib/schema";

const episode = podcast.episodes[0];
const url = `${site.url}/media/sohbat-jan/${episode.slug}/`;
const seriesUrl = `${site.url}/media/sohbat-jan/`;

const schemas = [
  getPodcastEpisodeSchema({
    name: episode.titleFa,
    description: episode.descriptionFa,
    url,
    spotifyUrl: episode.spotifyUrl,
    episodeNumber: episode.number,
    seriesUrl,
  }),
  getBreadcrumbSchema([
    { name: "خانه", url: `${site.url}/` },
    { name: "رسانه", url: `${site.url}/media/` },
    { name: "صحبت جان", url: seriesUrl },
    { name: episode.titleFa, url },
  ]),
];
---

<BaseLayout
  title={`${episode.titleFa} | صحبت جان | ${site.nameFa}`}
  description={episode.descriptionFa}
  canonical={url}
  lang="fa"
  type="article"
  schemas={schemas}
>
  <article class="page">
    <div class="container">
      <p class="eyebrow">پادکست صحبت جان · قسمت {episode.number}</p>
      <h1>{episode.titleFa}</h1>

      <p class="lead">
        رنج، تجربه‌ای مشترک میان همه‌ی انسان‌هاست؛ اما آنچه کیفیت زندگی ما را تغییر می‌دهد، فقط اتفاقاتی نیست که برایمان رخ می‌دهد، بلکه نحوه‌ی مواجهه‌ی ما با آن‌هاست.
      </p>

      <div class="actions">
        <a href={episode.spotifyUrl} target="_blank" rel="noopener noreferrer">شنیدن در Spotify ↗</a>
        <a href={seriesUrl}>مشاهده پادکست صحبت جان</a>
      </div>

      <section>
        <h2>درباره این اپیزود</h2>
        <p>{episode.descriptionFa}</p>
      </section>

      <section>
        <h2>موضوعات این قسمت</h2>
        <p>درد و رنج، پذیرش، مواجهه با احساسات ناخوشایند، معنا در سختی‌ها و نگاه ویکتور فرانکل به تجربه انسانی.</p>
      </section>

      <section class="note">
        <h2>توضیح مهم</h2>
        <p>{episode.disclaimerFa}</p>
      </section>

      <section>
        <h2>مرتبط با</h2>
        <p><a href={seriesUrl}>پادکست صحبت جان</a> و <a href="/about/">دکتر لیلا رضوی</a></p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
.page{padding-block:90px}.container{max-width:900px}.eyebrow{color:#806f61;font-weight:600}.lead{font-size:1.25rem;line-height:2;color:#555}h1{font-size:clamp(2.5rem,7vw,5rem);line-height:1.3;font-weight:500}.actions{display:flex;gap:14px;flex-wrap:wrap;margin:40px 0}.actions a{border:1px solid #806f61;padding:12px 18px;color:#806f61;text-decoration:none}section{padding:45px 0;border-top:1px solid #ddd7d0}h2{font-weight:500}p{line-height:2.1;color:#555}.note{background:#f3f0ec;padding-inline:24px}a{color:#806f61}
</style>
