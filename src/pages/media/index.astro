---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { podcast, professionalMedia } from "../../lib/media";
import { site } from "../../lib/site";
---
<BaseLayout title={`رسانه و حضور عمومی | ${site.nameFa}`} description="پادکست صحبت جان، گفت‌وگوها و منابع عمومی مرتبط با فعالیت حرفه‌ای دکتر لیلا رضوی." canonical={`${site.url}/media/`} lang="fa">
  <section class="page"><div class="container">
    <header><p class="label">رسانه و حضور عمومی</p><h1>پادکست، گفت‌وگوها و فعالیت‌های عمومی</h1><p class="lead">این بخش ردپای رسانه‌ای و عمومی دکتر لیلا رضوی را از آثار علمی و سوابق حرفه‌ای جدا می‌کند و برای هر منبع، لینک مستقیم به منبع اصلی ارائه می‌دهد.</p></header>
    <section class="featured"><p class="category">پادکست</p><h2>{podcast.nameFa}</h2><p>{podcast.descriptionFa}</p><div class="links"><a href="/media/sohbat-jan/">صفحه پادکست ↗</a><a href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify ↗</a></div></section>
    <section><h2>قسمت‌ها</h2><div class="media-list">{podcast.episodes.map((episode) => <article><p class="category">قسمت {episode.number}</p><h3><a href={`/media/sohbat-jan/${episode.slug}/`}>{episode.titleFa}</a></h3><p>{episode.descriptionFa}</p><a href={episode.spotifyUrl} target="_blank" rel="noopener noreferrer">شنیدن در Spotify ↗</a></article>)}</div></section>
    <section><h2>حضور حرفه‌ای و منابع عمومی</h2><div class="media-list">{professionalMedia.map((item) => <article><p class="category">{item.categoryFa}</p><h3>{item.titleFa}</h3><p>{item.descriptionFa}</p><a href={item.url} target="_blank" rel="noopener noreferrer">مشاهده منبع اصلی ↗</a></article>)}</div></section>
    <section class="identity"><h2>منابع هویت حرفه‌ای</h2><p>برای جلوگیری از اشتباه میان افراد هم‌نام، پروفایل‌های اصلی و منابع حرفه‌ای در داده‌های هویتی سایت نیز به یک شخص واحد متصل شده‌اند.</p><div class="links"><a href={person.profiles.googleScholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a><a href={person.profiles.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={person.profiles.pendar} target="_blank" rel="noopener noreferrer">پروفایل پندار ↗</a></div></section>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}.container{max-width:900px}header{max-width:820px;padding-bottom:55px}.label,.category{color:#806f61;font-size:.8rem;font-weight:600}.label{margin-bottom:12px}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.3;font-weight:500}.lead,p{color:#555;line-height:2}.featured,section:not(:first-child){padding:42px 0;border-top:1px solid #ddd7d0}.featured h2,section>h2{font-size:2rem;font-weight:500}.featured p{max-width:800px}.media-list article{padding:30px 0;border-top:1px solid #e4dfda}.media-list h3{font-size:1.4rem;font-weight:500}.media-list h3 a{color:#222;text-decoration:none}.media-list a,.links a{color:#806f61;font-weight:600}.links{display:flex;flex-wrap:wrap;gap:22px;margin-top:24px}.identity{padding-bottom:30px}
</style>
