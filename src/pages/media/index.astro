---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { site } from "../../lib/site";

const media = [
  {
    category: "گفت‌وگو و پادکست",
    title: "حضور دکتر لیلا رضوی در پادکست Spotify",
    description: "صفحه رسمی برنامه در Spotify؛ برای جزئیات قسمت‌ها و محتوای منتشرشده به صفحه برنامه مراجعه کنید.",
    url: "https://open.spotify.com/show/033SHyU9h8ewYbibDIUBfL",
  },
  {
    category: "حضور حرفه‌ای و عمومی",
    title: "نشست هم‌افزایی نهادهای تخصصی روان‌شناسی استان قم",
    description: "اطلاع‌رسانی عمومی نشست با حضور مدیران و نمایندگان نهادهای تخصصی روان‌شناسی استان قم.",
    url: "https://www.instagram.com/p/DbQ_uuvMC9i/",
  },
  {
    category: "حضور حرفه‌ای و عمومی",
    title: "شورای مرکزی مدرسه روان‌شناسی در استان قم",
    description: "معرفی عمومی اعضای شورای مرکزی مدرسه روان‌شناسی در استان قم.",
    url: "https://www.instagram.com/p/Da8wE5kE1Es/",
  },
  {
    category: "حضور حرفه‌ای و عمومی",
    title: "منبع عمومی تکمیلی",
    description: "منبع عمومی دیگری مرتبط با فعالیت حرفه‌ای و حضور تخصصی دکتر لیلا رضوی.",
    url: "https://www.instagram.com/p/DcKDxZlvQz6/",
  },
];
---

<BaseLayout title={`رسانه و حضور عمومی | ${site.nameFa}`} description="گفت‌وگوها، پادکست‌ها و منابع عمومی مرتبط با فعالیت حرفه‌ای دکتر لیلا رضوی." canonical={`${site.url}/media/`} lang="fa">
  <section class="page"><div class="container">
    <header><p class="label">رسانه و حضور عمومی</p><h1>گفت‌وگوها و منابع عمومی</h1><p class="lead">منابع رسانه‌ای و عمومی مرتبط با {person.fullNameFa}، جدا از آثار علمی و سوابق حرفه‌ای.</p></header>
    <div class="media-list">
      {media.map((item) => (
        <article class="media-item">
          <p class="category">{item.category}</p>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
          <a href={item.url} target="_blank" rel="noopener noreferrer">مشاهده منبع</a>
        </article>
      ))}
    </div>
  </div></section>
</BaseLayout>

<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:60px}.label,.category{color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead,p{color:#555;line-height:2}.media-list{max-width:820px}.media-item{padding:34px 0;border-top:1px solid #ddd7d0}.media-item h2{font-size:1.45rem;font-weight:500}.media-item .category{margin-bottom:8px}.media-item a{color:#806f61}
</style>
