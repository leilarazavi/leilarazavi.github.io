---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { podcast, professionalMedia } from "../../lib/media";
import { site } from "../../lib/site";
---

<BaseLayout title={`رسانه و حضور عمومی | ${site.nameFa}`} description="پادکست صحبت جان، گفت‌وگوها و منابع عمومی مرتبط با فعالیت حرفه‌ای دکتر لیلا رضوی." canonical={`${site.url}/media/`} lang="fa">
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title"><div class="container about-hero-grid"><div class="about-copy"><p class="eyebrow"><span>01</span> رسانه و حضور عمومی</p><h1 id="about-title">پادکست، گفت‌وگوها و فعالیت‌های عمومی</h1><p class="about-lead">ردپای رسانه‌ای و عمومی دکتر لیلا رضوی، با لینک مستقیم به منبع اصلی هر محتوا.</p></div></div></section>
    <section class="featured"><div><p class="category">پادکست</p><h2>{podcast.nameFa}</h2><p>{podcast.descriptionFa}</p><div class="links"><a class="button" href="/media/sohbat-jan/">صفحه پادکست</a><a class="text-link" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify ↗</a></div></div><div class="feature-mark" aria-hidden="true">صحبت<br />جان</div></section>
    <section><div class="section-heading"><div><p class="label">قسمت‌ها</p><h2>اپیزودهای پادکست</h2></div></div><div class="media-list">{podcast.episodes.map((episode) => <article><div class="episode-meta"><span>قسمت {episode.number}</span></div><div><h3><a href={`/media/sohbat-jan/${episode.slug}/`}>{episode.titleFa}</a></h3><p>{episode.descriptionFa}</p><a class="text-link" href={episode.spotifyUrl} target="_blank" rel="noopener noreferrer">شنیدن در Spotify ↗</a></div></article>)}</div></section>
    <section><div class="section-heading"><div><p class="label">حضور حرفه‌ای</p><h2>منابع عمومی و رسانه‌ای</h2></div></div><div class="media-list">{professionalMedia.map((item) => <article><div class="episode-meta"><span>{item.categoryFa}</span></div><div><h3>{item.titleFa}</h3><p>{item.descriptionFa}</p><a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">مشاهده منبع اصلی ↗</a></div></article>)}</div></section>
    <section class="identity"><p class="label">هویت حرفه‌ای</p><h2>منابعی که این پروفایل را تکمیل می‌کنند</h2><p>برای ایجاد یک هویت دیجیتال منسجم، منابع علمی و حرفه‌ای اصلی به یک شخص واحد متصل شده‌اند.</p><div class="identity-links"><a href={person.profiles.googleScholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a><a href={person.profiles.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={person.profiles.pendar} target="_blank" rel="noopener noreferrer">پروفایل پندار ↗</a></div></section>
  </div>
</BaseLayout>

<style>
  .about-page{overflow:clip}.about-hero{padding-block:clamp(68px,9vw,120px);border-bottom:1px solid var(--color-border)}.about-hero-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(48px,9vw,130px);align-items:center}.about-copy{max-width:760px}.about-copy h1{margin:0;font-size:var(--text-display);line-height:1.08;font-weight:500;letter-spacing:-.045em}.about-lead{max-width:680px;margin:28px 0 0;color:var(--color-ink-muted);font-size:clamp(1.05rem,1.5vw,1.2rem);line-height:2}.eyebrow{display:flex;align-items:center;gap:12px;margin:0 0 22px;color:var(--color-accent-strong);font-size:var(--text-xs);font-weight:700;letter-spacing:.08em}.eyebrow span{color:var(--color-ink-faint);font-variant-numeric:tabular-nums}.page{padding-block:clamp(72px,9vw,110px)}.container{max-width:1080px}.featured{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.55fr);gap:60px;align-items:center;padding:clamp(35px,5vw,60px) 0;border-block:1px solid var(--color-border)}.featured h2,.section-heading h2,.identity h2{margin:0 0 20px;font-size:var(--text-title);font-weight:500}.featured p:not(.category),.identity>p{max-width:750px;color:var(--color-ink-muted);line-height:2}.category{margin:0 0 10px;color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.links{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:28px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding-inline:24px;background:var(--color-accent);color:var(--color-surface);text-decoration:none;font-size:var(--text-sm)}.text-link{color:var(--color-accent-strong);font-size:var(--text-sm);text-decoration:none}.text-link:hover{text-decoration:underline;text-underline-offset:5px}.feature-mark{min-height:250px;display:grid;place-items:center;border:1px solid var(--color-border-strong);color:var(--color-accent);font-size:clamp(2.5rem,6vw,5rem);line-height:1.2;font-weight:500;text-align:center}.page section:not(.featured):not(.about-hero){padding-block:clamp(65px,8vw,95px);border-bottom:1px solid var(--color-border)}.section-heading{margin-bottom:35px}.media-list{border-top:1px solid var(--color-border)}.media-list article{display:grid;grid-template-columns:150px minmax(0,1fr);gap:35px;padding:28px 0;border-bottom:1px solid var(--color-border)}.episode-meta{color:var(--color-accent);font-size:var(--text-sm)}.media-list h3{margin:0 0 12px;font-size:var(--text-lg);line-height:1.6;font-weight:500}.media-list h3 a{color:var(--color-ink);text-decoration:none}.media-list p{margin:0 0 12px;color:var(--color-ink-muted);line-height:1.9}.identity{border-bottom:0!important}.identity-links{display:flex;flex-wrap:wrap;gap:22px;margin-top:28px}.identity-links a{color:var(--color-accent-strong);text-decoration:none;font-size:var(--text-sm)}@media(max-width:700px){.featured{grid-template-columns:1fr}.media-list article{grid-template-columns:1fr;gap:10px}.feature-mark{min-height:210px}}@media(max-width:480px){.links{align-items:flex-start;flex-direction:column}.button{width:100%}}
</style>
