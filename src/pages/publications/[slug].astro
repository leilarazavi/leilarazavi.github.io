---
import {
  getCollection,
  render,
} from "astro:content";

import PublicationLayout from "../../layouts/PublicationLayout.astro";

import { site } from "../../lib/site";

export async function getStaticPaths() {
  const publications =
    await getCollection("publications");

  return publications
    .filter(
      (publication) =>
        publication.data.verified === true,
    )
    .map((publication) => ({
      params: {
        slug: publication.id,
      },

      props: {
        publication,
      },
    }));
}

const { publication } = Astro.props;

const { Content } =
  await render(publication);

const data = publication.data;

const canonical =
  `${site.url}/publications/${publication.id}/`;
---

<PublicationLayout
  title={data.title}
  description={data.abstract}
  canonical={canonical}
  year={data.year}
  authors={data.authors}
  journal={data.journal}
  doi={data.doi}
  publisher={data.publisher}
  language={data.language}
>

  <Content />

</PublicationLayout>