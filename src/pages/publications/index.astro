---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { site } from "../../lib/site";

const entries = await getCollection("publications", ({ data }) => data.verified && data.status !== "rejected");
const publications = entries.sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const years = [...new Set(publications.map(({ data }) => data.year).filter((year): year is number => year !== undefined))].sort((a, b) => b - a);
---

<BaseLayout title={`آثار علمی | ${site.nameFa}`} description="فهرست مقالات، کتاب‌ها و آثار علمی تأییدشده دکتر لیلا رضوی، همراه با DOI و منابع راستی‌آزمایی." canonical={`${site.url}/publications/`} lang="fa">
  <main class="publications-page">
    <section class="publications-hero" aria-labelledby="publications-title">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow"><span>01</span> پژوهش و آثار</p>
          <h1 id="publications-title" class="hero-title">مقالات، کتاب‌ها و پژوهش‌ها</h1>
        </div>
        <div class="hero-copy">
          <p>آثار علمی تأییدشده در اینجا به‌عنوان بخشی از مسیر پژوهشی دکتر لیلا رضوی گردآوری شده‌اند؛ همراه با اطلاعات کتاب‌شناختی و منابع راستی‌آزمایی.</p>
          <p class="hero-note">جست‌وجو و فیلتر برای پیدا کردن سریع‌تر هر اثر در دسترس است.</p>
        </div>
      </div>
    </section>

    <section class="catalog" aria-labelledby="catalog-title">
      <div class="container">
        <div class="catalog-head">
          <div>
            <p class="section-label">فهرست آثار</p>
            <h2 id="catalog-title">آثار علمی</h2>
          </div>
          <span class="result-count" aria-live="polite"><strong id="visible-count">{publications.length}</strong> اثر</span>
        </div>

        <div class="filters" aria-label="فیلتر و جست‌وجوی آثار علمی">
          <label class="search-field" for="search-filter"><span>جست‌وجو</span><input id="search-filter" type="search" placeholder="عنوان، نویسنده یا کلیدواژه" autocomplete="off" /></label>
          <label for="type-filter"><span>نوع اثر</span><select id="type-filter"><option value="all">همه</option><option value="journal-article">مقالات</option><option value="book">کتاب‌ها</option><option value="book-chapter">فصل کتاب</option><option value="conference-paper">همایش</option></select></label>
          <label for="year-filter"><span>سال</span><select id="year-filter"><option value="all">همه سال‌ها</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
          <label for="sort-filter"><span>مرتب‌سازی</span><select id="sort-filter"><option value="newest">جدیدترین</option><option value="oldest">قدیمی‌ترین</option><option value="featured">منتخب</option></select></label>
        </div>

        <div class="publication-list" id="publication-list">
          {publications.map((publication, index) => (
            <article class="publication-entry" data-index={index} data-type={publication.data.type} data-year={publication.data.year ?? "unknown"} data-featured={publication.data.featured ? "true" : "false"} data-search={`${publication.data.title} ${publication.data.titleFa ?? ""} ${publication.data.authors.join(" ")} ${publication.data.journal ?? ""} ${publication.data.keywords.join(" ")}`.toLowerCase()}>
              <div class="publication-marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
              <PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal ?? publication.data.publisher} url={`/publications/${publication.id}/`} />
            </article>
          ))}
        </div>
        <p id="empty-results" class="empty-state" hidden>اثری با این معیارها پیدا نشد.</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const searchFilter = document.querySelector<HTMLInputElement>("#search-filter");
  const typeFilter = document.querySelector<HTMLSelectElement>("#type-filter");
  const yearFilter = document.querySelector<HTMLSelectElement>("#year-filter");
  const sortFilter = document.querySelector<HTMLSelectElement>("#sort-filter");
  const list = document.querySelector<HTMLElement>("#publication-list");
  const entries = [...document.querySelectorAll<HTMLElement>(".publication-entry")];
  const empty = document.querySelector<HTMLElement>("#empty-results");
  const visibleCount = document.querySelector<HTMLElement>("#visible-count");
  function applyFilters() {
    const query = searchFilter?.value.trim().toLowerCase() ?? "";
    const type = typeFilter?.value ?? "all";
    const year = yearFilter?.value ?? "all";
    const sort = sortFilter?.value ?? "newest";
    const visible = entries.filter((entry) => !query || (entry.dataset.search ?? "").includes(query)).filter((entry) => type === "all" || entry.dataset.type === type).filter((entry) => year === "all" || entry.dataset.year === year);
    const order = (entry: HTMLElement) => Number(entry.dataset.year ?? -Infinity);
    [...entries].sort((a, b) => sort === "featured" ? Number(b.dataset.featured === "true") - Number(a.dataset.featured === "true") || order(b) - order(a) : sort === "oldest" ? order(a) - order(b) : order(b) - order(a)).forEach((entry) => list?.appendChild(entry));
    entries.forEach((entry) => { entry.hidden = !visible.includes(entry); });
    if (empty) empty.hidden = visible.length !== 0;
    if (visibleCount) visibleCount.textContent = String(visible.length);
  }
  [searchFilter, typeFilter, yearFilter, sortFilter].forEach((control) => control?.addEventListener("input", applyFilters));
  [typeFilter, yearFilter, sortFilter].forEach((control) => control?.addEventListener("change", applyFilters));
</script>

<style>
  .publications-page { overflow: clip; }
  .publications-hero { padding-block: clamp(68px, 9vw, 118px); border-bottom: 1px solid var(--color-border); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(300px, .75fr); gap: clamp(48px, 9vw, 130px); align-items: end; }
  .hero-copy { max-width: 650px; color: var(--color-ink-muted); font-size: var(--text-lg); line-height: 2; }
  .hero-copy p { margin: 0 0 20px; }
  .hero-note { color: var(--color-accent-strong); font-size: var(--text-sm); font-weight: 600; }
  .catalog { padding-block: clamp(72px, 9vw, 110px); }
  .catalog-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
  .catalog-head h2 { margin: 0; font-size: var(--text-title); line-height: 1.3; font-weight: 500; }
  .result-count { color: var(--color-ink-muted); font-size: var(--text-sm); }
  .result-count strong { color: var(--color-accent); font-size: 1.1rem; }
  .filters { display: grid; grid-template-columns: minmax(240px, 1.6fr) repeat(3, minmax(150px, 1fr)); gap: 14px; padding-block: 20px; margin-bottom: 14px; border-block: 1px solid var(--color-border); }
  .filters label { display: grid; gap: 7px; color: var(--color-accent); font-size: var(--text-xs); font-weight: 700; }
  .filters input, .filters select { width: 100%; min-width: 0; box-sizing: border-box; min-height: 46px; padding: 8px 13px; border: 1px solid var(--color-border); border-radius: 0; background: var(--color-bg); color: var(--color-ink); font: inherit; }
  .filters input::placeholder { color: var(--color-ink-muted); opacity: .75; }
  .filters input:focus, .filters select:focus { outline: 2px solid color-mix(in srgb, var(--color-accent) 28%, transparent); outline-offset: 1px; border-color: var(--color-accent); }
  .publication-list { display: grid; }
  .publication-entry { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 18px; }
  .publication-entry[hidden] { display: none; }
  .publication-marker { padding-top: 30px; color: var(--color-accent); font-size: var(--text-xs); font-weight: 700; font-variant-numeric: tabular-nums; }
  .empty-state { padding: 30px 0; color: var(--color-ink-muted); }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .catalog-head { align-items: flex-start; flex-direction: column; } .filters { grid-template-columns: 1fr 1fr; } .search-field { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .filters { grid-template-columns: 1fr; } .search-field { grid-column: auto; } .publication-entry { grid-template-columns: 36px minmax(0, 1fr); gap: 8px; } }
</style>
