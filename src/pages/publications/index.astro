---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { getCollection } from "astro:content";
import { site } from "../../lib/site";

const entries = await getCollection("publications", ({ data }) => data.verified && data.status !== "rejected");
const publications = entries.sort((a, b) => (b.data.year ?? -Infinity) - (a.data.year ?? -Infinity));
const years = [...new Set(publications.map(({ data }) => data.year).filter((year): year is number => year !== undefined))].sort((a, b) => b - a);
---

<BaseLayout title={`آثار علمی | ${site.nameFa}`} description="فهرست مقالات، کتاب‌ها و آثار علمی تأییدشده دکتر لیلا رضوی، همراه با DOI و منابع راستی‌آزمایی." canonical={`${site.url}/publications/`} lang="fa">
  <!-- Publications remains a primary SEO destination. The redesign changes hierarchy and visual clarity, not its URL or structured content model. -->
  <section class="publications-page">
    <div class="container">
      <header class="page-header">
        <p class="section-label">پژوهش و آثار</p>
        <h1>مقالات، کتاب‌ها و پژوهش‌ها</h1>
        <p>آثار تأییدشده را بر اساس نوع، سال یا کلیدواژه جست‌وجو و بررسی کنید.</p>
      </header>

      <div class="filters" aria-label="فیلتر و جست‌وجوی آثار علمی">
        <label class="search-field"><span>جست‌وجو</span><input id="search-filter" type="search" placeholder="مثلاً ADHD یا depression" autocomplete="off" /></label>
        <label><span>نوع اثر</span><select id="type-filter"><option value="all">همه</option><option value="journal-article">مقالات</option><option value="book">کتاب‌ها</option><option value="book-chapter">فصل کتاب</option><option value="conference-paper">همایش</option></select></label>
        <label><span>سال</span><select id="year-filter"><option value="all">همه سال‌ها</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
        <label><span>مرتب‌سازی</span><select id="sort-filter"><option value="newest">جدیدترین</option><option value="oldest">قدیمی‌ترین</option><option value="featured">منتخب</option></select></label>
      </div>

      <div class="publication-list" id="publication-list">
        {publications.map((publication) => (
          <article class="publication-entry" data-type={publication.data.type} data-year={publication.data.year ?? "unknown"} data-featured={publication.data.featured ? "true" : "false"} data-search={`${publication.data.title} ${publication.data.titleFa ?? ""} ${publication.data.authors.join(" ")} ${publication.data.journal ?? ""} ${publication.data.keywords.join(" ")}`.toLowerCase()}>
            <PublicationCard title={publication.data.title} titleFa={publication.data.titleFa} authors={publication.data.authors} year={publication.data.year} journal={publication.data.journal ?? publication.data.publisher} url={`/publications/${publication.id}/`} />
          </article>
        ))}
      </div>
      <p id="empty-results" class="empty-state" hidden>اثری با این معیارها پیدا نشد.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const searchFilter = document.querySelector<HTMLInputElement>("#search-filter");
  const typeFilter = document.querySelector<HTMLSelectElement>("#type-filter");
  const yearFilter = document.querySelector<HTMLSelectElement>("#year-filter");
  const sortFilter = document.querySelector<HTMLSelectElement>("#sort-filter");
  const list = document.querySelector<HTMLElement>("#publication-list");
  const entries = [...document.querySelectorAll<HTMLElement>(".publication-entry")];
  const empty = document.querySelector<HTMLElement>("#empty-results");

  function applyFilters() {
    const query = searchFilter?.value.trim().toLowerCase() ?? "";
    const type = typeFilter?.value ?? "all";
    const year = yearFilter?.value ?? "all";
    const sort = sortFilter?.value ?? "newest";
    const visible = entries.filter((entry) => !query || (entry.dataset.search ?? "").includes(query))
      .filter((entry) => type === "all" || entry.dataset.type === type)
      .filter((entry) => year === "all" || entry.dataset.year === year);
    const order = (entry: HTMLElement) => Number(entry.dataset.year ?? -Infinity);
    [...entries].sort((a, b) => sort === "featured" ? Number(b.dataset.featured === "true") - Number(a.dataset.featured === "true") || order(b) - order(a) : sort === "oldest" ? order(a) - order(b) : order(b) - order(a)).forEach((entry) => list?.appendChild(entry));
    entries.forEach((entry) => { entry.hidden = !visible.includes(entry); });
    if (empty) empty.hidden = visible.length !== 0;
  }
  [searchFilter, typeFilter, yearFilter, sortFilter].forEach((control) => control?.addEventListener("input", applyFilters));
  [typeFilter, yearFilter, sortFilter].forEach((control) => control?.addEventListener("change", applyFilters));
</script>

<style>
  .publications-page{padding-block:clamp(72px,9vw,110px)}.page-header{max-width:850px;padding-bottom:50px}.section-label{margin:0 0 var(--space-4);color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.page-header h1{margin:0 0 24px;font-size:var(--text-display);line-height:1.15;font-weight:500;letter-spacing:-.04em}.page-header>p:last-child{max-width:720px;margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.filters{display:grid;grid-template-columns:minmax(240px,1.5fr) repeat(3,minmax(150px,1fr));gap:14px;padding:20px 0;margin-bottom:15px;border-block:1px solid var(--color-border)}.filters label{display:grid;gap:7px;color:var(--color-accent);font-size:var(--text-xs);font-weight:700}.filters input,.filters select{width:100%;min-width:0;box-sizing:border-box;min-height:44px;padding:8px 12px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-ink);font:inherit}.filters input:focus,.filters select:focus{border-color:var(--color-accent)}.publication-list{display:grid;gap:1px}.publication-entry[hidden]{display:none}.empty-state{padding:30px 0;color:var(--color-ink-muted)}@media(max-width:800px){.filters{grid-template-columns:1fr 1fr}.search-field{grid-column:1/-1}}@media(max-width:520px){.filters{grid-template-columns:1fr}.search-field{grid-column:auto}}
</style>
