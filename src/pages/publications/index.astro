---
import {
  getCollection,
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import PublicationCard from "../../components/PublicationCard.astro";

import { site } from "../../lib/site";

const publications =
  await getCollection(
    "publications",
    ({ data }) => data.verified === true,
  );

const sortedPublications =
  publications.sort(
    (a, b) =>
      b.data.year - a.data.year,
  );
---

<BaseLayout
  title={`آثار علمی | ${site.nameFa}`}
  description="فهرست مقالات و آثار علمی تأییدشده دکتر لیلا رضوی."
  canonical={`${site.url}/publications/`}
  lang="fa"
>

  <section class="publications-page">

    <div class="container">

      <header class="page-header">

        <p class="section-label">
          آثار علمی
        </p>

        <h1>
          مقالات و پژوهش‌ها
        </h1>

        <p>
          فهرست آثار علمی و پژوهشی تأییدشده
          دکتر لیلا رضوی.
        </p>

      </header>


      <div class="publication-list">

        {
          sortedPublications.length > 0 ? (
            sortedPublications.map(
              (publication) => (
                <PublicationCard
                  title={publication.data.title}
                  titleFa={
                    publication.data.titleFa
                  }
                  authors={
                    publication.data.authors
                  }
                  year={
                    publication.data.year
                  }
                  journal={
                    publication.data.journal
                  }
                  url={`/publications/${publication.id}/`}
                  featured={
                    publication.data.featured
                  }
                />
              ),
            )
          ) : (
            <div class="empty-state">
              آثار علمی تأییدشده
              به‌زودی در این بخش قرار می‌گیرند.
            </div>
          )
        }

      </div>

    </div>

  </section>

</BaseLayout>


<style>
  .publications-page {
    padding-block: 90px;
  }

  .page-header {
    max-width: 800px;

    margin-bottom: 70px;
  }

  .section-label {
    margin: 0 0 14px;

    color: #806f61;

    font-size: 0.78rem;

    font-weight: 600;

    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0 0 20px;

    font-size:
      clamp(2.5rem, 6vw, 4.5rem);

    line-height: 1.2;

    letter-spacing: -0.05em;

    font-weight: 500;
  }

  .page-header > p:last-child {
    color: #666;

    font-size: 1.05rem;
  }

  .publication-list {
    max-width: 950px;
  }

  .empty-state {
    padding: 40px;

    border: 1px solid #ddd7d0;

    color: #777;
  }
</style>