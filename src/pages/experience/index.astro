---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { site } from "../../lib/site";
---

<BaseLayout title={`فعالیت حرفه‌ای | ${site.nameFa}`} description="نقش‌ها، وابستگی‌ها و فعالیت‌های حرفه‌ای عمومی و قابل‌راستی‌آزمایی دکتر لیلا رضوی." canonical={`${site.url}/experience/`} lang="fa">
  <!-- Experience is the detailed professional layer. It intentionally does not duplicate the CV as the primary narrative. -->
  <section class="page"><div class="container">
    <header><p class="label">فعالیت حرفه‌ای</p><h1>نقش‌ها و فعالیت‌های حرفه‌ای</h1><p class="lead">{person.description.fa}</p></header>
    <section><div class="section-heading"><p class="label">سوابق مستند</p><h2>نقش‌ها و مسئولیت‌ها</h2></div><div class="timeline">{person.positions.map((position, index) => <article class="activity"><span>{String(index + 1).padStart(2,"0")}</span><div><h3>{position.titleFa}</h3><p>{position.organizationFa}</p><a href={position.source} target="_blank" rel="noopener noreferrer">مشاهده منبع عمومی ↗</a></div></article>)}</div></section>
    <section><div class="section-heading"><p class="label">وابستگی‌ها</p><h2>همکاری‌ها و سازمان‌ها</h2></div><div class="affiliations">{person.affiliations.map((affiliation, index) => <a href={affiliation.url} target="_blank" rel="noopener noreferrer"><span>{String(index + 1).padStart(2,"0")}</span><strong>{affiliation.name}</strong><b aria-hidden="true">↗</b></a>)}</div><a class="secondary-link" href="/organizations/">جزئیات سازمان‌ها و ساختار همکاری‌ها →</a></section>
    <section class="cv-cta"><div><p class="label">رزومه</p><h2>نسخه فشرده سوابق حرفه‌ای</h2></div><a class="button" href="/cv/">مشاهده CV →</a></section>
  </div></section>
</BaseLayout>

<style>
  .page{padding-block:clamp(72px,9vw,110px)}header{max-width:900px;padding-bottom:clamp(55px,7vw,80px)}.label{margin:0 0 var(--space-4);color:var(--color-accent);font-size:var(--text-xs);font-weight:700}h1{margin:0 0 24px;font-size:var(--text-display);line-height:1.15;font-weight:500;letter-spacing:-.04em}.lead{max-width:760px;margin:0;color:var(--color-ink-muted);font-size:var(--text-lg);line-height:2}.page>section{padding-block:clamp(55px,7vw,85px);border-top:1px solid var(--color-border)}.section-heading{margin-bottom:32px}.section-heading h2,.cv-cta h2{margin:0;font-size:var(--text-title);font-weight:500}.timeline{border-top:1px solid var(--color-border)}.activity{display:grid;grid-template-columns:50px 1fr;gap:20px;padding:28px 0;border-bottom:1px solid var(--color-border)}.activity>span{color:var(--color-accent);font-size:var(--text-xs);padding-top:5px}.activity h3{margin:0;font-size:var(--text-lg);font-weight:600}.activity p{margin:6px 0;color:var(--color-ink-muted);line-height:1.8}.activity a,.secondary-link{color:var(--color-accent-strong);font-size:var(--text-sm);text-decoration:none}.affiliations{border-top:1px solid var(--color-border);max-width:900px}.affiliations a{display:grid;grid-template-columns:50px 1fr 30px;align-items:center;gap:18px;padding:24px 0;border-bottom:1px solid var(--color-border);color:var(--color-ink);text-decoration:none}.affiliations a:hover strong{color:var(--color-accent-strong)}.affiliations span{color:var(--color-accent);font-size:var(--text-xs)}.affiliations strong{font-size:var(--text-lg);font-weight:500}.affiliations b{color:var(--color-accent);font-weight:400;text-align:end}.secondary-link{display:inline-block;margin-top:26px}.cv-cta{display:flex!important;align-items:center;justify-content:space-between;gap:30px;padding:40px!important;background:var(--color-surface-muted)}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding-inline:24px;background:var(--color-accent);color:var(--color-surface);text-decoration:none;font-size:var(--text-sm)}@media(max-width:600px){.cv-cta{align-items:flex-start!important;flex-direction:column}.button{width:100%}.activity{grid-template-columns:36px 1fr}}
</style>
