---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { site } from "../../lib/site";

const activities = [
  {
    title: "شورای مرکزی مدرسه روان‌شناسی در استان قم",
    description: "دکتر لیلا رضوی در فهرست اعضای شورای مرکزی مدرسه روان‌شناسی در استان قم معرفی شده است.",
    source: "https://www.instagram.com/p/Da8wE5kE1Es/",
    sourceLabel: "منبع عمومی معرفی شورا",
  },
  {
    title: "انجمن صنفی کارفرمایی مراکز مشاوره قم",
    description: "در اطلاع‌رسانی نشست هم‌افزایی نهادهای تخصصی روان‌شناسی استان قم، از دکتر لیلا رضوی به عنوان معاون انجمن صنفی کارفرمایی مراکز مشاوره قم نام برده شده است.",
    source: "https://www.instagram.com/p/DbQ_uuvMC9i/",
    sourceLabel: "منبع عمومی نشست",
  },
  {
    title: "نشست‌های تخصصی و هم‌افزایی روان‌شناسی در قم",
    description: "حضور در نشست‌های تخصصی با مشارکت نهادها و چهره‌های حرفه‌ای روان‌شناسی استان قم، با محوریت ارتقای کیفیت خدمات و انسجام ظرفیت‌های تخصصی.",
    source: "https://www.instagram.com/p/DbQ_uuvMC9i/",
    sourceLabel: "نمونه منبع عمومی",
  },
];
---

<BaseLayout title={`سوابق و فعالیت‌های حرفه‌ای | ${site.nameFa}`} description="سوابق حرفه‌ای، عضویت‌های تخصصی و فعالیت‌های عمومی تأییدشده دکتر لیلا رضوی در حوزه روان‌شناسی." canonical={`${site.url}/experience/`} lang="fa">
  <section class="page"><div class="container">
    <header>
      <p class="label">سوابق و فعالیت‌های حرفه‌ای</p>
      <h1>فعالیت‌های تخصصی و حرفه‌ای</h1>
      <p class="lead">{person.description.fa}</p>
    </header>

    <section class="category">
      <h2>نقش‌ها و عضویت‌های تخصصی</h2>
      {activities.map((activity) => (
        <article class="activity">
          <h3>{activity.title}</h3>
          <p>{activity.description}</p>
          <a href={activity.source} target="_blank" rel="noopener noreferrer">{activity.sourceLabel}</a>
        </article>
      ))}
    </section>

    <section class="category">
      <h2>وابستگی حرفه‌ای</h2>
      {person.affiliations.map((affiliation) => <p><a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name}</a></p>)}
    </section>
  </div></section>
</BaseLayout>

<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:60px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead,p{color:#555;line-height:2}.category{max-width:820px;padding:50px 0;border-top:1px solid #ddd7d0}h2{font-size:1.8rem;font-weight:500}.activity{padding:28px 0;border-top:1px solid #eee9e3}.activity:first-of-type{border-top:0}.activity h3{font-size:1.25rem;font-weight:600}.activity p{margin-bottom:10px}.activity a,a{color:#806f61}
</style>
