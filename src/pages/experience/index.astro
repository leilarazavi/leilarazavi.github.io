---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { person } from "../../lib/person";
import { site } from "../../lib/site";
---
<BaseLayout title={`سوابق حرفه‌ای | ${site.nameFa}`} description="سوابق حرفه‌ای و فعالیت‌های سازمانی تأییدشده دکتر لیلا رضوی." canonical={`${site.url}/experience/`} lang="fa">
  <section class="page"><div class="container">
    <header><p class="label">سوابق حرفه‌ای</p><h1>سوابق و فعالیت‌های حرفه‌ای</h1><p class="lead">{person.description.fa}</p></header>
    <section><h2>شورای مرکزی مدرسه روان‌شناسی</h2><p>دکتر لیلا رضوی در فهرست اعضای شورای مرکزی مدرسه روان‌شناسی در استان قم معرفی شده است.</p><p class="source">منبع عمومی: معرفی اعضای شورای مرکزی توسط کانون روان‌شناسان و مشاوران استان قم.</p><a href="https://t.me/s/ahmadtorabie" target="_blank" rel="noopener noreferrer">مشاهده منبع عمومی</a></section>
    <section><h2>وابستگی حرفه‌ای</h2>{person.affiliations.map((affiliation) => <p><a href={affiliation.url} target="_blank" rel="noopener noreferrer">{affiliation.name}</a></p>)}</section>
  </div></section>
</BaseLayout>
<style>
.page{padding-block:90px}header{max-width:820px;padding-bottom:70px}.label{color:#806f61;font-size:.8rem;font-weight:600}h1{margin:0 0 24px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.25;font-weight:500}.lead,p{color:#555;line-height:2}section section{max-width:820px;padding:50px 0;border-top:1px solid #ddd7d0}h2{font-size:1.8rem;font-weight:500}.source{font-size:.9rem;color:#777}a{color:#806f61}
</style>