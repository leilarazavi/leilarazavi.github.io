---
import BaseLayout from "./BaseLayout.astro";

import {
  getScholarlyArticleSchema,
  getBreadcrumbSchema,
} from "../lib/schema";

import { site } from "../lib/site";

interface Props {
  title: string;

  description?: string;

  canonical: string;

  year: number;

  authors: string[];

  journal?: string;

  doi?: string;

  publisher?: string;

  language?: "fa" | "en";
}

const {
  title,
  description,

  canonical,

  year,

  authors,

  journal,

  doi,

  publisher,

  language = "en",
} = Astro.props;

const schema =
  getScholarlyArticleSchema({
    title,
    description,
    url: canonical,
    year,
    authors,
    journal,
    doi,
    publisher,
    language,
  });

const breadcrumbSchema =
  getBreadcrumbSchema([
    {
      name:
        language === "fa"
          ? "خانه"
          : "Home",

      url:
        `${site.url}/`,
    },

    {
      name:
        language === "fa"
          ? "آثار علمی"
          : "Publications",

      url:
        `${site.url}/publications/`,
    },

    {
      name: title,

      url: canonical,
    },
  ]);
---

<BaseLayout
  title={`${title} | ${site.name}`}
  description={description ?? title}
  canonical={canonical}
  lang={language}
  schemas={[schema]}
>

  <article class="publication-page">

    <div class="container">

      <header class="publication-header">

        <p class="publication-type">
          Scholarly Publication
        </p>

        <h1>
          {title}
        </h1>

        <div class="publication-info">

          <div>
            <strong>Authors</strong>

            <p>
              {authors.join(", ")}
            </p>
          </div>

          <div>
            <strong>Year</strong>

            <p>{year}</p>
          </div>

          {
            journal && (
              <div>
                <strong>Journal</strong>

                <p>{journal}</p>
              </div>
            )
          }

        </div>

      </header>


      <div class="publication-content">

        <div class="article-body">
          <slot />
        </div>

        <aside>

          {
            doi && (
              <a
                href={doi}
                target="_blank"
                rel="noopener noreferrer"
              >
                DOI
              </a>
            )
          }

        </aside>

      </div>

    </div>

  </article>

</BaseLayout>

<style>
  .publication-page {
    padding-block: 90px;
  }

  .publication-header {
    max-width: 900px;

    padding-bottom: 60px;

    border-bottom: 1px solid #ddd7d0;
  }

  .publication-type {
    margin: 0 0 18px;

    color: #806f61;

    font-size: 0.78rem;

    font-weight: 600;

    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0 0 40px;

    font-size:
      clamp(2rem, 5vw, 4rem);

    line-height: 1.3;

    letter-spacing: -0.04em;

    font-weight: 500;
  }

  .publication-info {
    display: grid;

    grid-template-columns:
      2fr
      1fr
      2fr;

    gap: 30px;
  }

  .publication-info strong {
    display: block;

    margin-bottom: 6px;

    color: #806f61;

    font-size: 0.75rem;
  }

  .publication-info p {
    margin: 0;

    color: #555;

    font-size: 0.9rem;
  }

  .publication-content {
    display: grid;

    grid-template-columns:
      minmax(0, 760px)
      220px;

    gap: 80px;

    padding-top: 60px;
  }

  .article-body {
    color: #444;

    font-size: 1rem;

    line-height: 2;
  }

  .article-body :global(h2) {
    margin-top: 50px;
  }

  aside {
    display: flex;

    flex-direction: column;

    gap: 10px;
  }

  aside a {
    padding: 12px 16px;

    border: 1px solid #ddd7d0;

    color: #806f61;

    text-decoration: none;

    font-size: 0.85rem;
  }

  @media (max-width: 800px) {
    .publication-info,
    .publication-content {
      grid-template-columns: 1fr;
    }

    .publication-content {
      gap: 40px;
    }
  }
</style>