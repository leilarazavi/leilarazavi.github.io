---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { site } from "../lib/site";

import "../styles/variables.css";
import "../styles/typography.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  lang?: "fa" | "en";
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  schemas?: Record<string, unknown>[];
}

const {
  title = site.title.fa,
  description = site.description.fa,
  canonical = site.url,
  lang = "fa",
  image,
  noindex = false,
  type = "website",
  schemas = [],
} = Astro.props;

const dir = lang === "fa" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang === "fa" ? "fa-IR" : "en"} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f7" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      lang={lang}
      image={image}
      noindex={noindex}
      type={type}
      schemas={schemas}
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      {lang === "fa" ? "رفتن به محتوای اصلی" : "Skip to main content"}
    </a>

    <Header lang={lang} />

    <main id="main-content">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  /*
   * Layout owns document-level structure; the shared CSS files own the visual
   * system. This removes duplicate global rules from the layout and gives the
   * upcoming component refactor one source of truth for spacing, typography,
   * accessibility and responsive behavior.
   *
   * SEO note: no metadata, schema, canonical, language or route behavior was
   * changed in this refactor. This commit is intentionally visual-only.
   */
</style>
