---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../lib/site";
import "../styles/variables.css";
import "../styles/typography.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  lang?: "fa" | "en";
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  schemas?: Record<string, unknown>[];
}

const {
  title = site.title.fa,
  description = site.description.fa,
  canonical = site.url,
  lang = "fa",
  image,
  noindex = false,
  type = "website",
  schemas = [],
} = Astro.props;

const dir = lang === "fa" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang === "fa" ? "fa-IR" : "en"} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#167c72" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa+Ink&family=Noto+Nastaliq+Urdu:wght@400;500&family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/profile/leila-razavi.webp" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      lang={lang}
      image={image}
      noindex={noindex}
      type={type}
      schemas={schemas}
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      {lang === "fa" ? "رفتن به محتوای اصلی" : "Skip to main content"}
    </a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
