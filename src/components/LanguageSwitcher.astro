---
interface Props { lang?: "fa" | "en"; href: string; }
const { lang = "fa", href } = Astro.props;
const isFa = lang === "fa";
---

<a class="language-switcher" href={href} lang={isFa ? "en" : "fa"} hreflang={isFa ? "en" : "fa"}>
  {isFa ? "EN" : "فارسی"}
</a>

<style>
  .language-switcher {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding-inline: 8px;
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .language-switcher:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  [dir="rtl"] .language-switcher { letter-spacing: 0; }
</style>
