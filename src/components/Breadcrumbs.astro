---
interface Item { label: string; href?: string; }
interface Props { items: Item[]; lang?: "fa" | "en"; }
const { items, lang = "fa" } = Astro.props;

/*
 * COMPONENT ARCHITECTURE DECISION
 *
 * Breadcrumb presentation is shared UI. The page supplies the semantic trail
 * because hierarchy differs by route. Keeping the component generic lets us
 * later add BreadcrumbList JSON-LD without duplicating visual markup.
 */
---

{items.length > 0 && (
  <nav class="breadcrumbs" aria-label={lang === "fa" ? "مسیر صفحه" : "Breadcrumb"}>
    <ol>
      {items.map((item, index) => (
        <li>
          {item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .breadcrumbs { margin-bottom: var(--space-5); color: var(--color-ink-subtle); }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: 0; padding: 0; list-style: none; font-size: var(--text-xs); }
  .breadcrumbs li:not(:last-child)::after { content: "/"; margin-inline-start: var(--space-2); color: var(--color-border-strong); }
  .breadcrumbs a { color: inherit; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--color-accent-strong); }
</style>