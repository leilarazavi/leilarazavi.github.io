---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props { lang?: "fa" | "en"; }
const { lang = "fa" } = Astro.props;
const isFa = lang === "fa";
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const languageHref = isFa ? (currentPath === "/" ? "/en/" : `/en${currentPath}`) : (currentPath === "/en/" ? "/" : currentPath.replace(/^\/en/, ""));

const navItems = isFa
  ? [
      { label: "درباره من", href: "/about/" },
      { label: "فعالیت حرفه‌ای", href: "/experience/" },
      { label: "پژوهش و آثار", href: "/publications/" },
      { label: "رسانه", href: "/media/" },
      { label: "ارتباط", href: "/contact/" },
    ]
  : [
      { label: "About", href: "/en/about/" },
      { label: "Professional", href: "/en/experience/" },
      { label: "Research & Publications", href: "/en/publications/" },
      { label: "Media", href: "/en/media/" },
      { label: "Contact", href: "/en/contact/" },
    ];

const isActive = (href: string) => currentPath === href || (href !== (isFa ? "/" : "/en/") && currentPath.startsWith(href));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={isFa ? "/" : "/en/"} aria-label={isFa ? "صفحه اصلی دکتر لیلا رضوی" : "Dr. Leila Razavi home page"}>
      <span class="brand-mark" aria-hidden="true">LR</span>
      <span class="brand-copy">
        <span class="brand-name">{isFa ? "دکتر لیلا رضوی" : "Dr. Leila Razavi"}</span>
        <span class="brand-description">{isFa ? "روان‌شناس · مدرس دانشگاه · پژوهشگر" : "Psychologist · Lecturer · Researcher"}</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={isFa ? "ناوبری اصلی" : "Main navigation"}>
      <div class="primary-links">
        {navItems.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
      </div>
      <div class="header-utility">
        <LanguageSwitcher lang={lang} href={languageHref} />
      </div>
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={isFa ? "باز کردن منو" : "Open menu"}>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav container" aria-label={isFa ? "ناوبری موبایل" : "Mobile navigation"} hidden>
    <div class="mobile-primary">
      {navItems.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
    </div>
    <div class="mobile-secondary">
      <span class="mobile-secondary-label">{isFa ? "منابع" : "Resources"}</span>
      <a href={isFa ? "/cv/" : "/en/cv/"}>{isFa ? "رزومه" : "CV"}</a>
      <a href={isFa ? "/organizations/" : "/en/organizations/"}>{isFa ? "سازمان‌ها و همکاری‌ها" : "Organizations & Collaborations"}</a>
      <LanguageSwitcher lang={lang} href={languageHref} />
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  button?.addEventListener("click", () => {
    if (!menu) return;
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    menu.hidden = isOpen;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    box-shadow: var(--shadow-header);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent-strong);
    font-family: Georgia, serif;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .brand-copy { display: flex; flex-direction: column; min-width: 0; line-height: 1.2; }
  .brand-name { font-family: var(--font-heading); font-size: var(--text-base); font-weight: 600; letter-spacing: -0.02em; }
  .brand-description { margin-top: 4px; color: var(--color-ink-muted); font-size: 0.66rem; white-space: nowrap; }

  .desktop-nav { display: flex; align-items: center; gap: 22px; }
  .primary-links { display: flex; align-items: center; gap: clamp(16px, 2.2vw, 30px); }
  .primary-links a { position: relative; color: var(--color-ink-muted); text-decoration: none; font-size: var(--text-sm); white-space: nowrap; transition: color var(--transition-fast); }
  .primary-links a::after { position: absolute; inset-inline: 0; bottom: -10px; height: 1px; background: var(--color-accent); content: ""; transform: scaleX(0); transform-origin: center; transition: transform var(--transition-fast); }
  .primary-links a:hover, .primary-links a.active { color: var(--color-accent-strong); }
  .primary-links a.active::after, .primary-links a:hover::after { transform: scaleX(1); }

  .header-utility { display: flex; align-items: center; padding-inline-start: 18px; border-inline-start: 1px solid var(--color-border); }

  .menu-button {
    display: none;
    width: 44px;
    height: 44px;
    padding: 9px;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .menu-button span { display: block; width: 100%; height: 1px; margin-block: 5px; background: currentColor; transition: transform var(--transition-fast); }
  .mobile-nav { display: none; padding-block: 18px 28px; }
  .mobile-primary, .mobile-secondary { display: flex; flex-direction: column; }
  .mobile-primary { gap: 0; }
  .mobile-primary a { padding-block: 14px; border-bottom: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; font-size: 1.05rem; }
  .mobile-primary a.active { color: var(--color-accent-strong); font-weight: 700; }
  .mobile-secondary { gap: 12px; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--color-border); }
  .mobile-secondary-label { color: var(--color-ink-subtle); font-size: var(--text-xs); font-weight: 700; }
  .mobile-secondary a { color: var(--color-ink-muted); text-decoration: none; font-size: var(--text-sm); }
  .mobile-nav:not([hidden]) { display: block; }

  @media (max-width: 1120px) {
    .primary-links { gap: 15px; }
    .desktop-nav { gap: 14px; }
    .brand-description { display: none; }
  }

  @media (max-width: 980px) {
    .desktop-nav { display: none; }
    .menu-button { display: block; }
  }

  @media (max-width: 640px) {
    .brand-mark { width: 36px; height: 36px; flex-basis: 36px; }
  }
</style>
