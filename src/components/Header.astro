---
interface Props { lang?: "fa" | "en"; }
const { lang = "fa" } = Astro.props;
const isFa = lang === "fa";
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const languageHref = isFa ? (currentPath === "/" ? "/en/" : `/en${currentPath}`) : (currentPath === "/en/" ? "/" : currentPath.replace(/^\/en/, ""));
const languageLabel = isFa ? "EN" : "فارسی";
const navItems = isFa
  ? [
      { label: "درباره من", href: "/about/" },
      { label: "آثار علمی", href: "/publications/" },
      { label: "سوابق", href: "/experience/" },
      { label: "رزومه", href: "/cv/" },
      { label: "رسانه", href: "/media/" },
      { label: "تماس", href: "/contact/" },
    ]
  : [
      { label: "About", href: "/en/about/" },
      { label: "Publications", href: "/en/publications/" },
      { label: "Experience", href: "/en/experience/" },
      { label: "CV", href: "/en/cv/" },
      { label: "Media", href: "/en/media/" },
      { label: "Contact", href: "/en/contact/" },
    ];
---
<header class="site-header">
  <div class="header-container">
    <a class="brand" href={isFa ? "/" : "/en/"} aria-label={isFa ? "صفحه اصلی دکتر لیلا رضوی" : "Dr. Leila Razavi home page"}>
      <span class="brand-name">{isFa ? "دکتر لیلا رضوی" : "Dr. Leila Razavi"}</span>
      <span class="brand-description">{isFa ? "روان‌شناس و پژوهشگر" : "Psychologist & Researcher"}</span>
    </a>
    <nav class="desktop-nav" aria-label={isFa ? "ناوبری اصلی" : "Main navigation"}>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="language-link" href={languageHref} lang={isFa ? "en" : "fa"}>{languageLabel}</a>
    </nav>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={isFa ? "باز کردن منو" : "Open menu"}><span></span><span></span><span></span></button>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label={isFa ? "ناوبری موبایل" : "Mobile navigation"} hidden>
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={languageHref} lang={isFa ? "en" : "fa"}>{languageLabel}</a>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  button?.addEventListener("click", () => { if (!menu) return; const isOpen = button.getAttribute("aria-expanded") === "true"; button.setAttribute("aria-expanded", String(!isOpen)); menu.hidden = isOpen; });
</script>
<style>
.site-header{position:relative;z-index:50;border-bottom:1px solid #e7e3de;background:rgba(250,249,247,.96);backdrop-filter:blur(12px)}.header-container{width:min(calc(100% - 40px),1180px);min-height:86px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;flex-direction:column;text-decoration:none;line-height:1.3;flex-shrink:0}.brand-name{font-size:1.05rem;font-weight:600;letter-spacing:-.02em}.brand-description{margin-top:4px;color:#777;font-size:.78rem}.desktop-nav{display:flex;align-items:center;gap:22px}.desktop-nav a,.mobile-nav a{color:#444;text-decoration:none;font-size:.88rem;transition:color .2s ease}.desktop-nav a:hover,.mobile-nav a:hover{color:#806f61}.language-link{padding-inline-start:18px;border-inline-start:1px solid #ddd7d0;font-weight:600}.menu-button{display:none;width:42px;height:42px;padding:8px;border:1px solid #ddd7d0;border-radius:50%;background:transparent;cursor:pointer}.menu-button span{display:block;width:100%;height:1px;margin-block:5px;background:#333}.mobile-nav{display:none;width:min(calc(100% - 40px),1180px);margin-inline:auto;padding-block:16px 24px;flex-direction:column;gap:18px}@media(max-width:980px){.desktop-nav{display:none}.menu-button{display:block}.mobile-nav:not([hidden]){display:flex}}
</style>