---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props { lang?: "fa" | "en"; }
const { lang = "fa" } = Astro.props;
const isFa = lang === "fa";
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const languageHref = isFa ? (currentPath === "/" ? "/en/" : `/en${currentPath}`) : (currentPath === "/en/" ? "/" : currentPath.replace(/^\/en/, ""));

const navItems = isFa
  ? [
      { label: "درباره من", href: "/about/" },
      { label: "فعالیت حرفه‌ای", href: "/experience/" },
      { label: "پژوهش و آثار", href: "/publications/" },
      { label: "رسانه", href: "/media/" },
      { label: "ارتباط", href: "/contact/" },
    ]
  : [
      { label: "About", href: "/en/about/" },
      { label: "Professional", href: "/en/experience/" },
      { label: "Research & Publications", href: "/en/publications/" },
      { label: "Media", href: "/en/media/" },
      { label: "Contact", href: "/en/contact/" },
    ];

const isActive = (href: string) => currentPath === href || (href !== (isFa ? "/" : "/en/") && currentPath.startsWith(href));
---
<header class="site-header">
  <div class="container header-container">
    <a class="brand" href={isFa ? "/" : "/en/"} aria-label={isFa ? "صفحه اصلی دکتر لیلا رضوی" : "Dr. Leila Razavi home page"}>
      {isFa && <span class="brand-script" aria-hidden="true">لیلا رضوی</span>}
      <span class="brand-name">{isFa ? "دکتر لیلا رضوی" : "Dr. Leila Razavi"}</span>
      <span class="brand-description">{isFa ? "روان‌شناس، مدرس دانشگاه و پژوهشگر" : "Psychologist, Lecturer & Researcher"}</span>
    </a>

    <nav class="desktop-nav" aria-label={isFa ? "ناوبری اصلی" : "Main navigation"}>
      {navItems.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
      <LanguageSwitcher lang={lang} href={languageHref} />
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={isFa ? "باز کردن منو" : "Open menu"}>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav container" aria-label={isFa ? "ناوبری موبایل" : "Mobile navigation"} hidden>
    <div class="mobile-primary">
      {navItems.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
    </div>
    <div class="mobile-secondary">
      <a href={isFa ? "/cv/" : "/en/cv/"}>{isFa ? "رزومه" : "CV"}</a>
      <a href={isFa ? "/organizations/" : "/en/organizations/"}>{isFa ? "سازمان‌ها و همکاری‌ها" : "Organizations & Collaborations"}</a>
      <LanguageSwitcher lang={lang} href={languageHref} />
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  button?.addEventListener("click", () => {
    if (!menu) return;
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    menu.hidden = isOpen;
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-container {
    min-height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand {
    position: relative;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    line-height: 1.25;
    text-decoration: none;
  }

  .brand-script {
    margin-block-end: -0.35rem;
    color: var(--color-accent);
    font-family: var(--font-calligraphy);
    font-size: 1.05rem;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-description {
    margin-top: var(--space-1);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .desktop-nav a {
    position: relative;
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -8px;
    left: 0;
    height: 1px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-fast);
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: var(--color-accent-strong);
  }

  .desktop-nav a.active::after,
  .desktop-nav a:hover::after {
    transform: scaleX(1);
  }

  .menu-button {
    display: none;
    width: 42px;
    height: 42px;
    padding: 9px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .menu-button span {
    display: block;
    width: 100%;
    height: 1px;
    margin-block: 5px;
    background: currentColor;
    transition: transform var(--transition-fast);
  }

  .mobile-nav {
    display: none;
    padding-block: var(--space-5) var(--space-6);
  }

  .mobile-primary,
  .mobile-secondary {
    display: flex;
    flex-direction: column;
  }

  .mobile-primary {
    gap: var(--space-4);
  }

  .mobile-secondary {
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .mobile-nav a {
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-base);
  }

  .mobile-nav .active {
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  .mobile-nav:not([hidden]) {
    display: block;
  }

  @media (max-width: 980px) {
    .desktop-nav { display: none; }
    .menu-button { display: block; }
  }

  @media (max-width: 640px) {
    .header-container { min-height: 76px; }
    .brand-description { font-size: 0.7rem; }
  }
</style>
