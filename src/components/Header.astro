---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props { lang?: "fa" | "en"; }
const { lang = "fa" } = Astro.props;
const isFa = lang === "fa";
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const languageHref = isFa ? (currentPath === "/" ? "/en/" : `/en${currentPath}`) : (currentPath === "/en/" ? "/" : currentPath.replace(/^\/en/, ""));

/*
 * INFORMATION ARCHITECTURE DECISION — Personal Brand v1
 *
 * Header navigation is intentionally limited to five user-facing concepts:
 * About, Professional Activity, Research & Publications, Media, Contact.
 * CV and Organizations remain crawlable/supporting destinations but are not
 * primary navigation items. This separates navigation UX from SEO architecture.
 *
 * COMPONENT ARCHITECTURE DECISION
 * Language presentation is delegated to LanguageSwitcher; route calculation
 * stays here because the Header knows the current URL context.
 */
const navItems = isFa
  ? [
      { label: "درباره من", href: "/about/" },
      { label: "فعالیت حرفه‌ای", href: "/experience/" },
      { label: "پژوهش و آثار", href: "/publications/" },
      { label: "رسانه", href: "/media/" },
      { label: "ارتباط", href: "/contact/" },
    ]
  : [
      { label: "About", href: "/en/about/" },
      { label: "Professional", href: "/en/experience/" },
      { label: "Research & Publications", href: "/en/publications/" },
      { label: "Media", href: "/en/media/" },
      { label: "Contact", href: "/en/contact/" },
    ];

const isActive = (href: string) => currentPath === href || (href !== (isFa ? "/" : "/en/") && currentPath.startsWith(href));
---
<header class="site-header">
  <div class="container header-container">
    <a class="brand" href={isFa ? "/" : "/en/"} aria-label={isFa ? "صفحه اصلی دکتر لیلا رضوی" : "Dr. Leila Razavi home page"}>
      <span class="brand-name">{isFa ? "دکتر لیلا رضوی" : "Dr. Leila Razavi"}</span>
      <span class="brand-description">{isFa ? "روان‌شناس، مدرس دانشگاه و پژوهشگر" : "Psychologist, Lecturer & Researcher"}</span>
    </a>

    <nav class="desktop-nav" aria-label={isFa ? "ناوبری اصلی" : "Main navigation"}>
      {navItems.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
      <LanguageSwitcher lang={lang} href={languageHref} />
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={isFa ? "باز کردن منو" : "Open menu"}>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav container" aria-label={isFa ? "ناوبری موبایل" : "Mobile navigation"} hidden>
    {navItems.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
    <LanguageSwitcher lang={lang} href={languageHref} />
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  button?.addEventListener("click", () => {
    if (!menu) return;
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    menu.hidden = isOpen;
  });
</script>

<style>
  .site-header { position: relative; z-index: 50; border-bottom: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-bg) 96%, transparent); backdrop-filter: blur(12px); }
  .header-container { min-height: 86px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); }
  .brand { display: flex; flex-direction: column; flex-shrink: 0; line-height: 1.3; text-decoration: none; }
  .brand-name { font-size: var(--text-lg); font-weight: 600; letter-spacing: -0.02em; }
  .brand-description { margin-top: var(--space-1); color: var(--color-ink-muted); font-size: var(--text-xs); }
  .desktop-nav { display: flex; align-items: center; gap: var(--space-5); }
  .desktop-nav a { color: var(--color-ink-muted); text-decoration: none; font-size: var(--text-sm); transition: color var(--transition-fast); }
  .desktop-nav a:hover, .desktop-nav a.active { color: var(--color-accent-strong); }
  .desktop-nav a.active { font-weight: 600; }
  .menu-button { display: none; width: 42px; height: 42px; padding: 8px; border: 1px solid var(--color-border-strong); border-radius: 50%; background: transparent; cursor: pointer; }
  .menu-button span { display: block; width: 100%; height: 1px; margin-block: 5px; background: var(--color-ink); }
  .mobile-nav { display: none; padding-block: var(--space-5) var(--space-6); flex-direction: column; gap: var(--space-4); }
  .mobile-nav a { color: var(--color-ink-muted); text-decoration: none; font-size: var(--text-sm); }
  .mobile-nav a.active { color: var(--color-accent-strong); font-weight: 600; }
  @media (max-width: 980px) { .desktop-nav { display: none; } .menu-button { display: block; } .mobile-nav:not([hidden]) { display: flex; } }
</style>
