---
interface Props {
  title: string;
  titleFa?: string;
  authors: string[];
  year?: number;
  journal?: string;
  url: string;
  language?: "fa" | "en";
}

const { title, titleFa, authors, year, journal, url, language = "fa" } = Astro.props;
const isFa = language === "fa";
---

<article class="publication-card">
  <div class="publication-meta" aria-label={isFa ? "اطلاعات اثر" : "Publication metadata"}>
    {year && <span>{year}</span>}
    {year && journal && <span aria-hidden="true">·</span>}
    {journal && <span>{journal}</span>}
  </div>

  <h3><a href={url}>{title}</a></h3>
  {isFa && titleFa && <p class="title-fa">{titleFa}</p>}
  <p class="authors">{authors.join(", ")}</p>
  <a class="read-more" href={url}>{isFa ? "جزئیات و منابع" : "Details & sources"} <span aria-hidden="true">{isFa ? "←" : "→"}</span></a>
</article>

<style>
  .publication-card {
    position: relative;
    padding: clamp(28px, 4vw, 40px) 0;
  }
  .publication-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: .01em;
  }
  h3 {
    max-width: 920px;
    margin: 0;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.65;
    font-weight: 600;
  }
  h3 a { color: var(--color-ink); text-decoration: none; }
  h3 a:hover { color: var(--color-accent-strong); }
  .title-fa {
    max-width: 850px;
    margin: 10px 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .authors {
    max-width: 900px;
    margin: 12px 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .read-more {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 18px;
    color: var(--color-accent-strong);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .read-more:hover { text-decoration: underline; text-underline-offset: 5px; }
</style>
