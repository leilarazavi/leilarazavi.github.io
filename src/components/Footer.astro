---
import { person } from "../lib/person";
import SocialLinks from "./SocialLinks.astro";

interface Props { lang?: "fa" | "en"; }
const { lang = "fa" } = Astro.props;
const isFa = lang === "fa";

const navigation = isFa
  ? [
      { label: "درباره من", href: "/about/" },
      { label: "آثار علمی", href: "/publications/" },
      { label: "سوابق", href: "/experience/" },
      { label: "رسانه", href: "/media/" },
      { label: "ارتباط", href: "/contact/" },
    ]
  : [
      { label: "About", href: "/en/about/" },
      { label: "Publications", href: "/en/publications/" },
      { label: "Experience", href: "/en/experience/" },
      { label: "Media", href: "/en/media/" },
      { label: "Contact", href: "/en/contact/" },
    ];

/*
 * COMPONENT ARCHITECTURE DECISION
 *
 * The footer owns composition only. Verified identity sources are rendered by
 * SocialLinks so the same presentation logic can be reused by Contact, About
 * and future media/profile sections. Navigation remains intentionally smaller
 * than the full SEO route graph; footer navigation is a usability layer, not
 * a replacement for crawlable internal links elsewhere in the site.
 */
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <div class="footer-name">{isFa ? person.fullNameFa : person.fullName}</div>
      <p>{isFa ? person.jobTitle.fa : person.jobTitle.en}</p>
    </div>

    <nav class="footer-nav" aria-label={isFa ? "پیوندهای سایت" : "Site navigation"}>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <SocialLinks lang={lang} />
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© {new Date().getFullYear()} {isFa ? person.fullNameFa : person.fullName}</span>
      <span>{isFa ? "تمامی حقوق محفوظ است." : "All rights reserved."}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }
  .footer-grid {
    padding-block: var(--space-8);
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-7);
  }
  .footer-name { font-size: var(--text-lg); font-weight: 600; }
  .footer-identity p { margin: var(--space-2) 0 0; color: var(--color-ink-muted); font-size: var(--text-sm); }
  .footer-nav { display: flex; flex-direction: column; gap: var(--space-3); }
  .footer-nav a { width: fit-content; color: var(--color-ink-muted); text-decoration: none; font-size: var(--text-sm); transition: color var(--transition-fast); }
  .footer-nav a:hover { color: var(--color-accent-strong); }
  .footer-bottom { border-top: 1px solid var(--color-border); padding-block: var(--space-4); color: var(--color-ink-subtle); font-size: var(--text-xs); }
  .footer-bottom-inner { display: flex; justify-content: space-between; gap: var(--space-4); }
  @media (max-width: 700px) { .footer-grid { grid-template-columns: 1fr; gap: var(--space-6); } .footer-bottom-inner { flex-direction: column; gap: var(--space-2); } }
</style>